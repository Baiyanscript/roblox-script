local function f5()
  if not flag or not humanoidRootPart or not v5 then
    return nil
  end

  if humanoid:GetState() == Enum.HumanoidStateType.Climbing then
    return nil
  end

  local v7 = humanoidRootPart.CFrame.LookVector * 2.5

  local raycastParams = RaycastParams.new()
  raycastParams.FilterDescendantsInstances = { v5 }
  raycastParams.FilterType = Enum.RaycastFilterType.Exclude

  local raycast = v4:Raycast(
    humanoidRootPart.Position + Vector3.new(0, -2.5, 0), v7, raycastParams
  )

  local raycast2 = v4:Raycast(
    humanoidRootPart.Position + Vector3.new(0, -0.5, 0), v7, raycastParams
  )

  if raycast and raycast2 and raycast.Instance ~= raycast2.Instance then
    if raycast.Instance.CanCollide == true and raycast2.Instance.CanCollide == true then
      if raycast.Normal.Y < 0.1 then
        return { Part1 = raycast.Instance, Part2 = raycast2.Instance }
      end
    end
  end

  return nil
end

local function makeAttachment()
  if not humanoid or not humanoidRootPart then
    return
  end

  connect = runService.Stepped:Connect(function()
    if not flag or not flag2 then
      return
    end

    local v8 = f5()
    local cframe, instance4, instance5

    if v8 then
      flag2 = false
      cframe = humanoidRootPart.CFrame
      humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

      if v8.Part1.Size.X > 1.5 or v8.Part1.Size.Z > 1.5 then
        instance4 = Instance.new("Attachment", humanoidRootPart)

        instance5 = Instance.new("LinearVelocity", humanoidRootPart)
        instance5.MaxForce = 35000
        instance5.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector

        instance5.VectorVelocity = Vector3.new(0, 52, 0)
          + humanoidRootPart.CFrame.LookVector * 12

        instance5.Attachment0 = instance4

        v2.delay(0.08, function()
          instance5:Destroy()
          instance4:Destroy()
        end)
      else
        humanoidRootPart.Velocity = Vector3.new(
          humanoidRootPart.Velocity.X, 35, humanoidRootPart.Velocity.Z
        ) + humanoidRootPart.CFrame.LookVector * 3
      end

      v2.spawn(function()
        humanoidRootPart.CFrame = cframe * CFrame.Angles(0, math.rad(-45), 0)
        v2.wait(0.05)
        humanoidRootPart.CFrame = cframe
      end)

      v2.delay(0.32, function() flag2 = true end)
    end
  end)
end

