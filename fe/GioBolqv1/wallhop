local function makeTextLabel(text, text2, p1)
  local v6 = p1 or 2
  local playerGui = players.LocalPlayer:WaitForChild("PlayerGui")

  local customNotificationGui = Instance.new("ScreenGui", playerGui)
  customNotificationGui.Name = "CustomNotificationGui"
  customNotificationGui.ResetOnSpawn = false

  local instance = Instance.new("Frame", customNotificationGui)
  instance.Size = UDim2.new(0, 250, 0, 50)
  instance.Position = UDim2.new(1.1, 0, 0.8, 0)
  instance.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
  instance.BackgroundTransparency = 0.2
  instance.BorderSizePixel = 0
  instance.AnchorPoint = Vector2.new(1, 0)
  instance.ClipsDescendants = true

  Instance.new("UICorner", instance).CornerRadius = UDim.new(0, 8)

  local instance2 = Instance.new("TextLabel", instance)
  instance2.Size = UDim2.new(1, -20, 0, 25)
  instance2.Position = UDim2.new(0, 10, 0, 5)
  instance2.Text = text
  instance2.TextColor3 = Color3.new(1, 1, 1)
  instance2.Font = Enum.Font.SourceSansBold
  instance2.TextSize = 18
  instance2.TextXAlignment = Enum.TextXAlignment.Left
  instance2.BackgroundTransparency = 1

  local instance3 = Instance.new("TextLabel", instance)
  instance3.Size = UDim2.new(1, -20, 0, 25)
  instance3.Position = UDim2.new(0, 10, 0, 30)
  instance3.Text = text2
  instance3.TextColor3 = Color3.fromRGB(200, 200, 200)
  instance3.Font = Enum.Font.SourceSans
  instance3.TextSize = 16
  instance3.TextWrapped = true
  instance3.TextXAlignment = Enum.TextXAlignment.Left
  instance3.TextYAlignment = Enum.TextYAlignment.Top
  instance3.BackgroundTransparency = 1

  table.insert(list, instance)

  for _, value2 in ipairs(list) do
    if value2 ~= instance then
      local scale = value2.Position.Y.Scale

      tweenService:Create(value2, TweenInfo.new(0.3), {
        Position = UDim2.new(0.98, 0, scale - 0.12, 0),
      }):Play()
    end
  end

  tweenService:Create(
    instance, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Position = UDim2.new(0.98, 0, 0.8, 0) }
  ):Play()

  v2.wait(v6)

  local create = tweenService:Create(instance, TweenInfo.new(
    0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In
  ), {
    Position = UDim2.new(1.1, 0, instance.Position.Y.Scale, 0),
  })

  create:Play()
  create.Completed:Wait()

  for index, value3 in ipairs(list) do
    if value3 == instance then
      table.remove(list, index)
      break
    end
  end

  customNotificationGui:Destroy()
end

