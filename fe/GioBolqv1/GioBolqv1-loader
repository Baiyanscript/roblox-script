local function f1(fn)
  local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

  local v1 = {}
  v1.Size = UDim2.new(0, 0, 0, 0)
  v1.Position = UDim2.new(0.5, 0, 0.5, 0)

  local tweenInfo2 = TweenInfo.new(0.2, Enum.EasingStyle.Linear)

  tweenService:Create(textLabel, tweenInfo2, { TextTransparency = 1 }):Play()
  tweenService:Create(closeButton, tweenInfo2, { TextTransparency = 1 }):Play()
  tweenService:Create(uiStroke, tweenInfo2, { Transparency = 1 }):Play()

  local create = tweenService:Create(mainFrame, tweenInfo, v1)
  create:Play()

  create.Completed:Connect(function()
    conquestSelector:Destroy()
    fn()
  end)
end

uiStroke3.Parent = textLabel

local function makeTextButton(name, udim, text)
  local textButton = Instance.new("TextButton")
  textButton.Name = name
  textButton.Size = UDim2.new(0, 138, 0, 34)
  textButton.Position = udim
  textButton.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
  textButton.BackgroundTransparency = 0.3
  textButton.TextColor3 = Color3.fromRGB(255, 255, 255)
  textButton.Font = Enum.Font.Merriweather
  textButton.TextSize = 14
  textButton.Text = text
  textButton.BorderSizePixel = 0
  textButton.ZIndex = 3
  textButton.Parent = mainFrame

  local uiCorner3 = Instance.new("UICorner")
  uiCorner3.CornerRadius = UDim.new(0, 8)
  uiCorner3.Parent = textButton

  local uiStroke4 = Instance.new("UIStroke")
  uiStroke4.Color = Color3.fromRGB(0, 0, 0)
  uiStroke4.Thickness = 1.5
  uiStroke4.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
  uiStroke4.Parent = textButton

  return textButton
end

local function f2(p1)
  p1.MouseEnter:Connect(function()
    tweenService:Create(p1, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
      BackgroundTransparency = 0.1,
    }):Play()
  end)

  p1.MouseLeave:Connect(function()
    tweenService:Create(p1, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
      BackgroundTransparency = 0.3,
    }):Play()
  end)
end

