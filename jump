-- =================================================================
-- ⚡ JUMP 核心跳躍邏輯
-- =================================================================

local function updateJumpUI()
	jumpInput.Text = "跳躍: " .. tostring(maxJumps)
end

-- 監聽空格鍵跳躍
local jumpConnection = UserInputService.JumpRequest:Connect(function()
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	
	if humanoid and root then
		-- 如果在地面上，重置空中跳躍計數
		if humanoid:GetState() == Enum.HumanoidStateType.Freefall or humanoid:GetState() == Enum.HumanoidStateType.Jumping then
			-- 空中跳躍邏輯
			if maxJumps == "無限" then
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			elseif type(maxJumps) == "number" then
				if jumpCount < maxJumps then
					jumpCount = jumpCount + 1
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		else
			-- 站在地面上時，重置計數（第一跳算落地後的初始狀態）
			jumpCount = 1 
		end
	end
end)

-- =================================================================
-- 互動事件與動態縮小排版綁定
-- =================================================================

-- 【文字輸入框】打字結束事件
jumpInput.FocusLost:Connect(function(enterPressed)
	local text = jumpInput.Text:lower()
	-- 移除前綴文字方便純文字判斷
	text = text:gsub("跳躍:", ""):gsub(" ", "")
	
	local num = tonumber(text)
	if text == "inf" or text == "無限" or text == "m" then
		maxJumps = "無限"
	elseif num then
		maxJumps = math.clamp(math.floor(num), 1, 100) -- 最少跳 1 下，最多 100 下
	else
		maxJumps = "無限" -- 亂打字一律防呆變無限
	end
	updateJumpUI()
end)

-- 「+」按鈕點擊
incJump.MouseButton1Click:Connect(function()
	if maxJumps == "無限" then
		maxJumps = 1
	else
		maxJumps = math.min(100, maxJumps + 1)
	end
	updateJumpUI()
end)

-- 「-」按鈕點擊
decJump.MouseButton1Click:Connect(function()
	if maxJumps ~= "無限" then
		if maxJumps <= 1 then
			maxJumps = "無限"
		else
			maxJumps = maxJumps - 1
		end
	end
	updateJumpUI()
end)

-- 關閉 UI 按鈕
closebutton.MouseButton1Click:Connect(function()
	if jumpConnection then jumpConnection:Disconnect() end
	main:Destroy()
end)

-- 最小化點擊
mini.MouseButton1Click:Connect(function()
	decJump.Visible = false
	jumpInput.Visible = false
	incJump.Visible = false
	mini.Visible = false
	mini2.Visible = true
	
	Frame.BackgroundTransparency = 1
	Frame.BorderSizePixel = 0
	
	TextLabel.Position = UDim2.new(1, -164, 0, -24) 
	TextLabel.Size = UDim2.new(0, 96, 0, 22)         
end)

-- 最大化還原點擊
mini2.MouseButton1Click:Connect(function()
	decJump.Visible = true
	jumpInput.Visible = true
	incJump.Visible = true
	mini.Visible = true
	mini2.Visible = false
	
	Frame.BackgroundTransparency = 0
	Frame.BorderSizePixel = 1
	
	TextLabel.Position = UDim2.new(0, 0, 0, 0)
	TextLabel.Size = UDim2.new(1, 0, 0, 26)
end)

