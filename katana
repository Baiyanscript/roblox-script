local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local localPlayer = Players.LocalPlayer
local backpack = localPlayer:WaitForChild("Backpack")
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local hitbox = Instance.new("Part", character)

hitbox.Name = "KHitbox"
hitbox.CanCollide = false
hitbox.Anchored = true
hitbox.Size = Vector3.new(8.8, 11.8, 9.2)
hitbox.Transparency = 1

task.spawn(function()
	while true do
		hitbox.Position = character.HumanoidRootPart.Position
		task.wait(0.01)
	end
end)

local katana = Instance.new("Tool")
katana.Name = "Katana"
katana.RequiresHandle = true
katana.CanBeDropped = false

local grip = Instance.new("Part")
grip.Name = "Handle"
grip.Size = Vector3.new(0.3, 1.2, 0.3)
grip.Material = Enum.Material.SmoothPlastic
grip.Color = Color3.fromRGB(30, 30, 30)
grip.CanCollide = false
grip.Massless = true
grip.TopSurface = Enum.SurfaceType.Smooth
grip.BottomSurface = Enum.SurfaceType.Smooth
grip.Parent = katana

local guard = Instance.new("Part")
guard.Name = "Guard"
guard.Size = Vector3.new(0.7, 0.15, 0.7)
guard.Material = Enum.Material.Metal
guard.Color = Color3.fromRGB(70, 70, 70)
guard.CanCollide = false
guard.Massless = true
guard.CFrame = grip.CFrame * CFrame.new(0, grip.Size.Y / 2 + guard.Size.Y / 2, 0)
guard.Parent = katana
local gw = Instance.new("WeldConstraint", grip)
gw.Part0 = grip
gw.Part1 = guard

local blade = Instance.new("Part")
blade.Name = "Blade"
blade.Size = Vector3.new(0.1, 5.5, 0.2)
blade.Material = Enum.Material.Metal
blade.Color = Color3.fromRGB(180, 200, 210)
blade.Reflectance = 0.5
blade.CanCollide = false
blade.Massless = true
blade.CFrame = grip.CFrame * CFrame.new(0, grip.Size.Y / 2 + blade.Size.Y / 2, 0)
blade.Parent = katana
local bw = Instance.new("WeldConstraint", grip)
bw.Part0 = grip
bw.Part1 = blade

local function addEdgeWedge(offsetX, angleY)
	local edge = Instance.new("WedgePart")
	edge.Size = Vector3.new(0.035, blade.Size.Y, blade.Size.Z)
	edge.Material = Enum.Material.Metal
	edge.Color = Color3.fromRGB(220, 230, 240)
	edge.Reflectance = 0.6
	edge.CanCollide = false
	edge.Massless = true
	edge.CFrame = blade.CFrame * CFrame.new(offsetX, 0, 0) * CFrame.Angles(0, math.rad(angleY), 0)
	edge.Parent = katana
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = blade
	weld.Part1 = edge
	weld.Parent = blade
end

addEdgeWedge(-blade.Size.X / 2 - 0.0175, -20)
addEdgeWedge(blade.Size.X / 2 + 0.0175, 20)

local tip = Instance.new("WedgePart")
tip.Name = "Tip"
tip.Size = Vector3.new(blade.Size.X, 0.15, blade.Size.Z)
tip.Material = Enum.Material.Metal
tip.Color = Color3.fromRGB(210, 220, 230)
tip.Reflectance = 0.7
tip.CanCollide = false
tip.Massless = true
tip.CFrame = blade.CFrame * CFrame.new(0, blade.Size.Y / 2 + tip.Size.Y / 2 - 0.05, 0) * CFrame.Angles(math.rad(-15), 0, 0)
tip.Parent = katana
local tw = Instance.new("WeldConstraint", blade)
tw.Part0 = blade
tw.Part1 = tip

local swingSound = Instance.new("Sound")
swingSound.Name = "Swing"
swingSound.SoundId = "rbxassetid://6241709963"
swingSound.Volume = 1
swingSound.Parent = grip

local idleAnimation = Instance.new("Animation")
idleAnimation.AnimationId = "rbxassetid://48137861"

local attackAnimations = {
	"rbxassetid://46756384",
	"rbxassetid://54584713",
	"rbxassetid://32659699",
}

local explosionSoundId = "rbxassetid://7223765833"
local explosionAnimId = "rbxassetid://32659699"
local boneSoundId = "rbxassetid://9113543052"
local explosionBoneSoundId = "rbxassetid://130842702917817"

local boneSound = Instance.new("Sound", grip)
boneSound.Name = "Crush"
boneSound.SoundId = boneSoundId
boneSound.Volume = 0.8

local bsound = Instance.new("Sound")
bsound.SoundId = explosionBoneSoundId
bsound.Volume = 0.8
bsound.PlayOnRemove = true
bsound.Parent = grip

local cooldownTime = 5
local canUseExplosion = true

local idleTrack
local attacking = false
local comboIndex = 1

local function playAnim(animId)
	local anim = Instance.new("Animation")
	anim.AnimationId = animId
	local track = humanoid:LoadAnimation(anim)
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = false
	track:Play()
	return track
end

local function shake(intensity)
	local cam = workspace.CurrentCamera
	if not cam then return end

	local originalCFrame = cam.CFrame
	local originalCameraType = cam.CameraType

	cam.CameraType = Enum.CameraType.Scriptable

	local shakes = 6
	local magnitude = intensity

	for i = 1, shakes do
		local offset = Vector3.new(
			math.random(-100, 100) / 1000,
			math.random(-100, 100) / 1000,
			math.random(-100, 100) / 1000
		) * magnitude

		cam.CFrame = originalCFrame * CFrame.new(offset)
		task.wait(0.01)
	end

	cam.CFrame = originalCFrame
	cam.CameraType = originalCameraType
end

local function bleed(position)
	local dir = Vector3.new(
		math.random(-100, 100) / 100,
		math.random(-100, 100) / 100,
		math.random(-100, 100) / 100
	).Unit

	local part = Instance.new("Part")
	part.Size = Vector3.new(1, 1, 1)
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.CFrame = CFrame.new(position, position + dir)
	part.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxassetid://12532663797"
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.3, 0.5)
	emitter.Speed = NumberRange.new(10, 10)
	emitter.VelocitySpread = 0
	emitter.Color = ColorSequence.new(Color3.new(0.6, 0, 0))
	emitter.EmissionDirection = Enum.NormalId.Front
	emitter.Acceleration = Vector3.new(0, -20, 0)
	emitter.Parent = part

	emitter:Emit(1)
	Debris:AddItem(part, 2)
end

local function Combo()
	if attacking then return end
	attacking = true
	if idleTrack then idleTrack:Stop() end

	local track = playAnim(attackAnimations[comboIndex])

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}
	local parts = workspace:GetPartBoundsInBox(hitbox.CFrame, hitbox.Size, params)

	swingSound:Play()
	shake(6)

	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and model ~= character and model:FindFirstChild("Humanoid") then
			local hum = model.Humanoid

			if not hum:FindFirstChild("DeathSoundPlayed") then
				local marker = Instance.new("BoolValue")
				marker.Name = "DeathSoundPlayed"
				marker.Parent = hum

				hum.Died:Connect(function()
					bsound:Play()
				end)
			end

			hum:TakeDamage(comboIndex == 3 and 3 or 1)
			bleed(model:FindFirstChild("HumanoidRootPart") and model.HumanoidRootPart.Position or part.Position)

			if hum.Health > 0 then
				boneSound:Play()
			end
		end
	end

	if comboIndex == 3 and humanoid.RootPart then
		local upForce = Instance.new("BodyVelocity")
		upForce.Velocity = Vector3.new(0, 25, 0)
		upForce.MaxForce = Vector3.new(0, math.huge, 0)
		upForce.P = 3000
		upForce.Parent = humanoid.RootPart
		Debris:AddItem(upForce, 0.3)
	end

	track.Stopped:Wait()
	comboIndex += 1
	if comboIndex > #attackAnimations then
		task.wait(0.5)
		comboIndex = 1
	end

	attacking = false
	if idleTrack then idleTrack:Play() end
end

local function createExplosionVFX(position)
	local explosionPart = Instance.new("Part")
	explosionPart.Size = Vector3.new(1, 1, 1)
	explosionPart.Anchored = true
	explosionPart.CanCollide = false
	explosionPart.Transparency = 1
	explosionPart.Position = position
	explosionPart.Parent = workspace

	local sound = Instance.new("Sound")
	sound.SoundId = explosionSoundId
	sound.Volume = 0.8
	sound.PlayOnRemove = true
	sound.Parent = explosionPart
	sound:Destroy()

	local sphere = Instance.new("Part")
	sphere.Shape = Enum.PartType.Ball
	sphere.Size = Vector3.new(1, 1, 1)
	sphere.Material = Enum.Material.Neon
	sphere.BrickColor = BrickColor.new("Bright orange")
	sphere.Anchored = true
	sphere.CanCollide = false
	sphere.Position = position
	sphere.Parent = workspace

	local tween = TweenService:Create(sphere, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(10, 10, 10),
		Transparency = 1
	})
	tween:Play()

	for i = 1, 15 do
		local spark = Instance.new("Part")
		spark.Shape = Enum.PartType.Ball
		spark.Size = Vector3.new(0.2, 0.2, 0.2)
		spark.Material = Enum.Material.Neon
		spark.BrickColor = BrickColor.new("Bright yellow")
		spark.Anchored = false
		spark.CanCollide = false
		spark.Position = position
		spark.Parent = workspace

		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Velocity = Vector3.new(math.random(-20, 20), math.random(10, 30), math.random(-20, 20))
		bodyVelocity.P = 1000
		bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
		bodyVelocity.Parent = spark

		Debris:AddItem(spark, 1)
		Debris:AddItem(bodyVelocity, 1)
	end

	tween.Completed:Connect(function()
		sphere:Destroy()
		explosionPart:Destroy()
	end)

	-- Explosion damage logic (big damage shit fr)
	local radius = 10
	local damage = 50
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}
	local affectedParts = workspace:GetPartBoundsInRadius(position, radius, params)

	for _, part in ipairs(affectedParts) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and model ~= character and model:FindFirstChild("Humanoid") then
			model.Humanoid:TakeDamage(damage)
		end
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.E and katana:IsDescendantOf(character) then
		if not canUseExplosion then return end
		canUseExplosion = false

		local anim = Instance.new("Animation")
		anim.AnimationId = explosionAnimId
		local track = humanoid:LoadAnimation(anim)
		track:Play()

		task.wait(0.5)

		local explosionPos = character.HumanoidRootPart.Position + character.HumanoidRootPart.CFrame.LookVector * 5
		createExplosionVFX(explosionPos)

		task.delay(cooldownTime, function()
			canUseExplosion = true
		end)
	end
end)

katana.Equipped:Connect(function()
	idleTrack = humanoid:LoadAnimation(idleAnimation)
	idleTrack.Priority = Enum.AnimationPriority.Idle
	idleTrack.Looped = true
	idleTrack:Play()
end)

katana.Unequipped:Connect(function()
	if idleTrack then idleTrack:Stop() end
	attacking = false
	comboIndex = 1
end)

katana.Activated:Connect(function()
	if not attacking then
		Combo()
	end
end)

katana.Parent = backpack
