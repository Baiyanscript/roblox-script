-- 解析數值輔助函數
local function parseValue(text)
	local numStr, unit = text:match("^%s*(.-)%s*$"):match("%$([%d%.]+)%s*([kKmMbB]?)")
	local val = tonumber(numStr) or 0
	if unit then
		local lower = unit:lower()
		if lower == "k" then val = val * 1e3
		elseif lower == "m" then val = val * 1e6
		elseif lower == "b" then val = val * 1e9 end
	end
	return val
end

-- 建立指向目標的 Beam 光束
local function updateBeam(targetPart)
	local character = LocalPlayer.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") or not targetPart then return end
	
	if currentBeam then
		currentBeam:Destroy()
		if startAttach then startAttach:Destroy() end
		if endAttach then endAttach:Destroy() end
	end
	
	startAttach = Instance.new("Attachment")
	startAttach.Parent = character.HumanoidRootPart
	
	endAttach = Instance.new("Attachment")
	endAttach.Parent = targetPart
	
	currentBeam = Instance.new("Beam")
	currentBeam.Attachment0 = startAttach
	currentBeam.Attachment1 = endAttach
	currentBeam.Width0 = 0.35
	currentBeam.Width1 = 0.35
	currentBeam.FaceCamera = true
	currentBeam.LightInfluence = 0
	currentBeam.Parent = espLinesFolder
	
	task.spawn(function()
		while currentBeam and currentBeam.Parent do
			local t = tick()
			currentBeam.Color = ColorSequence.new(Color3.fromHSV(t % 5 / 5, 1, 1))
			task.wait(0.05)
		end
	end)
end

-- 更新基地 Base ESP (Lock Time)
local function refreshBaseESP()
	for _, gui in pairs(baseESPInstances) do
		if gui then gui:Destroy() end
	end
	baseESPInstances = {}
	
	if not isBaseESPEnabled then return end
	
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then return end
	
	for _, plot in ipairs(plots:GetChildren()) do
		local purchases = plot:FindFirstChild("Purchases", true)
		local lockTimeText = "No Lock"
		
		if purchases then
			local plotBlock = purchases:FindFirstChild("PlotBlock", true)
			if plotBlock and plotBlock:FindFirstChild("Main", true) then
				local bb = plotBlock.Main:FindFirstChild("BillboardGui", true)
				if bb then
					local rem = bb:FindFirstChild("RemainingTime", true)
					if rem and rem:IsA("TextLabel") then
						lockTimeText = (rem.Text == "0s") and "UNLOCKED" or ("Lock: " .. rem.Text)
					end
				end
			end
		end
		
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "BaseESPLockTime_" .. plot.Name
		billboard.Size = UDim2.new(0, 250, 0, 60)
		billboard.StudsOffset = Vector3.new(0, 8, 0)
		billboard.AlwaysOnTop = true
		billboard.Adornee = plot:FindFirstChild("PlotBlock") or plot
		
		local bgFrame = Instance.new("Frame")
		bgFrame.Size = UDim2.new(1, 0, 1, 0)
		bgFrame.BackgroundTransparency = 1
		bgFrame.Parent = billboard
		
		local corner = Instance.new("UICorner", bgFrame)
		corner.CornerRadius = UDim.new(0, 6)
		
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0.5, 0)
		label.Position = UDim2.new(0, 0, 0.5, 0)
		label.BackgroundTransparency = 1
		label.Text = lockTimeText
		label.TextScaled = true
		
		if lockTimeText == "UNLOCKED" then
			label.TextColor3 = Color3.fromRGB(0, 255, 0)
		elseif lockTimeText:find("Lock:") then
			label.TextColor3 = Color3.fromRGB(255, 255, 0)
		else
			label.TextColor3 = Color3.fromRGB(255, 165, 0)
		end
		
		label.TextStrokeColor3 = Color3.new(0, 0, 0)
		label.TextStrokeTransparency = 0
		label.Font = Enum.Font.SourceSansBold
		label.Parent = bgFrame
		
		billboard.Parent = plot
		baseESPInstances[plot.Name] = billboard
	end
end

-- 尋找最佳動物/物件
local bestTargetData = nil
local function findBestAnimal()
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then return nil end
	
	local bestVal = -1
	local bestInfo = nil
	
	for _, plot in ipairs(plots:GetChildren()) do
		local podiums = plot:FindFirstChild("AnimalPodiums")
		if podiums then
			for _, podium in ipairs(podiums:GetChildren()) do
				local base = podium:FindFirstChild("Base")
				local spawn = base and base:FindFirstChild("Spawn")
				if spawn then
					local att = spawn:FindFirstChild("Attachment")
					local overhead = att and att:FindFirstChild("AnimalOverhead")
					if overhead then
						local nameNode = overhead:FindFirstChild("DisplayName")
						local genNode = overhead:FindFirstChild("Generation")
						local mutNode = overhead:FindFirstChild("Mutation")
						
						if genNode then
							local nameText = nameNode and nameNode.Text or "Unknown"
							local genText = genNode.Text
							local mutText = mutNode and mutNode.Text or ""
							
							local val = parseValue(genText)
							if val == 0 then
								val = tonumber(genText:match("%d+")) or 0
							end
							
							if val > bestVal then
								bestVal = val
								bestInfo = {
									name = nameText,
									info = genText,
									mutation = mutText,
									part = spawn,
									value = val,
								}
							end
						end
					end
				end
			end
		end
	end
	return bestInfo
end

local function updateBestESP()
	if not isBestESPEnabled then return end
	local target = findBestAnimal()
	if target then
		local shouldUpdate = false
		if not currentBillboard then
			shouldUpdate = true
		elseif bestTargetData then
			if target.value > bestTargetData.value or target.mutation ~= bestTargetData.mutation then
				shouldUpdate = true
			end
		end
		
		if shouldUpdate then
			bestTargetData = target
			createBestESP(target.name, target.info, target.part)
			updateBeam(target.part)
		end
	else
		if currentBillboard then
			currentBillboard:Destroy()
			currentBillboard = nil
			bestTargetData = nil
		end
		if currentBeam then
			currentBeam:Destroy()
			currentBeam = nil
		end
	end
end

