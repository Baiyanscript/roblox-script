FovButton.TextColor3 = Color3.new(1, 1, 1)
FovButton.Parent = Frame

-- State variables
local espEnabled = false
local aimbotEnabled = false
local fovEnabled = false
local fovRadius = 90

-- Drawing objects (created once)
local fovCircle = Drawing.new("Circle")
fovCircle.Color = Color3.fromRGB(255, 255, 255)
fovCircle.Thickness = 1
fovCircle.NumSides = 64
fovCircle.Radius = fovRadius
fovCircle.Filled = false
fovCircle.Visible = false
fovCircle.ZIndex = 5

-- Table to store ESP drawings per player
local espDrawings = {}

-- Cleanup function to remove ESP drawings
local function clearESP()
    for _, drawings in pairs(espDrawings) do
        if drawings.box then drawings.box:Remove() end
        if drawings.line then drawings.line:Remove() end
    end
    espDrawings = {}
end

-- Update ESP for all players
local function updateESP()
    if not espEnabled then
        clearESP()
        return
    end

    local players = Players:GetPlayers()
    for _, player in ipairs(players) do
        if player == LocalPlayer then continue end
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Head") then
            -- Remove drawings if player left or died
            if espDrawings[player] then
                if espDrawings[player].box then espDrawings[player].box:Remove() end
                if espDrawings[player].line then espDrawings[player].line:Remove() end
                espDrawings[player] = nil
            end
            continue
        end

        -- Create drawings if not already existing
        if not espDrawings[player] then
            local box = Drawing.new("Square")
            box.Color = Color3.fromRGB(255, 255, 255)
            box.Thickness = 1
            box.Filled = false
            box.Visible = true
            box.ZIndex = 5

            local line = Drawing.new("Line")
            line.Color = Color3.fromRGB(255, 0, 0)
            line.Thickness = 1
            line.Visible = true
            line.ZIndex = 5

            espDrawings[player] = { box = box, line = line }
        end

        local hrp = character.HumanoidRootPart
        local head = character.Head
        local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local headPos = Camera:WorldToViewportPoint(head.Position)

        if onScreen and headPos.Z > 0 then
            -- 2D box ESP (height based on head to foot)
            local footPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
            local height = math.abs(headPos.Y - footPos.Y)
            local width = height * 0.5
            local boxPos = Vector2.new(headPos.X - width/2, headPos.Y - height)

            espDrawings[player].box.Position = boxPos
            espDrawings[player].box.Size = Vector2.new(width, height)
            espDrawings[player].box.Visible = true

            -- Line from bottom of box to center of screen
            local screenCenter = Camera.ViewportSize / 2
            espDrawings[player].line.From = Vector2.new(headPos.X, footPos.Y)
            espDrawings[player].line.To = screenCenter
            espDrawings[player].line.Visible = true
        else
            espDrawings[player].box.Visible = false
            espDrawings[player].line.Visible = false
        end
    end
end

-- FOV circle position (follows mouse)
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and fovEnabled then
        fovCircle.Position = Vector2.new(input.Position.X, input.Position.Y)
    end
end)

-- Toggle ESP
EspButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    EspButton.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    if not espEnabled then clearESP() end
end)

-- Toggle Aimbot (placeholder – add your aimbot logic here)
AimbotButton.MouseButton1Click:Connect(function()
    aimbotEnabled = not aimbotEnabled
    AimbotButton.Text = aimbotEnabled and "Aimbot: ON" or "Aimbot: OFF"
    if aimbotEnabled then
        warn("Aimbot not implemented – add your own targeting logic.")
    end
end)

-- Toggle FOV circle
FovButton.MouseButton1Click:Connect(function()
    fovEnabled = not fovEnabled
    fovCircle.Visible = fovEnabled
    FovButton.Text = fovEnabled and "FOV: ON" or "FOV: OFF"
    if fovEnabled then
        -- Set initial position to mouse location
        local mousePos = UserInputService:GetMouseLocation()
        fovCircle.Position = mousePos
    end
end)

-- Render loop: update ESP
RunService.RenderStepped:Connect(function()
    updateESP()
end)

-- Cleanup when GUI is destroyed
ScreenGui.AncestryChanged:Connect(function()
    if not ScreenGui.Parent then
        clearESP()
        fovCircle:Remove()
    end
end)
