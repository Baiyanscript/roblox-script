-- 2. CRATER & DEBRIS EFFECT
----------------------------------------------------
local function CreateImpactShockwave(pos)
	local wave = Instance.new("Part")
	wave.Shape = Enum.PartType.Cylinder
	wave.Size = Vector3.new(0.2, 2, 2)
	wave.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	wave.Material = Enum.Material.Neon
	wave.Color = Color3.fromRGB(0, 200, 255)
	wave.Anchored = true
	wave.CanCollide = false
	wave.Parent = Workspace

	TweenService:Create(wave, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, 35, 35),
		Transparency = 1
	}):Play()

	Debris:AddItem(wave, 0.6)
end

local function BreakFloor(impactPos)
	SFX.Impact:Play()
	CreateImpactShockwave(impactPos)

	task.spawn(function()
		for i = 1, 12 do
			local offset = Vector3.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1)) * 0.4
			camera.CFrame = camera.CFrame * CFrame.new(offset)
			RunService.RenderStepped:Wait()
		end
	end)

	local debrisCount = 28
	local radius = 12

	for i = 1, debrisCount do
		local angle = (i / debrisCount) * math.pi * 2
		local distance = math.random(3, radius)
		local offset = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)

		local chunk = Instance.new("Part")
		chunk.Size = Vector3.new(math.random(2, 5), math.random(1, 2), math.random(2, 5))
		chunk.CFrame = CFrame.new(impactPos + offset) * CFrame.Angles(
			math.rad(math.random(-50, 50)),
			math.rad(math.random(0, 360)),
			math.rad(math.random(-50, 50))
		)
		chunk.Material = Enum.Material.Concrete
		chunk.Color = Color3.fromRGB(75, 75, 80)
		chunk.CanCollide = true

		local attachment = Instance.new("Attachment", chunk)
		
		local linVel = Instance.new("LinearVelocity")
		linVel.MaxForce = 1e5
		linVel.VectorVelocity = Vector3.new(
			math.cos(angle) * math.random(30, 60),
			math.random(30, 65),
			math.sin(angle) * math.random(30, 60)
		)
		linVel.Attachment0 = attachment
		linVel.Parent = chunk

		local angVel = Instance.new("AngularVelocity")
		angVel.MaxTorque = 1e4
		angVel.AngularVelocity = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
		angVel.Attachment0 = attachment
		angVel.Parent = chunk

		Debris:AddItem(linVel, 0.15)
		Debris:AddItem(angVel, 0.3)
		Debris:AddItem(chunk, 5)
		chunk.Parent = Workspace
	end
end

