local function createSound(id, volume, pitch, looped)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(id)
	sound.Volume = volume or 1
	sound.PlaybackSpeed = pitch or 1
	sound.Looped = looped or false
	sound.Parent = SoundService
	return sound
end

local SFX = {
	Impact = createSound(138093284, 2.5, 0.85),
	HoloOpen = createSound(262562442, 1.5, 1.1),
	Target = createSound(130836272, 1.0, 1.0),
	AttackCast = createSound(281444251, 1.5, 1.2),
	Walk = createSound(142490292, 0.8, 1.1, true),
	ClickSFX = createSound(131100371, 3.5, 1.2) -- Loud click sound for targeting
}

