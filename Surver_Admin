-- 3. TRIPLE HOLOGRAPHIC SCREENS (67% TRANSPARENT)
----------------------------------------------------
local holoScreens = {}
local screenOffsets = {
	Vector3.new(-3.2, 1.2, -2.5),
	Vector3.new(0, 1.5, -3.2),
	Vector3.new(3.2, 1.2, -2.5)
}

local screenRotations = {
	CFrame.Angles(0, math.rad(25), 0),
	CFrame.Angles(0, 0, 0),
	CFrame.Angles(0, math.rad(-25), 0)
}

local isHoloActive = false

local function CreateHoloScreens()
	for i = 1, 3 do
		local screen = Instance.new("Part")
		screen.Name = "HoloScreen_" .. i
		screen.Size = Vector3.new(3.2, 2.2, 0.05)
		screen.Material = Enum.Material.Neon
		screen.Color = Color3.fromRGB(0, 220, 255)
		screen.Transparency = 1
		screen.CanCollide = false
		screen.Anchored = true
		screen.Parent = character

		local gui = Instance.new("SurfaceGui", screen)
		gui.Face = Enum.NormalId.Front
		gui.Enabled = false

		local frame = Instance.new("Frame", gui)
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.BackgroundColor3 = Color3.fromRGB(0, 40, 80)
		frame.BackgroundTransparency = 0.5

		-- Header Text Label
		local header = Instance.new("TextLabel", frame)
		header.Size = UDim2.new(1, 0, 0.25, 0)
		header.Position = UDim2.new(0, 0, 0, 0)
		header.BackgroundTransparency = 0.8
		header.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
		header.TextColor3 = Color3.fromRGB(255, 220, 100)
		header.TextScaled = true
		header.Font = Enum.Font.GothamBold

		-- Main Text Label
		local label = Instance.new("TextLabel", frame)
		label.Size = UDim2.new(1, -20, 0.7, -10)
		label.Position = UDim2.new(0, 10, 0.28, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(200, 255, 255)
		label.TextScaled = true
		label.Font = Enum.Font.Code

		-- Customizing individual screen texts
		if i == 1 then
			-- LEFT SCREEN
			header.Text = "LEFT PANEL"
			label.Text = "SYSTEMS ONLINE\nTARGET: LOCK\nPOWER: 100%"
		elseif i == 2 then
			-- CENTER SCREEN
			header.Text = "Local Script R15 made by SMzees"
			label.Text = "FE ADMIN SCRIPT\nSTATUS: ACTIVE"
		elseif i == 3 then
			-- RIGHT SCREEN
			header.Text = "RIGHT PANEL"
			label.Text = "COMMAND PANEL\nREADY...\nENCRYPTION: SECURE"
		end

		table.insert(holoScreens, {Part = screen, Gui = gui, Offset = screenOffsets[i], Rotation = screenRotations[i]})
	end
end

CreateHoloScreens()

RunService.RenderStepped:Connect(function()
	if isHoloActive and rootPart and rootPart.Parent then
		local t = tick()
		for _, data in ipairs(holoScreens) do
			local hover = math.sin(t * 3.5 + data.Offset.X) * 0.12
			local targetCFrame = rootPart.CFrame * CFrame.new(data.Offset + Vector3.new(0, hover, 0)) * data.Rotation
			data.Part.CFrame = targetCFrame
		end
	end
end)

----------------------------------------------------
-- 4. SEQUENCE INITIALIZATION
----------------------------------------------------
local function PlaySequence()
	SFX.HoloOpen:Play()
	isHoloActive = true

	for _, data in ipairs(holoScreens) do
		data.Gui.Enabled = true
		TweenService:Create(data.Part, TweenInfo.new(0.35), {Transparency = 0.67}):Play()
	end
end

