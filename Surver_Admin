local attackAnim = Instance.new("Animation")
attackAnim.AnimationId = "rbxassetid://109592705993278"
local attackTrack = animator:LoadAnimation(attackAnim)
attackTrack.Priority = Enum.AnimationPriority.Action

local function EruptGrassAt(targetChar)
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	local targetHum = targetChar:FindFirstChild("Humanoid")
	if not targetRoot or not targetHum then return end

	attackTrack:Play()

	SFX.AttackCast:Play()
	SFX.Target:Play()
	SFX.Impact:Play()

	local originPos = targetRoot.Position - Vector3.new(0, 3, 0)

	targetRoot.AssemblyLinearVelocity = Vector3.new(
		math.random(-25, 25),
		math.random(120, 180),
		math.random(-25, 25)
	)

	local chunkCount = 30
	for i = 1, chunkCount do
		local angle = (i / chunkCount) * math.pi * 2
		local speed = math.random(20, 60)

		local chunk = Instance.new("Part")
		chunk.Size = Vector3.new(math.random(1, 3), math.random(1, 2), math.random(1, 3))
		chunk.CFrame = CFrame.new(originPos) * CFrame.Angles(
			math.rad(math.random(0, 360)),
			math.rad(math.random(0, 360)),
			math.rad(math.random(0, 360))
		)
		
		if i % 2 == 0 then
			chunk.Material = Enum.Material.Grass
			chunk.Color = Color3.fromRGB(75, 150, 45)
		else
			chunk.Material = Enum.Material.Ground
			chunk.Color = Color3.fromRGB(110, 75, 45)
		end
		chunk.CanCollide = true

		local attachment = Instance.new("Attachment", chunk)

		local linVel = Instance.new("LinearVelocity")
		linVel.MaxForce = 1e5
		linVel.VectorVelocity = Vector3.new(
			math.cos(angle) * speed,
			math.random(50, 110),
			math.sin(angle) * speed
		)
		linVel.Attachment0 = attachment
		linVel.Parent = chunk

		local angVel = Instance.new("AngularVelocity")
		angVel.MaxTorque = 1e4
		angVel.AngularVelocity = Vector3.new(math.random(-15, 15), math.random(-15, 15), math.random(-15, 15))
		angVel.Attachment0 = attachment
		angVel.Parent = chunk

		Debris:AddItem(linVel, 0.15)
		Debris:AddItem(angVel, 0.3)
		Debris:AddItem(chunk, 4)
		chunk.Parent = Workspace
	end

	local wave = Instance.new("Part")
	wave.Shape = Enum.PartType.Cylinder
	wave.Size = Vector3.new(0.2, 1, 1)
	wave.CFrame = CFrame.new(originPos) * CFrame.Angles(0, 0, math.rad(90))
	wave.Material = Enum.Material.Neon
	wave.Color = Color3.fromRGB(50, 220, 80)
	wave.Anchored = true
	wave.CanCollide = false
	wave.Parent = Workspace

	TweenService:Create(wave, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.1, 20, 20),
		Transparency = 1
	}):Play()

	Debris:AddItem(wave, 0.5)
end

mouse.Button1Down:Connect(function()
	local target = mouse.Target
	if target and target.Parent then
		local targetChar = target.Parent:FindFirstChild("Humanoid") and target.Parent 
			or (target.Parent.Parent and target.Parent.Parent:FindFirstChild("Humanoid") and target.Parent.Parent)

		if targetChar and targetChar ~= character then
			SFX.ClickSFX:Play() -- Loud click sound trigger on player click
			EruptGrassAt(targetChar)
		end
	end
end)

