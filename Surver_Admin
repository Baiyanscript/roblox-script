-- 6. WALKING SOUND CONTROLLER
----------------------------------------------------
humanoid.Running:Connect(function(speedVal)
	if speedVal > 0.1 and humanoid:GetState() == Enum.HumanoidStateType.Running then
		if not SFX.Walk.IsPlaying then
			SFX.Walk:Play()
		end
	else
		if SFX.Walk.IsPlaying then
			SFX.Walk:Stop()
		end
	end
end)

humanoid.StateChanged:Connect(function(_, newState)
	if newState ~= Enum.HumanoidStateType.Running and SFX.Walk.IsPlaying then
		SFX.Walk:Stop()
	end
end)

----------------------------------------------------
-- LANDING TRIGGER DETECTOR
----------------------------------------------------
local landed = false
humanoid.StateChanged:Connect(function(_, newState)
	if not landed and (newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running) then
		landed = true
		
		if fallTrack and fallTrack.IsPlaying then
			fallTrack:Stop(0.1)
		end
		
		BreakFloor(rootPart.Position - Vector3.new(0, 2.5, 0))
		
		task.wait(0.05)
		PlaySequence()
	end
end)

