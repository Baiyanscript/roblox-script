local function applyTheme(theme)
    CurrentTheme = theme
    local c = Themes[theme]

    Frame.BackgroundColor3 = c.Background
    FrameStroke.Color = c.Border
    TitleBar.BackgroundColor3 = c.TitleBar
    TitleFix.BackgroundColor3 = c.TitleBar
    Title.TextColor3 = c.Text

    for _, b in ipairs({SettingsBtn, MinimizeBtn, CloseBtn}) do
        b.BackgroundColor3 = c.TopButtons
        b.TextColor3 = c.Text
    end

    SettingsFrame.BackgroundColor3 = c.Background
    SettingsTitle.TextColor3 = c.Text
    ThemeLabel.TextColor3 = c.Text
    ConfirmFrame.BackgroundColor3 = c.Background
    ConfirmText.TextColor3 = c.Text

    -- Keep the selected theme obvious and make both theme labels readable.
    DarkThemeBtn.Text = "DARK"
    LightThemeBtn.Text = "LIGHT"
    DarkThemeBtn.TextColor3 = Color3.new(1, 1, 1)
    LightThemeBtn.TextColor3 = Color3.new(1, 1, 1)
    DarkThemeBtn.BackgroundColor3 = theme == "Dark" and Color3.fromRGB(50, 150, 100) or c.Button
    LightThemeBtn.BackgroundColor3 = theme == "Light" and Color3.fromRGB(50, 150, 100) or c.Button
    BackBtn.TextColor3 = Color3.new(1, 1, 1)

    for _, obj in ipairs(Content:GetDescendants()) do
        if obj:IsA("TextLabel") then
            obj.TextColor3 = c.Text
        elseif obj:IsA("TextBox") then
            obj.TextColor3 = c.Text
            obj.BackgroundColor3 = theme == "Dark" and Color3.fromRGB(45, 45, 45) or Color3.fromRGB(255, 255, 255)
        elseif obj:IsA("TextButton") then
            if effectButtons[obj.Text] then
                obj.BackgroundColor3 = obj.Text == selectedEffect and Color3.fromRGB(120, 35, 35) or c.Button
                obj.TextColor3 = Color3.new(1, 1, 1)
            elseif obj.Text == "PREV" or obj.Text == "PLAY" or obj.Text == "PAUSE" or obj.Text == "RANDOM" or obj.Text == "NEXT" or obj.Text == "RESET AUDIO" then
                obj.BackgroundColor3 = c.Button
                obj.TextColor3 = c.Text
            else
                obj.BackgroundColor3 = theme == "Dark" and Color3.fromRGB(45, 45, 45) or Color3.fromRGB(225, 225, 225)
                obj.TextColor3 = c.Text
            end
        end
    end

    mediaStatus.TextColor3 = c.Text
    mediaName.TextColor3 = c.Text
    mp3FilterButton.BackgroundColor3 = c.Button
    mp3FilterButton.TextColor3 = c.Text
    mediaList.BackgroundColor3 = theme == "Dark" and Color3.fromRGB(28, 28, 28) or Color3.fromRGB(230, 230, 230)
end

