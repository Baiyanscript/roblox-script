local function loadMedia()
    local ok, items = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(MEDIA_API))
    end)
    if not ok or type(items) ~= "table" then
        mediaStatus.Text = "GitHub API request failed"
        return
    end

    mediaItems = {}
    for _, item in ipairs(items) do
        if item.type == "file" and item.download_url then
            local ext = string.lower(item.name:match("%.([^%.]+)$") or "")
            if ext == "mp3" or ext == "mp4" or ext == "webm" then
                if not mp3Only or ext == "mp3" then
                    table.insert(mediaItems, item)
                end
            end
        end
    end
    table.sort(mediaItems, function(a, b) return string.lower(a.name) < string.lower(b.name) end)

    for _, child in ipairs(mediaList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local listY = 2
    for i, item in ipairs(mediaItems) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -5, 0, 23)
        b.Position = UDim2.fromOffset(2, listY)
        b.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        b.BorderSizePixel = 0
        b.Text = "  " .. item.name
        b.TextColor3 = Themes[CurrentTheme].Text
        b.Font = Enum.Font.Gotham
        b.TextSize = 9
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.Parent = mediaList
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
        b.MouseButton1Click:Connect(function() playMediaAt(i, true) end)
        listY = listY + 26
    end
    mediaList.CanvasSize = UDim2.fromOffset(0, listY)
    local filterLabel = mp3Only and "MP3 files" or "media files"
    mediaStatus.Text = tostring(#mediaItems) .. " " .. filterLabel .. " found in /funk"
    mediaIndex = 0
    if #mediaItems > 0 then
        playMediaAt(1, false)
    else
        mediaName.Text = "No matching files"
        stopMedia()
    end
end

