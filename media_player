local function getMediaExtension(fileName)
    return string.lower(tostring(fileName):match("%.([^%.]+)$") or "")
end

local function playMediaAt(index, autoplay)
    if mediaBusy or #mediaItems == 0 then return end
    if index < 1 then index = #mediaItems end
    if index > #mediaItems then index = 1 end

    mediaIndex = index
    local item = mediaItems[index]
    local ext = getMediaExtension(item.name)
    if ext ~= "mp3" and ext ~= "mp4" and ext ~= "webm" then
        mediaStatus.Text = "Unsupported format: " .. ext
        return
    end

    mediaBusy = true
    mediaStatus.Text = "Downloading: " .. item.name
    mediaName.Text = item.name
    stopMedia()

    task.spawn(function()
        local ok, asset = pcall(function()
            local response = game:HttpGet(item.download_url)
            if type(response) ~= "string" or #response == 0 then
                error("Empty download")
            end
            local localPath = MEDIA_FOLDER .. "/" .. safeFileName(item.name)
            writefile(localPath, response)
            return getcustomasset(localPath)
        end)

        if ok and asset then
            if ext == "mp3" then
                mediaSound.SoundId = asset
                mediaVideo.Visible = false
                mediaList.Visible = true
                mediaStatus.Text = "Ready · MP3"
                if autoplay then
                    local played = pcall(function() mediaSound:Play() end)
                    mediaPlayButton.Text = played and "PAUSE" or "PLAY"
                end
            else
                -- VideoFrame is used for both MP4 and WEBM local assets.
                mediaSound:Stop()
                mediaVideo.Visible = true
                mediaList.Visible = false
                local assigned = pcall(function() mediaVideo.Video = asset end)
                if assigned then
                    mediaStatus.Text = "Ready · " .. string.upper(ext)
                    if autoplay then
                        task.wait(0.15)
                        local played = pcall(function() mediaVideo:Play() end)
                        mediaPlayButton.Text = played and "PAUSE" or "PLAY"
                        if not played then
                            mediaStatus.Text = string.upper(ext) .. " loaded, but playback is unsupported"
                        end
                    end
                else
                    mediaVideo.Visible = false
                    mediaList.Visible = true
                    mediaStatus.Text = string.upper(ext) .. " video asset is unsupported"
                end
            end
        else
            mediaVideo.Visible = false
            mediaList.Visible = true
            mediaStatus.Text = "Download failed / executor asset unsupported"
        end
        mediaBusy = false
    end)
end

