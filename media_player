-- AUDIO STATE
local soundSettings = setmetatable({}, {__mode = "k"})
local volumeScale, pitchScale = 1, 1
local lowGain, midGain, highGain = 0, 0, 0
local selectedEffect = "None"

local function isSound(obj)
    return obj and obj:IsA("Sound")
end

local function rememberSound(sound)
    if not soundSettings[sound] then
        soundSettings[sound] = {
            volume = sound.Volume,
            speed = sound.PlaybackSpeed,
        }
    end
end

local function removeAdjustmentEffects(sound)
    for _, child in ipairs(sound:GetChildren()) do
        if child.Name == "BaiyanAudioEQ" or child.Name == "BaiyanAudioFX" then
            child:Destroy()
        end
    end
end

local function addEqualizer(sound)
    local eq = sound:FindFirstChild("BaiyanAudioEQ")
    if not eq then
        eq = Instance.new("EqualizerSoundEffect")
        eq.Name = "BaiyanAudioEQ"
        eq.Parent = sound
    end
    eq.LowGain, eq.MidGain, eq.HighGain = lowGain, midGain, highGain
end

local function applySound(sound)
    if not isSound(sound) then return end
    rememberSound(sound)
    local original = soundSettings[sound]
    pcall(function()
        sound.Volume = math.clamp(original.volume * volumeScale, 0, 10)
        sound.PlaybackSpeed = math.clamp(original.speed * pitchScale, 0.05, 4)
        addEqualizer(sound)
    end)
end

local function applyAllSounds()
    for sound in pairs(soundSettings) do
        if sound.Parent then applySound(sound) end
    end
    for _, obj in ipairs(game:GetDescendants()) do
        if isSound(obj) then applySound(obj) end
    end
end

for _, obj in ipairs(game:GetDescendants()) do
    if isSound(obj) then rememberSound(obj) end
end
game.DescendantAdded:Connect(function(obj)
    if isSound(obj) then
        rememberSound(obj)
        task.defer(applySound, obj)
    end
end)

local function makeEffect(className, name, sound)
    local effect = Instance.new(className)
    effect.Name = name
    effect.Parent = sound
    return effect
end

local function applyEffect(sound, effectName)
    removeAdjustmentEffects(sound)
    if effectName == "None" then return end

    if effectName == "Reverb" or effectName == "Cinema" or effectName == "Underwater" then
        local e = makeEffect("ReverbSoundEffect", "BaiyanAudioFX", sound)
        if effectName == "Cinema" then
            e.DecayTime, e.Density, e.WetLevel, e.DryLevel = 5, 0.7, -15, 0
        elseif effectName == "Underwater" then
            e.DecayTime, e.Density, e.WetLevel, e.DryLevel = 1.5, 1, -6, -4
        else
            e.DecayTime, e.Density, e.WetLevel, e.DryLevel = 2.6, 0.75, -9, 0
        end
    elseif effectName == "Echo" then
        local e = makeEffect("EchoSoundEffect", "BaiyanAudioFX", sound)
        e.Delay, e.Feedback, e.WetLevel, e.DryLevel = 0.7, 0.5, -6, 0
    elseif effectName == "Distortion" then
        local e = makeEffect("DistortionSoundEffect", "BaiyanAudioFX", sound)
        e.Level = 0.4
    elseif effectName == "Chorus" then
        local e = makeEffect("ChorusSoundEffect", "BaiyanAudioFX", sound)
        e.Depth, e.Rate, e.Mix = 0.25, 1.2, 0.6
    elseif effectName == "Flanger" then
        local e = makeEffect("FlangeSoundEffect", "BaiyanAudioFX", sound)
        e.Depth, e.Rate, e.Mix = 0.4, 2, 0.5
    elseif effectName == "Tremolo" then
        local e = makeEffect("TremoloSoundEffect", "BaiyanAudioFX", sound)
        e.Depth, e.Frequency = 0.5, 8
    elseif effectName == "Compressor" then
        local e = makeEffect("CompressorSoundEffect", "BaiyanAudioFX", sound)
        e.Threshold, e.Ratio, e.Attack, e.Release = -25, 15, 0.02, 0.1
    elseif effectName == "Radio" then
        local d = makeEffect("DistortionSoundEffect", "BaiyanAudioFX", sound)
        d.Level = 0.25
        local c = makeEffect("CompressorSoundEffect", "BaiyanAudioFX", sound)
        c.Threshold, c.Ratio = -10, 12
    elseif effectName == "Robot" then
        local f = makeEffect("FlangeSoundEffect", "BaiyanAudioFX", sound)
        f.Depth, f.Rate = 0.5, 3
        local t = makeEffect("TremoloSoundEffect", "BaiyanAudioFX", sound)
        t.Depth, t.Frequency = 1, 4
    end
end

local function chooseEffect(effectName)
    selectedEffect = effectName
    pitchScale = 1
    lowGain, midGain, highGain = 0, 0, 0
    if effectName == "Kid" then
        pitchScale, lowGain, midGain, highGain = 1.45, -5, 2, 4
    elseif effectName == "Robot" then
        lowGain, midGain, highGain = -5, 5, 2
    elseif effectName == "Slowed" then
        pitchScale, lowGain, midGain, highGain = 0.72, 8, -2, -12
    elseif effectName == "Cinema" then
        lowGain, midGain, highGain = 6, -2, 2
    elseif effectName == "Underwater" then
        lowGain, midGain, highGain = 4, -12, -25
    end
    for sound in pairs(soundSettings) do
        if sound.Parent then
            applyEffect(sound, effectName)
            applySound(sound)
        end
    end
end

