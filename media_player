end)

MinimizeBtn.MouseButton1Click:Connect(function()
    if confirmOpen then return end
    if settingsOpen then 
        SettingsFrame.Visible = false
        settingsOpen = false 
    end
    minimized = not minimized
    if minimized then
        TitleFix.Visible = false
        Content.Visible = false
        TweenService:Create(Frame, TweenInfo.new(0.1), {Size = UDim2.fromOffset(UIWidth, 30)}):Play()
        MinimizeBtn.Text = "+"
    else
        TitleFix.Visible = true
        Content.Visible = true
        TweenService:Create(Frame, TweenInfo.new(0.1), {Size = UDim2.fromOffset(UIWidth, UIHeight)}):Play()
        MinimizeBtn.Text = "−"
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    if confirmOpen then return end
    confirmOpen = true
    if settingsOpen then SettingsFrame.Visible = false; settingsOpen = false end
    if minimized then
        minimized = false
        TitleFix.Visible = true
        TweenService:Create(Frame, TweenInfo.new(0.1), {Size = UDim2.fromOffset(UIWidth, UIHeight)}):Play()
        MinimizeBtn.Text = "−"
    end
    Content.Visible = false
    ConfirmFrame.Visible = true
end)

