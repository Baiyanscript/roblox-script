local function f4(text2)
  local v6, text3 = text2:match("^%s*(.-)%s*$"):match("%$([%d%.]+)%s*([kKmMbB]?)%s*/?s?")
  local v7 = tonumber(v6) or 0

  if text3 then
    local lower = text3:lower()

    if lower == "k" then
      v7 = v7 * 1000
    elseif lower == "m" then
      v7 = v7 * 1000000
    elseif lower == "b" then
      v7 = v7 * 1000000000
    end
  end

  return v7
end

