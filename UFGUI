  local function makeBodyVelocity(instance3)
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    local character2 = instance3 and instance3.Character
    local humanoid2

    if character2 and character2:FindFirstChildOfClass("Humanoid") then
      humanoid2 = character2:FindFirstChildOfClass("Humanoid")
    end

    local rootPart2

    if humanoid2 and humanoid2.RootPart then
      rootPart2 = humanoid2.RootPart
    end

    local head

    if character2 and character2:FindFirstChild("Head") then
      head = character2.Head
    end

    local accessory

    if character2 and character2:FindFirstChildOfClass("Accessory") then
      accessory = character2:FindFirstChildOfClass("Accessory")
    end

    local handle

    if accessory and accessory:FindFirstChild("Handle") then
      handle = accessory.Handle
    end

    local v5 = character and humanoid and rootPart
    local f5

    if v5 then
      if rootPart.Velocity.Magnitude < 50 then
        getgenv().OldPos = rootPart.CFrame
      end

      if humanoid2 and humanoid2.Sit then
        return f2("Error Occurred", "Target is sitting", 5)
      end

      if head then
        workspace.CurrentCamera.CameraSubject = head
      elseif not head and handle then
        workspace.CurrentCamera.CameraSubject = handle
      elseif humanoid2 and rootPart2 then
        workspace.CurrentCamera.CameraSubject = humanoid2
      end

      if not (character2 and character2:FindFirstChildWhichIsA("BasePart")) then
        return
      end

      function f5(p4, p5, p6)
        rootPart.CFrame = CFrame.new(p4.Position) * p5 * p6
        character:SetPrimaryPartCFrame(CFrame.new(p4.Position) * p5 * p6)

        rootPart.Velocity = Vector3.new(9000000000, 900000000000, 9000000000)
        rootPart.RotVelocity = Vector3.new(9000000000, 9000000000, 9000000000)
      end

      local function f6(instance4)
        local v6 = tick()
        local total = 0

        if not (instance4.Velocity.Magnitude > 300) then
          if instance4.Parent == instance3.Character then
            if instance3.Parent == players then
              if not (humanoid2 and humanoid2.Sit) then
                local health = humanoid and humanoid.Health and humanoid.Health <= 0
                  or tick() > v6 + 2
              end
            end
          end
        end
        local sit

        repeat
          if rootPart and humanoid2 then
            if instance4.Velocity.Magnitude < 50 then
              total = total + 150

              f5(instance4, CFrame.new(0, 1.5, 0)
                + humanoid2.MoveDirection * instance4.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(total), 0, 0))

              task.wait()

              f5(instance4, CFrame.new(0, -1.5, 0)
                + humanoid2.MoveDirection * instance4.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(total), 0, 0))

              task.wait()

              f5(instance4, CFrame.new(3.5, 2.5, -3.5)
                + humanoid2.MoveDirection * instance4.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(total), 0, 0))

              task.wait()

              f5(instance4, CFrame.new(-3.5, -2.5, 3.5)
                + humanoid2.MoveDirection * instance4.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(total), 0, 0))

              task.wait()

              f5(
                instance4, CFrame.new(0, 2, 0) + humanoid2.MoveDirection * 2,
                CFrame.Angles(math.rad(total), 0, 0)
              )

              task.wait()

              f5(
                instance4, CFrame.new(0, -2, 0) + humanoid2.MoveDirection * 2,
                CFrame.Angles(math.rad(total), 0, 0)
              )

              task.wait()
            else
              f5(
                instance4, CFrame.new(0, 2, humanoid2.WalkSpeed * 2),
                CFrame.Angles(math.rad(90), 0, 0)
              )

              task.wait()
              f5(instance4, CFrame.new(0, -2, -humanoid2.WalkSpeed * 2), CFrame.Angles(0, 0, 0))
              task.wait()

              f5(
                instance4, CFrame.new(0, 2, humanoid2.WalkSpeed * 2),
                CFrame.Angles(math.rad(90), 0, 0)
              )

              task.wait()

              f5(
                instance4, CFrame.new(0, 2, rootPart2.Velocity.Magnitude / 1),
                CFrame.Angles(math.rad(90), 0, 0)
              )

              task.wait()

              f5(
                instance4, CFrame.new(0, -2, -rootPart2.Velocity.Magnitude / 1),
                CFrame.Angles(0, 0, 0)
              )

              task.wait()

              f5(
                instance4, CFrame.new(0, 2, rootPart2.Velocity.Magnitude / 1),
                CFrame.Angles(math.rad(90), 0, 0)
              )

              task.wait()
              f5(instance4, CFrame.new(0, -2, 0), CFrame.Angles(math.rad(90), 0, 0))
              task.wait()
              f5(instance4, CFrame.new(0, -2, 0), CFrame.Angles(0, 0, 0))
              task.wait()
              f5(instance4, CFrame.new(0, -2, 0), CFrame.Angles(math.rad(-90), 0, 0))
              task.wait()
              f5(instance4, CFrame.new(0, -2, 0), CFrame.Angles(0, 0, 0))
              task.wait()
            end

            local v7 = instance4.Velocity.Magnitude > 300

            sit = v7

            sit = v7 or instance4.Parent ~= instance3.Character or instance3.Parent ~= players
              or humanoid2 and humanoid2.Sit
              or humanoid and humanoid.Health and humanoid.Health <= 0 or tick() > v6 + 2
          else
            break
          end
        until sit
      end

      workspace.FallenPartsDestroyHeight = (0 / 0)

      local epixVel = Instance.new("BodyVelocity")
      epixVel.Name = "EpixVel"
      epixVel.Parent = rootPart
      epixVel.Velocity = Vector3.new(9000000000, 9000000000, 9000000000)
      epixVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

      humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

      if rootPart2 and head then
        if (rootPart2.CFrame.p - head.CFrame.p).Magnitude > 5 then
