coroutine.wrap(function()
  local parent = Instance.new("LocalScript", mainFrame).Parent
  local position, position2

  local function f1(input)
    local v1 = input.Position - position

    parent.Position = UDim2.new(
      position2.X.Scale, position2.X.Offset + v1.X, position2.Y.Scale, position2.Y.Offset + v1.Y
    )
  end

  local v2

  parent.InputBegan:Connect(function(input2)
    if input2.UserInputType == Enum.UserInputType.MouseButton1
      or input2.UserInputType == Enum.UserInputType.Touch then
      v2 = true
      position = input2.Position
      position2 = parent.Position

      input2.Changed:Connect(function()
        if input2.UserInputState == Enum.UserInputState.End then
          v2 = false
        end
      end)
    end
  end)

  local v3

  parent.InputChanged:Connect(function(input3)
    if input3.UserInputType == Enum.UserInputType.MouseMovement
      or input3.UserInputType == Enum.UserInputType.Touch then
      v3 = input3
    end
  end)

  userInputService.InputChanged:Connect(function(input4)
    if input4 == v3 and v2 then
      f1(input4)
    end
  end)
end)()

