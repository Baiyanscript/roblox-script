-- HELPERS
-- ============================================================

-- Returns screen-space bounding box (x, y, w, h) for a character,
-- or nil if off-screen / behind camera.
local function getCharacterBounds(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- Sample points: head top, feet bottom, and 4 sides at shoulder width
    local rootPos = hrp.CFrame
    local scale   = hrp.Size.Y * 2.2   -- rough full-height scale

    local corners3D = {
        rootPos * Vector3.new( 1.5,  scale/2,  1.5),
        rootPos * Vector3.new(-1.5,  scale/2,  1.5),
        rootPos * Vector3.new( 1.5,  scale/2, -1.5),
        rootPos * Vector3.new(-1.5,  scale/2, -1.5),
        rootPos * Vector3.new( 1.5, -scale/2,  1.5),
        rootPos * Vector3.new(-1.5, -scale/2,  1.5),
        rootPos * Vector3.new( 1.5, -scale/2, -1.5),
        rootPos * Vector3.new(-1.5, -scale/2, -1.5),
    }

    local minX, minY = math.huge,  math.huge
    local maxX, maxY = -math.huge, -math.huge

    for _, pt in ipairs(corners3D) do
        local screen, onScreen = Camera:WorldToViewportPoint(pt)
        if not onScreen then return nil end
        if screen.X < minX then minX = screen.X end
        if screen.X > maxX then maxX = screen.X end
        if screen.Y < minY then minY = screen.Y end
        if screen.Y > maxY then maxY = screen.Y end
    end

    return minX, minY, maxX - minX, maxY - minY
end

-- Health colour: green (full) → red (empty)
local function healthColor(pct)
    pct = math.clamp(pct, 0, 1)
    return Color3.fromRGB(
        math.floor(255 * (1 - pct)),
        math.floor(255 * pct),
        0
    )
end

local function hideAllDrawings(obj)
    for _, line in pairs(obj.box)       do line.Visible = false end
    for _, line in pairs(obj.healthBar) do line.Visible = false end
    obj.nameTag.Visible  = false
    obj.distLabel.Visible = false
    obj.tracer.Visible   = false
end

-- ============================================================
-- MAIN RENDER LOOP
-- ============================================================
RunService.RenderStepped:Connect(function()
    if not Settings.Enabled then
        for _, obj in pairs(ESPObjects) do hideAllDrawings(obj) end
        return
    end

    local localChar = LocalPlayer.Character
    local localHRP  = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local vpSize    = Camera.ViewportSize

    for player, obj in pairs(ESPObjects) do
        -- Basic guards
        if not player or not player.Parent then
            hideAllDrawings(obj)
            continue
        end

        -- Team check
        if Settings.SkipTeammates and player.Team and player.Team == LocalPlayer.Team then
            hideAllDrawings(obj)
            continue
        end

        local character = player.Character
        local humanoid  = character and character:FindFirstChildOfClass("Humanoid")
        local hrp       = character and character:FindFirstChild("HumanoidRootPart")

        if not character or not humanoid or not hrp then
            hideAllDrawings(obj)
            continue
        end

        -- Distance check
        local distance = 0
        if localHRP then
            distance = math.floor((hrp.Position - localHRP.Position).Magnitude)
        end

        if Settings.MaxDistance > 0 and distance > Settings.MaxDistance then
            hideAllDrawings(obj)
            continue
        end

        -- Get 2D bounds
        local x, y, w, h = getCharacterBounds(character)
        if not x then
            hideAllDrawings(obj)
            continue
        end

        -- ---- 2D BOX ----
        local showBox = Settings.Boxes
        local bc = Settings.BoxColor
        -- top
        obj.box.top.From    = Vector2.new(x,     y)
        obj.box.top.To      = Vector2.new(x + w, y)
        obj.box.top.Color   = bc
        obj.box.top.Visible = showBox
        -- bottom
        obj.box.bottom.From    = Vector2.new(x,     y + h)
        obj.box.bottom.To      = Vector2.new(x + w, y + h)
        obj.box.bottom.Color   = bc
        obj.box.bottom.Visible = showBox
        -- left
        obj.box.left.From    = Vector2.new(x, y)
        obj.box.left.To      = Vector2.new(x, y + h)
        obj.box.left.Color   = bc
        obj.box.left.Visible = showBox
        -- right
        obj.box.right.From    = Vector2.new(x + w, y)
        obj.box.right.To      = Vector2.new(x + w, y + h)
        obj.box.right.Color   = bc
        obj.box.right.Visible = showBox

        -- ---- HEALTH BAR ----
        local showHP  = Settings.HealthBars
        local maxHP   = humanoid.MaxHealth
        local curHP   = humanoid.Health
        local hpPct   = maxHP > 0 and (curHP / maxHP) or 0
        local barX    = x - 6           -- 6px left of box
        local barTop  = y
        local barBot  = y + h

        obj.healthBar.bg.From    = Vector2.new(barX, barTop)
        obj.healthBar.bg.To      = Vector2.new(barX, barBot)
        obj.healthBar.bg.Visible = showHP

        local filledY = barBot - (h * hpPct)
        obj.healthBar.fg.From    = Vector2.new(barX, filledY)
        obj.healthBar.fg.To      = Vector2.new(barX, barBot)
        obj.healthBar.fg.Color   = healthColor(hpPct)
        obj.healthBar.fg.Visible = showHP

        -- ---- NAME TAG ----
        obj.nameTag.Text     = player.Name
        obj.nameTag.Color    = Settings.NameColor
        obj.nameTag.Position = Vector2.new(x + w / 2, y - 16)
        obj.nameTag.Visible  = Settings.NameTags

        -- ---- DISTANCE LABEL ----
        obj.distLabel.Text     = distance .. " studs"
        obj.distLabel.Color    = Settings.DistanceColor
        obj.distLabel.Position = Vector2.new(x + w / 2, y + h + 3)
        obj.distLabel.Visible  = Settings.DistanceLabels

        -- ---- TRACER ----
        local feetScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        obj.tracer.From    = Vector2.new(vpSize.X / 2, vpSize.Y)   -- screen bottom-centre
        obj.tracer.To      = Vector2.new(feetScreen.X, feetScreen.Y)
        obj.tracer.Color   = Settings.TracerColor
        obj.tracer.Visible = Settings.Tracers
    end
end)

