-- ============================================================
--  OWNER ESP  |  LocalScript
--  Place in: StarterPlayerScripts
--  Requires: Rayfield module in ReplicatedStorage
-- ============================================================
--  Features:
--    • 2D Bounding Boxes
--    • Health Bars  (left side, green→red)
--    • Name Tags
--    • Distance Labels
--    • Tracers  (screen-bottom → player feet)
--    • Per-feature toggles + colour pickers via Rayfield
--    • Team-check option (skip teammates)
-- ============================================================

local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ============================================================
-- !! REPLACE with your Roblox UserId !!
-- Find it at: roblox.com/users/profile
-- ============================================================
local OWNER_USER_ID = 0
-- ============================================================

local LocalPlayer  = Players.LocalPlayer
local Camera       = workspace.CurrentCamera

if LocalPlayer.UserId ~= OWNER_USER_ID then return end

-- ============================================================
-- SETTINGS  (defaults; all togglable via Rayfield)
-- ============================================================
local Settings = {
    Enabled        = true,
    Boxes          = true,
    HealthBars     = true,
    NameTags       = true,
    DistanceLabels = true,
    Tracers        = true,
    SkipTeammates  = false,
    MaxDistance    = 1000,   -- studs; 0 = unlimited

    -- Colours (RGB 0-255)
    BoxColor       = Color3.fromRGB(255, 50,  50),
    TracerColor    = Color3.fromRGB(255, 255, 0),
    NameColor      = Color3.fromRGB(255, 255, 255),
    DistanceColor  = Color3.fromRGB(180, 180, 255),
}

-- ============================================================
-- DRAWING OBJECTS POOL
-- Each player gets a table of Drawing objects
-- ============================================================
local ESPObjects = {}   -- [player] = { box={}, healthBar={}, nameTag, distLabel, tracer }

local function newDrawing(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end

    -- 2D Box  (4 lines: top, bottom, left, right)
    local box = {
        top    = newDrawing("Line", { Thickness=1.5, Color=Settings.BoxColor,    Visible=false, ZIndex=5 }),
        bottom = newDrawing("Line", { Thickness=1.5, Color=Settings.BoxColor,    Visible=false, ZIndex=5 }),
        left   = newDrawing("Line", { Thickness=1.5, Color=Settings.BoxColor,    Visible=false, ZIndex=5 }),
        right  = newDrawing("Line", { Thickness=1.5, Color=Settings.BoxColor,    Visible=false, ZIndex=5 }),
    }

    -- Health bar  (background + foreground, left of box)
    local healthBar = {
        bg  = newDrawing("Line", { Thickness=4, Color=Color3.fromRGB(0,0,0),     Visible=false, ZIndex=4 }),
        fg  = newDrawing("Line", { Thickness=3, Color=Color3.fromRGB(0,255,0),   Visible=false, ZIndex=5 }),
    }

    -- Name tag
    local nameTag = newDrawing("Text", {
        Text      = player.Name,
        Size      = 13,
        Center    = true,
        Outline   = true,
        Color     = Settings.NameColor,
        Visible   = false,
        ZIndex    = 6,
    })

    -- Distance label
    local distLabel = newDrawing("Text", {
        Text      = "",
        Size      = 11,
        Center    = true,
        Outline   = true,
        Color     = Settings.DistanceColor,
        Visible   = false,
        ZIndex    = 6,
    })

    -- Tracer line
    local tracer = newDrawing("Line", {
        Thickness = 1,
        Color     = Settings.TracerColor,
        Visible   = false,
        ZIndex    = 3,
    })

    ESPObjects[player] = {
        box        = box,
        healthBar  = healthBar,
        nameTag    = nameTag,
        distLabel  = distLabel,
        tracer     = tracer,
    }
end

local function removeESPForPlayer(player)
    local obj = ESPObjects[player]
    if not obj then return end

    for _, line in pairs(obj.box)       do line:Remove() end
    for _, line in pairs(obj.healthBar) do line:Remove() end
    obj.nameTag:Remove()
    obj.distLabel:Remove()
    obj.tracer:Remove()

    ESPObjects[player] = nil
end

-- Initialise for existing players
for _, p in ipairs(Players:GetPlayers()) do
    createESPForPlayer(p)
end
Players.PlayerAdded:Connect(createESPForPlayer)
Players.PlayerRemoving:Connect(removeESPForPlayer)

