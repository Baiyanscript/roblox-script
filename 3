        TextXAlignment = Enum.TextXAlignment.Left,
        Text = label
    })

    local current = (key == "StrongLock" and StrongLock)
        or (key == "Wallcheck" and WallcheckActive)
        or (key == "ESP" and ESPEnabled)
        or (key == "ShowFOV" and ShowFOVCircle)
