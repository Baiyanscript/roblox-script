local DEFAULT_TEAM_COLORS = {
    [BrickColor.new("White")] = true,
    [BrickColor.new("Medium stone grey")] = true,
    [BrickColor.new("Institutional white")] = true,
    [BrickColor.new("Really black")] = true,
