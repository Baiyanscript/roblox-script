    })
    btn.Parent = row
    corner(btn, 10)
    livingStroke(btn, 1, false)

    local knob = make("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = current and UDim2.new(1, -17, 0, 3) or UDim2.new(0, 3, 0, 3),
        BackgroundColor3 = current and BG or SILVER,
        BorderSizePixel = 0
    })
    knob.Parent = btn
    corner(knob, 7)

    btn.MouseButton1Click:Connect(function()
        local newVal
        if key == "StrongLock" then
            StrongLock = not StrongLock
            newVal = StrongLock
            if StrongLock then CurrentTarget = GetClosestPlayerToCrosshair() end
        elseif key == "Wallcheck" then
            WallcheckActive = not WallcheckActive
            newVal = WallcheckActive
        elseif key == "ESP" then
            ESPEnabled = not ESPEnabled
            newVal = ESPEnabled
            if not ESPEnabled then ClearAllESP() end
        elseif key == "ShowFOV" then
