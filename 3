local SliderDragging = false

local function UpdateFOVFromX(mouseX)
    local relX = math.clamp(mouseX - FOVSliderFrame.AbsolutePosition.X, 0, FOVSliderFrame.AbsoluteSize.X)
    local ratio = relX / FOVSliderFrame.AbsoluteSize.X
    FOVRadius = math.floor(ratio * 600) + 20
    FOVFill.Size = UDim2.new(ratio, 0, 1, 0)
    FOVSliderHandle.Position = UDim2.new(ratio, -4, 0, 0)
    FOVLabel.Text = "FOV: " .. FOVRadius
    if FOVCircle then FOVCircle.Radius = FOVRadius end
end

FOVSliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        SliderDragging = true
        UpdateFOVFromX(input.Position.X)
    end
end)

FOVSliderFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        SliderDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not SliderDragging then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        UpdateFOVFromX(input.Position.X)
    end
end)

