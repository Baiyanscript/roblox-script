local function GetPlayerTeam(player)
    if not player then return nil end

    -- 1) 内置 Teams 服务
    local ok, team = pcall(function() return player.Team end)
    if ok and team ~= nil then
        local okN, neutral = pcall(function() return player.Neutral end)
        if not (okN and neutral == true) then
            return { kind = "Team", value = team }
        end
    end

    -- 2) Player Attribute "Team"
    local okA, attr = pcall(function() return player:GetAttribute("Team") end)
    if okA and attr ~= nil then
        return { kind = "Attr", value = attr }
    end

    -- 3) Character Attribute "Team"
    if player.Character then
        local okC, cattr = pcall(function() return player.Character:GetAttribute("Team") end)
        if okC and cattr ~= nil then
            return { kind = "CharAttr", value = cattr }
        end
    end

    -- 4) 旧式 TeamColor（排除默认灰/白/黑，避免误判）
    local okTC, tc = pcall(function() return player.TeamColor end)
    if okTC and tc and not DEFAULT_TEAM_COLORS[tc] then
        return { kind = "Color", value = tc }
    end

    return nil
end

local function IsTeammate(player)
    if not TeamCheck then return false end
    if not player or player == LocalPlayer then return false end
    local a = GetPlayerTeam(player)
    local b = GetPlayerTeam(LocalPlayer)
    if a == nil or b == nil then return false end
    if a.kind ~= b.kind then return false end
    return a.value == b.value
end
