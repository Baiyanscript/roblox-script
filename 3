local function AddESPToPlayer(plr)
    if plr == LocalPlayer then return end
    
    local function setupCharacter(char)
        task.wait(0.5)
        if not char:Parent then return end
        
        local head = char:WaitForChild("Head", 5)
        local root = char:WaitForChild("HumanoidRootPart", 5)
        
        if head and not head:FindFirstChild("ESP_Name") then
            local nameClone = espBillboard:Clone()
            nameClone.Parent = head
            nameClone:FindFirstChildOfClass("TextLabel").Text = plr.Name
        end
        if root and not root:FindFirstChild("ESP_Box") then
            local boxClone = boxBillboard:Clone()
            boxClone.Parent = root
        end
    end

    plr.CharacterAdded:Connect(setupCharacter)
    if plr.Character then setupCharacter(plr.Character) end
end

for _, plr in ipairs(Players:GetPlayers()) do AddESPToPlayer(plr) end
Players.PlayerAdded:Connect(AddESPToPlayer)

-- 队伍检查与 ESP 可见性更新
local function UpdateESPVisibility()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local nameGui = head and head:FindFirstChild("ESP_Name")
            local boxGui = root and root:FindFirstChild("ESP_Box")
            
            if nameGui and boxGui then
                local show = _G.Config.ESP
                if show and _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then
                    show = false
                end
                
                local label = nameGui:FindFirstChildOfClass("TextTransparency") or nameGui:FindFirstChildOfClass("TextLabel")
                local img = boxGui:FindFirstChildOfClass("ImageLabel")
                
                if show then
                    if label then label.TextTransparency = 0 end
                    if img then img.ImageTransparency = 0.43 end
                else
                    if label then label.TextTransparency = 1 end
                    if img then img.ImageTransparency = 1 end
                end
            end
        end
    end
end

-- ==================== 自瞄相关 ====================
local function CreateFOVCircle()
    if FovCircle then pcall(function() FovCircle:Remove() end) end
    FovCircle = Drawing.new("Circle")
    FovCircle.Visible = _G.Config.FOVCircle
    FovCircle.Radius = _G.Config.FOVSize
    FovCircle.Color = _G.Config.CircleColor
    FovCircle.Thickness = 1
    FovCircle.Filled = false
    FovCircle.NumSides = 64
    FovCircle.Transparency = 1 - _G.Config.CircleTransparency
end
CreateFOVCircle()

local function GetClosestPlayer()
    local closest = nil
    local minDist = _G.Config.FOVSize
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then continue end
            
            local char = plr.Character
            if not char then continue end
            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not root or not humanoid or humanoid.Health <= 0 then continue end
            
            local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
            if not onScreen then continue end
            
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if dist < minDist then
                minDist = dist
                closest = plr
            end
        end
    end
    return closest
end

-- 瞄准主循环
RunService.RenderStepped:Connect(function()
    if FovCircle then
        local mousePos = UserInputService:GetMouseLocation()
        FovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        FovCircle.Radius = _G.Config.FOVSize
        FovCircle.Color = _G.Config.CircleColor
        FovCircle.Visible = _G.Config.FOVCircle
    end
    
    if Holding and _G.Config.Aimbot then
        local target = GetClosestPlayer()
        if target and target.Character then
            local aimPart = target.Character:FindFirstChild(_G.Config.AimPart)
            if aimPart then
                local newCF = CFrame.new(Camera.CFrame.Position, aimPart.Position)
                TweenService:Create(Camera, TweenInfo.new(_G.Config.Sensitivity, Enum.EasingStyle.Sine), {CFrame = newCF}):Play()
            end
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Holding = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Holding = false end
end)

