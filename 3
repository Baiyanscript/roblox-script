RunService.RenderStepped:Connect(function(dt)
    AccumulatedTime = AccumulatedTime + dt
    if AccumulatedTime >= UpdateInterval then
        AccumulatedTime = 0
        for _, player in ipairs(Players:GetPlayers()) do
            UpdateESPForPlayer(player)
        end
    end
end)

RunService:BindToRenderStep("Aimbot_Nova", Enum.RenderPriority.Camera.Value + 1, function()
    UpdateFOVCircle()

    if not AimbotActive then
        infoStatus.Text = "Idle"
        infoTarget.Text = "None"
        return
    end

    if CurrentTarget and IsTeammate(CurrentTarget) then
        CurrentTarget = nil
    end

    if CameraWriteBlocked then
        TargetStatusLabel.Text = "Aimed: Camera writes blocked"
        infoStatus.Text = "Blocked"
        return
    end

    if not CurrentTarget or not CurrentTarget.Character or not CurrentTarget.Character.Parent or not IsAlive(CurrentTarget) then
        CurrentTarget = GetClosestPlayerToCrosshair()
    end

    if CurrentTarget and CurrentTarget.Character then
        local bone = GetAimPart(CurrentTarget)
        if bone then
            if WallcheckActive and not CheckWallVisibility(bone, CurrentTarget.Character) then
                TargetStatusLabel.Text = "Aimed: None"
                infoTarget.Text = "None"
                return
            end

            local cam = GetCamera()
            local targetCF = CFrame.new(cam.CFrame.Position, bone.Position)

            if StrongLock then
                local ok = pcall(function() cam.CFrame = targetCF end)
                if not ok then
                    CameraWriteBlocked = true
                    SetAimbotState(false)
                    return
                end
            else
                local ok = pcall(function() cam.CFrame = cam.CFrame:Lerp(targetCF, Smoothness) end)
                if not ok then
                    CameraWriteBlocked = true
                    SetAimbotState(false)
                    return
                end
            end

            TargetStatusLabel.Text = "Aimed: " .. (CurrentTarget.DisplayName or CurrentTarget.Name)
            infoStatus.Text = "Locked"
            infoTarget.Text = (CurrentTarget.DisplayName or CurrentTarget.Name):sub(1, 12)
            return
        end
    end

    TargetStatusLabel.Text = "Aimed: None"
    infoStatus.Text = "Searching"
    infoTarget.Text = "None"
end)

