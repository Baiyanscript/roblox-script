--- Logic Helpers ---

local function isVisible(part)
	if not part then return false end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {LP.Character, Camera, part.Parent}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local result = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), params)
	return result == nil
end

local function getClosestPlayer()
	local closest, maxDist = nil, SETTINGS.FOV
	local mousePos = UIS:GetMouseLocation()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
				if onScreen then
					local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
					if dist < maxDist and isVisible(p.Character.Head) then
						maxDist, closest = dist, p.Character.Head
					end
				end
			end
		end
	end
	return closest
end

--- Inputs ---

UIS.InputBegan:Connect(function(i, processed)
	if processed and not (BindingAim or BindingMenu) then return end
	if BindingAim then
		SETTINGS.AIM_KEY = (i.UserInputType == Enum.UserInputType.Keyboard) and i.KeyCode or i.UserInputType
		kbAim.Text = "Lock Key: "..tostring(SETTINGS.AIM_KEY):gsub("Enum.",""):gsub("KeyCode.",""):gsub("UserInputType.","")
		BindingAim = false
	elseif BindingMenu then
		if i.KeyCode ~= Enum.KeyCode.Unknown then
			SETTINGS.MENU_KEY = i.KeyCode
			kbMenu.Text = "Menu Key: "..tostring(SETTINGS.MENU_KEY):gsub("Enum.KeyCode.","")
		end
		BindingMenu = false
	elseif i.UserInputType == SETTINGS.AIM_KEY or i.KeyCode == SETTINGS.AIM_KEY then 
		IsLocking = true
	elseif i.KeyCode == SETTINGS.MENU_KEY then 
		MenuOpen = not MenuOpen 
		Main.Visible = MenuOpen 
	end
end)

UIS.InputEnded:Connect(function(i) if i.UserInputType == SETTINGS.AIM_KEY or i.KeyCode == SETTINGS.AIM_KEY then IsLocking = false LockedTarget = nil end end)

--- Constant Update Loop ---

RunService.RenderStepped:Connect(function()
	FOVCircle.Position, FOVCircle.Radius = UIS:GetMouseLocation(), SETTINGS.FOV
	
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LP then
			local char = p.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local hum = char:FindFirstChildOfClass("Humanoid")
				
				-- CONSTANTLY ADD/REFRESH ESP
				if hum and hum.Health > 0 then
					-- Highlight Logic
					local hl = char:FindFirstChild("XESP") or Instance.new("Highlight")
					hl.Name, hl.Parent = "XESP", char
					hl.FillColor, hl.Enabled = SETTINGS.COLOR, SETTINGS.ESP
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					
					-- Tracer Logic
					if SETTINGS.TRACERS then
						local pos, vis = Camera:WorldToViewportPoint(char.HumanoidRootPart.Position)
						local t = Tracers[p.Name] or Drawing.new("Line")
						t.Visible = vis
						t.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
						t.To = Vector2.new(pos.X, pos.Y)
						t.Color, t.Thickness = SETTINGS.COLOR, 1
						Tracers[p.Name] = t
					elseif Tracers[p.Name] then 
						Tracers[p.Name].Visible = false 
					end
				else
					-- Cleanup on death
					if char:FindFirstChild("XESP") then char.XESP.Enabled = false end
					if Tracers[p.Name] then Tracers[p.Name].Visible = false end
				end
			else
				-- Cleanup if character disappears (streaming etc)
				if Tracers[p.Name] then Tracers[p.Name].Visible = false end
			end
		end
	end

	-- Aimbot Force
	if IsLocking and SETTINGS.AIM then
		if LockedTarget and LockedTarget.Parent and LockedTarget.Parent:FindFirstChildOfClass("Humanoid") and LockedTarget.Parent:FindFirstChildOfClass("Humanoid").Health > 0 then
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, LockedTarget.Position)
		else
			LockedTarget = getClosestPlayer()
		end
	end
end)

Players.PlayerRemoving:Connect(function(p) if Tracers[p.Name] then Tracers[p.Name]:Remove() Tracers[p.Name] = nil end end)
