-- ==================== 功能函数 ====================
-- 无限跳跃
local infiniteJumpConn = nil
function ToggleInfiniteJump(state)
    if infiniteJumpConn then infiniteJumpConn:Disconnect() end
    if state then
        infiniteJumpConn = UserInputService.JumpRequest:Connect(function()
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

-- 加速
local speedConn = nil
local function ApplySpeedHack(state)
    if speedConn then speedConn:Disconnect() end
    
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if state then
            humanoid.WalkSpeed = _G.Config.WalkSpeed
            -- 安全的监听属性变化，避免无限递归
            speedConn = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if _G.Config.SpeedHack and humanoid and humanoid.Parent then
                    if humanoid.WalkSpeed ~= _G.Config.WalkSpeed then
                        humanoid.WalkSpeed = _G.Config.WalkSpeed
                    end
                else
                    if speedConn then speedConn:Disconnect() end
                end
            end)
        else
            humanoid.WalkSpeed = 16 -- 默认速度
        end
    end
end

-- 静默自瞄（放大 hitbox）
function ToggleSilentAim(state)
    if state then
        task.spawn(function()
            while _G.Config.SilentAim do
                task.wait(1) -- 每秒同步一次Hitbox
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        -- 队伍检查
                        if _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then 
                            continue 
                        end
                        
                        local char = plr.Character
                        local parts = {"RightUpperLeg","LeftUpperLeg","Head","HumanoidRootPart","HeadHB"}
                        for _, partName in ipairs(parts) do
                            local part = char:FindFirstChild(partName)
                            if part and part:IsA("BasePart") then
                                part.CanCollide = false
                                part.Transparency = 0.8
                                part.Size = Vector3.new(13,13,13)
                            end
                        end
                    end
                end
            end
        end)
    end
end

-- 无限弹药
function ToggleInfAmmo(state)
    if state then
        task.spawn(function()
            while _G.Config.InfAmmo do
                task.wait(0.1)
                local gui = LocalPlayer:FindFirstChild("PlayerGui")
                if gui and gui:FindFirstChild("GUI") then
                    local vars = gui.GUI.Client:FindFirstChild("Variables")
                    if vars then
                        local ammo1 = vars:FindFirstChild("ammocount")
                        local ammo2 = vars:FindFirstChild("ammocount2")
                        if ammo1 then ammo1.Value = 999 end
                        if ammo2 then ammo2.Value = 999 end
                    end
                end
            end
        end)
    end
end

-- 射速修改
function ToggleFireRateMod(state)
    if state then
        task.spawn(function()
            while _G.Config.FireRateMod do
                task.wait(3)
                local repStorage = game:GetService("ReplicatedStorage")
                local weapons = repStorage:FindFirstChild("Weapons")
                if weapons then
                    for _, desc in ipairs(weapons:GetDescendants()) do
                        if desc:IsA("ValueBase") then
                            if desc.Name == "Auto" then
                                desc.Value = true
                            elseif desc.Name == "FireRate" then
                                desc.Value = 0.02
                            end
                        end
                    end
                end
            end
        end)
    end
end

-- 后坐力修改
function ToggleRecoilMod(state)
    if state then
        task.spawn(function()
            while _G.Config.RecoilMod do
                task.wait(3)
                local repStorage = game:GetService("ReplicatedStorage")
                local weapons = repStorage:FindFirstChild("Weapons")
                if weapons then
                    for _, desc in ipairs(weapons:GetDescendants()) do
                        if desc:IsA("ValueBase") then
                            if desc.Name == "RecoilControl" or desc.Name == "MaxSpread" then
                                desc.Value = 0
                            end
                        end
                    end
                end
            end
        end)
    end
end

