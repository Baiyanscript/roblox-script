local function CreateNewESPBox()
    local cam = GetCamera()
    if not cam then return nil end
    local inner = Instance.new("BoxHandleAdornment")
    inner.AlwaysOnTop = true
    inner.ZIndex = 10
    inner.Transparency = TransparencyInner
    inner.Color3 = BoxColorInner
    inner.Name = "ESP_HitboxInner"
    inner.Parent = cam
    local outline = Instance.new("BoxHandleAdornment")
    outline.AlwaysOnTop = true
    outline.ZIndex = 9
    outline.Transparency = TransparencyOutline
    outline.Color3 = BoxColorOutline
    outline.Name = "ESP_HitboxOutline"
    outline.Parent = cam
    return { inner = inner, outline = outline }
end

local function GetOrCreateESPBox(player)
    if ESPBoxes[player] then return ESPBoxes[player] end
    local box = table.remove(ESPCache) or CreateNewESPBox()
    ESPBoxes[player] = box
    return box
end

local function RemoveESPBox(player)
    local box = ESPBoxes[player]
    if not box then return end
    box.inner.Adornee = nil
    box.outline.Adornee = nil
    table.insert(ESPCache, box)
    ESPBoxes[player] = nil
end

local function ClearAllESP()
    for p, _ in pairs(ESPBoxes) do
        RemoveESPBox(p)
    end
end

local function UpdateESPForPlayer(player)
    if not ESPEnabled or player == LocalPlayer then
        RemoveESPBox(player)
        return
    end
    if IsPlayerExcluded(player) or IsTeammate(player) then
        RemoveESPBox(player)
        return
    end
    local character = player.Character
    if not character or not character.Parent or not IsAlive(player) then
        RemoveESPBox(player)
        return
    end
    local localChar = LocalPlayer.Character
    if localChar and localChar:FindFirstChild("HumanoidRootPart") then
        local targetRoot = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
        if targetRoot then
            local d = (localChar.HumanoidRootPart.Position - targetRoot.Position).Magnitude
            if d > MaxDistance then
                RemoveESPBox(player)
                return
            end
        end
    end
    local ok, cframe, size = pcall(function() return character:GetBoundingBox() end)
    if not ok or not cframe or not size then
        RemoveESPBox(player)
        return
    end
    local box = GetOrCreateESPBox(player)
    if box then
        box.inner.Adornee = character
        box.inner.Size = size
        box.inner.CFrame = cframe:ToObjectSpace(character:GetPivot())
        box.outline.Adornee = character
        box.outline.Size = size * 1.05
        box.outline.CFrame = cframe:ToObjectSpace(character:GetPivot())
    end
end

local function CheckWallVisibility(targetPart, targetCharacter)
    if not targetPart then return false end
    local cam = GetCamera()
    if not cam then return false end
    local origin = cam.CFrame.Position
    local dir = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local filterList = {}
    if LocalPlayer.Character then table.insert(filterList, LocalPlayer.Character) end
    if targetCharacter then table.insert(filterList, targetCharacter) end
    params.FilterDescendantsInstances = filterList
    params.IgnoreWater = true
    local result = Workspace:Raycast(origin, dir, params)
    return result == nil
end

local function GetClosestPlayerToCrosshair()
    local cam = GetCamera()
    if not cam then return nil end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local bestMag = math.huge
    local bestTarget = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAlive(player) and not IsPlayerExcluded(player) then
            if not IsTeammate(player) then
                local bone = GetAimPart(player)
                if bone then
                    local sp, onScreen = cam:WorldToViewportPoint(bone.Position)
                    if onScreen then
                        local sp2 = Vector2.new(sp.X, sp.Y)
                        local dist = (sp2 - center).Magnitude
                        if dist < FOVRadius and dist < bestMag then
                            if WallcheckActive then
                                if CheckWallVisibility(bone, player.Character) then
                                    bestMag = dist
                                    bestTarget = player
                                end
                            else
                                bestMag = dist
                                bestTarget = player
                            end
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

