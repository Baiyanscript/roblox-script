local function RecalcCanvas()
    local h = 0
    for _, item in ipairs(ListScrollFrame:GetChildren()) do
        if item:IsA("TextButton") then h = h + item.Size.Y.Offset + 4 end
    end
    ListScrollFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(0, h))
end

local function CreatePlayerElement(player)
    if player == LocalPlayer or PlayerListUIElements[player] then return end

    local rowBtn = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = IsPlayerExcluded(player) and WHITE or BG,
        BorderSizePixel = 0,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = IsPlayerExcluded(player) and BG or WHITE,
        Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")",
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false
    })
    rowBtn.Parent = ListScrollFrame
    corner(rowBtn, 8)
    livingStroke(rowBtn, 1, false)

    rowBtn.MouseButton1Click:Connect(function()
        if ExcludedPlayers[player] then
            ExcludedPlayers[player] = nil
            rowBtn.BackgroundColor3 = BG
            rowBtn.TextColor3 = WHITE
        else
            ExcludedPlayers[player] = true
            rowBtn.BackgroundColor3 = WHITE
            rowBtn.TextColor3 = BG
            if CurrentTarget == player then CurrentTarget = nil end
            RemoveESPBox(player)
        end
    end)

    PlayerListUIElements[player] = rowBtn
    RecalcCanvas()
end

local function RemovePlayerElement(player)
    ExcludedPlayers[player] = nil
    local row = PlayerListUIElements[player]
    if row then row:Destroy(); PlayerListUIElements[player] = nil end
    RecalcCanvas()
    RemoveESPBox(player)
end

local function OnTeamChanged()
    if not TeamCheck then return end
    for _, p in ipairs(Players:GetPlayers()) do
        UpdateESPForPlayer(p)
    end
    if CurrentTarget and IsTeammate(CurrentTarget) then
        CurrentTarget = nil
    end
end

local function BindTeamSignals(p)
    pcall(function() p:GetPropertyChangedSignal("Team"):Connect(OnTeamChanged) end)
    pcall(function() p:GetPropertyChangedSignal("TeamColor"):Connect(OnTeamChanged) end)
    pcall(function() p:GetPropertyChangedSignal("Neutral"):Connect(OnTeamChanged) end)
    pcall(function()
        p.CharacterAdded:Connect(function()
            task.wait(0.5)
            OnTeamChanged()
        end)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    CreatePlayerElement(p)
    BindTeamSignals(p)
end

Players.PlayerAdded:Connect(function(p)
    CreatePlayerElement(p)
    BindTeamSignals(p)
end)

Players.PlayerRemoving:Connect(RemovePlayerElement)

LocalPlayer.CharacterAdded:Connect(function() CameraWriteBlocked = false end)
