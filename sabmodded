local workspaceService = game:GetService("Workspace")
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local function f1()
  local lookVector = humanoidRootPart.CFrame.LookVector
  local position = humanoidRootPart.Position
  humanoidRootPart.CFrame = CFrame.new(position + lookVector * 10)
  print("Teleported 5 studs forward!")
end

local currentCamera = workspaceService.CurrentCamera

local function getDeliveryHitbox()
  local v1 = localPlayer.DisplayName .. "'s Base"

  for _, value in ipairs(workspaceService:GetDescendants()) do
    if value:IsA("TextLabel") and value.Text == v1 then
      local model = value:FindFirstAncestorWhichIsA("Model")

      local folder = model
      folder = model or value:FindFirstAncestorWhichIsA("Folder")

      if folder then
        local deliveryHitbox = folder:FindFirstChild("DeliveryHitbox")

        if deliveryHitbox and deliveryHitbox:IsA("BasePart") then
          return deliveryHitbox
        end
      end
    end
  end

  return nil
end

local function f2()
  currentCamera.CameraType = Enum.CameraType.Custom
end

local function f3()
  local cframe = currentCamera.CFrame
  currentCamera.CameraType = Enum.CameraType.Scriptable
  currentCamera.CFrame = cframe
end

local function f4()
  local deliveryHitbox2 = getDeliveryHitbox()

  if deliveryHitbox2 then
    local position2 = humanoidRootPart.Position
    f3()
    humanoidRootPart.CFrame = deliveryHitbox2.CFrame
    wait(0.2)
    humanoidRootPart.CFrame = CFrame.new(position2)
    f2()
    print("Successfully Stoled!")
  else
    warn("DeliveryHitbox bulunamadı!")
  end
end

