player.CharacterAdded:Connect(function(newChar)
	character = newChar
	rootPart = newChar:WaitForChild("HumanoidRootPart")
	humanoid = newChar:WaitForChild("Humanoid")

	for _, p in ipairs(character:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			p.Transparency = 0
		end
	end
	if character:FindFirstChild("Head") then character.Head.Transparency = 0 end

	hitboxTriggered = false
	isChasing = false

	HideChaseOverlay()
	StopChaseTheme()
	if player.PlayerGui:FindFirstChild("EnzukaiDeathScreen") then
		player.PlayerGui.EnzukaiDeathScreen:Destroy()
	end
	if player.PlayerGui:FindFirstChild("EnzukaiSpotGui") then
		player.PlayerGui.EnzukaiSpotGui:Destroy()
	end

	if enzukaiRoot then enzukaiRoot.Anchored = false end

	task.wait(0.5)
	if enzukai then
		StartSightCheck()
		-- Fix: make sure wandering restarts after death/respawn (prevents standing still)
		if not isChasing and not hitboxTriggered then
			startWandering()
		end
	end
end)

player.CharacterRemoving:Connect(function()
	if wanderThread then task.cancel(wanderThread) end
	if chaseThread then task.cancel(chaseThread) end
	if currentWalkAnim then currentWalkAnim.Stop() end
	if currentDecapitateAnim then currentDecapitateAnim.Stop() end
	if clone then clone:Destroy() end
	if camConn then camConn:Disconnect() end
	if spotShakeConn then spotShakeConn:Disconnect() end
	if wanderSimplePath then 
		wanderSimplePath:Stop() 
		wanderSimplePath = nil 
	end
	HideChaseOverlay()
	StopChaseTheme()
end)

