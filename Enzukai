local function getSafeWanderPos()
	if not enzukaiRoot then return Vector3.new(0,0,0) end
	local rayOrigin = enzukaiRoot.Position + Vector3.new(0, 50, 0)
	local rayDirection = Vector3.new(0, -100, 0)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {enzukai}
	params.FilterType = Enum.RaycastFilterType.Exclude

	local result = workspace:Raycast(rayOrigin, rayDirection, params)
	local y = result and result.Position.Y + 5 or enzukaiRoot.Position.Y + 5

	return Vector3.new(
		enzukaiRoot.Position.X + math.random(-45, 45),
		y,
		enzukaiRoot.Position.Z + math.random(-45, 45)
	)
end

local SimplePath = {}
SimplePath.__index = SimplePath

SimplePath.StatusType = { Idle = "Idle"; Active = "Active"; }
SimplePath.ErrorType = { LimitReached = "LimitReached"; TargetUnreachable = "TargetUnreachable"; ComputationError = "ComputationError"; AgentStuck = "AgentStuck"; }

function SimplePath.new(agent)
	local self = setmetatable({
		_settings = {TIME_VARIANCE = 0.07; COMPARISON_CHECKS = 1; JUMP_WHEN_STUCK = true},
		_events = {
			Reached = Instance.new("BindableEvent"),
			WaypointReached = Instance.new("BindableEvent"),
			Blocked = Instance.new("BindableEvent"),
			Error = Instance.new("BindableEvent"),
			Stopped = Instance.new("BindableEvent"),
		},
		_agent = agent,
		_humanoid = agent:FindFirstChildOfClass("Humanoid"),
		_path = PathfindingService:CreatePath(),
		_status = SimplePath.StatusType.Idle,
		_t = 0,
	}, SimplePath)
	return self
end

function SimplePath:Stop()
	if self._status == SimplePath.StatusType.Idle then return end
	if self._moveConnection then self._moveConnection:Disconnect() end
	self._status = SimplePath.StatusType.Idle
	self._events.Stopped:Fire(self._agent)
end

function SimplePath:Run(target)
	if not (target and (typeof(target) == "Vector3" or target:IsA("BasePart"))) then return false end

	if os.clock() - self._t <= self._settings.TIME_VARIANCE and self._humanoid then
		task.wait(os.clock() - self._t)
		self._events.Error:Fire(SimplePath.ErrorType.LimitReached)
		return false
	end
	self._t = os.clock()

	local success = pcall(function()
		self._path:ComputeAsync(self._agent.PrimaryPart.Position, typeof(target) == "Vector3" and target or target.Position)
	end)

	if not success or self._path.Status == Enum.PathStatus.NoPath or #self._path:GetWaypoints() < 2 then
		self._events.Error:Fire(SimplePath.ErrorType.ComputationError)
		return false
	end

	self._status = SimplePath.StatusType.Active
	self._waypoints = self._path:GetWaypoints()
	self._currentWaypoint = 2

	if self._humanoid then
		if self._moveConnection then self._moveConnection:Disconnect() end
		self._moveConnection = self._humanoid.MoveToFinished:Connect(function(reached)
			if reached and self._currentWaypoint + 1 <= #self._waypoints then
				self._currentWaypoint += 1
				self._humanoid:MoveTo(self._waypoints[self._currentWaypoint].Position)
			elseif reached then
				if self._moveConnection then self._moveConnection:Disconnect() end
				self._status = SimplePath.StatusType.Idle
				self._events.Reached:Fire(self._agent, self._waypoints[self._currentWaypoint])
			else
				if self._moveConnection then self._moveConnection:Disconnect() end
				self._status = SimplePath.StatusType.Idle
				self._events.Error:Fire(SimplePath.ErrorType.TargetUnreachable)
			end
		end)
		self._humanoid:MoveTo(self._waypoints[self._currentWaypoint].Position)
	end
	return true
end

local function IsPathBlocked(startPos, endPos)
	local direction = (endPos - startPos).Unit
	local distance = (endPos - startPos).Magnitude + 4
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {enzukai}
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	local result = workspace:Raycast(startPos + Vector3.new(0, 3, 0), direction * distance, params)
	return result ~= nil
end

local function startWandering()
	if wanderThread then task.cancel(wanderThread) end
	if wanderSimplePath then 
		wanderSimplePath:Stop() 
		wanderSimplePath = nil 
	end

	if currentWalkAnim then currentWalkAnim.Stop() currentWalkAnim = nil end

	if walkKF then
		currentWalkAnim = PlayKeyframeSequence(enzukai, walkKF, 1.4)
	end

	if enzukaiHumanoid then enzukaiHumanoid.WalkSpeed = 18 end

	HideChaseOverlay()
	StopChaseTheme()

	wanderThread = task.spawn(function()
		wanderSimplePath = SimplePath.new(enzukai)

		while not isChasing and not hitboxTriggered and enzukaiRoot and enzukaiHumanoid do
			local targetPos = getSafeWanderPos()
			wanderSimplePath:Run(targetPos)

			
			task.wait(math.random(1, 2))

			if os.clock() - lastDialogueTime > DIALOGUE_COOLDOWN and math.random() < 0.4 then
				lastDialogueTime = os.clock()
				local dlg = getRandomDialogue()
				task.spawn(ShowDialogue, dlg)
			end
		end

		if wanderSimplePath then 
			wanderSimplePath:Stop() 
			wanderSimplePath = nil 
		end
	end)
end

local function startChasing()
	isChasing = true
	for _, gui in ipairs(player.PlayerGui:GetChildren()) do
		if gui.Name == "EnzukaiDialogue" then
			gui:Destroy()
		end
	end
	if currentWalkAnim then currentWalkAnim.Stop() currentWalkAnim = nil end

	if walkKF then
		currentWalkAnim = PlayKeyframeSequence(enzukai, walkKF, 1.4)
	end

	if enzukaiHumanoid then enzukaiHumanoid.WalkSpeed = 32 end

	PlaySpotEffect()
	ShowChaseOverlay()
	StartChaseTheme()

	local chaseTweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	TS:Create(camera, chaseTweenInfo, {FieldOfView = 80}):Play()

	if chaseThread then task.cancel(chaseThread) end

	local simplePath = SimplePath.new(enzukai)

	chaseThread = task.spawn(function()
		while isChasing and not hitboxTriggered and enzukaiRoot and enzukaiHumanoid do
			local targetHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if targetHRP then
				local blocked = IsPathBlocked(enzukaiRoot.Position, targetHRP.Position)

				if blocked then
					simplePath:Run(targetHRP.Position)
				else
					if simplePath.Status == SimplePath.StatusType.Active then
						simplePath:Stop()
					end
					enzukaiHumanoid:MoveTo(targetHRP.Position)
				end
			end
			task.wait(0.01)
		end
		if simplePath then simplePath:Stop() end
	end)
end

local function StartSightCheck()
	if sightConn then sightConn:Disconnect() end

	sightConn = RunService.Heartbeat:Connect(function()
		if hitboxTriggered or not enzukaiRoot then return end

		local targetHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not targetHRP then return end

		local dist = (targetHRP.Position - enzukaiRoot.Position).Magnitude

		if dist <= SIGHT_RANGE then
			if not isChasing then
				isChasing = true
				if wanderThread then task.cancel(wanderThread) end
				startChasing()
			end
		else
			if isChasing then
				isChasing = false
				local stopChaseTweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				TS:Create(camera, stopChaseTweenInfo, {FieldOfView = 70}):Play()
				startWandering()
			end
		end
	end)
end

local function SetupHitbox()
	if not hitbox then return end

	local hitboxCheckConn = RunService.Heartbeat:Connect(function()
		if hitboxTriggered or not hitbox or not hitbox.Parent then return end

		local partsInHitbox = workspace:GetPartsInPart(hitbox)

		for _, part in ipairs(partsInHitbox) do
			local hum = part.Parent:FindFirstChildOfClass("Humanoid")
			if hum and hum == humanoid and part.Name == "HumanoidRootPart" then
				hitboxTriggered = true
				isChasing = false

				if hitboxCheckConn then hitboxCheckConn:Disconnect() end
				if wanderThread then task.cancel(wanderThread) end
				if chaseThread then task.cancel(chaseThread) end
				if currentWalkAnim then currentWalkAnim.Stop() end

				HideChaseOverlay()
				StopChaseTheme()

				for _, p in ipairs(character:GetDescendants()) do
					if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
						p.Transparency = 1
					end
				end
				if character:FindFirstChild("Head") then character.Head.Transparency = 1 end

				if enzukaiRoot then enzukaiRoot.Anchored = true end

				if decapitateKF then
					currentDecapitateAnim = PlayKeyframeSequence(enzukai, decapitateKF, 1.4)
				end

				local sound1 = Instance.new("Sound")
				sound1.SoundId = getcustomasset("EnzukaiJ.mp3")
				sound1.Volume = 1
				sound1.Parent = workspace
				sound1:Play()

				sound1.Ended:Connect(function()
					local sound2 = Instance.new("Sound")
					sound2.SoundId = getcustomasset("EnzukaiJ2.mp3")
					sound2.Volume = 1
					sound2.Parent = workspace
					local pitchShift = Instance.new("PitchShiftSoundEffect")
					pitchShift.Octave = 0.5
					pitchShift.Parent = sound2
					sound2:Play()
				end)

				local desc = Players:GetHumanoidDescriptionFromUserId(player.CharacterAppearanceId or player.UserId)
				clone = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
				clone.Name = player.Name .. "_Clone"

				local cloneHum = clone:FindFirstChildOfClass("Humanoid")
				if cloneHum then
					cloneHum.PlatformStand = true
					cloneHum.AutoRotate = false
				end
				if clone:FindFirstChild("Animate") then clone.Animate:Destroy() end

				clone.Parent = workspace

				local cloneHRP = clone:FindFirstChild("HumanoidRootPart")
				local weldPart = enzukai:FindFirstChild("WeldPlayer")
				if cloneHRP and weldPart then
					cloneHRP.CFrame = weldPart.CFrame
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = weldPart
					weld.Part1 = cloneHRP
					weld.Parent = cloneHRP
				end

				local cloneHead = clone:FindFirstChild("Head")
				if cloneHead then SetCinematicCamera(cloneHead) end

				if decapitatePlayerKF then
					cloneAnim = PlayKeyframeSequence(clone, decapitatePlayerKF, 1.4)
				end

				task.delay(2, function()
					if clone then
						if cloneAnim then cloneAnim.Stop() end
						clone:Destroy()
						clone = nil
						cloneAnim = nil
					end

					RestoreCamera()

					local deathGui = Instance.new("ScreenGui")
					deathGui.Name = "EnzukaiDeathScreen"
					deathGui.IgnoreGuiInset = true
					deathGui.ResetOnSpawn = false
					deathGui.Parent = player.PlayerGui

					local black = Instance.new("Frame")
					black.Name = "Black"
					black.Size = UDim2.fromScale(1, 1)
					black.BackgroundColor3 = Color3.new(0, 0, 0)
					black.BackgroundTransparency = 0
					black.Parent = deathGui

					if character and character:FindFirstChildOfClass("Humanoid") then
						character.Humanoid.Health = 0
					end
				end)

				break
			end
		end
	end)
end

local function SpawnEnzukai(sightValue)
	SIGHT_RANGE = sightValue or 80

	if enzukai then
		enzukai:Destroy()
	end

	enzukai = enzukaiTemplate:Clone()
	enzukai.Parent = workspace

	enzukaiRoot = enzukai:FindFirstChild("HumanoidRootPart")
	enzukaiHumanoid = enzukai:FindFirstChildOfClass("Humanoid")
	hitbox = enzukai:FindFirstChild("Hitbox", true)

	if enzukaiRoot then
		enzukaiRoot.Anchored = true
		enzukai:PivotTo(rootPart.CFrame * CFrame.new(12, 5, -8))
		task.wait(0.1)
		enzukaiRoot.Anchored = false
	end

	if enzukaiHumanoid then
		enzukaiHumanoid.WalkSpeed = 18
		enzukaiHumanoid.JumpPower = 0
	end

	hitboxTriggered = false
	isChasing = false

	SetupHitbox()
	startWandering()
	StartSightCheck()
end

