-- ===================== GODMODE 核心邏輯 =====================
local function cleanup()
	isGodmode = false [cite: 5]
	if connection then connection:Disconnect() connection = nil end [cite: 5]
	if noclipConn then noclipConn:Disconnect() noclipConn = nil end [cite: 5]
	if deathConn then deathConn:Disconnect() deathConn = nil end [cite: 5]
	
	local char = player.Character
	if char then
		local root = char:FindFirstChild("HumanoidRootPart")
		if root and ghostClone then root.CFrame = ghostClone.HumanoidRootPart.CFrame end [cite: 5]
		if char:FindFirstChild("Humanoid") then 
			char.Humanoid.PlatformStand = false [cite: 5]
			camera.CameraSubject = char.Humanoid [cite: 6]
		end
	end
	if ghostClone then ghostClone:Destroy() ghostClone = nil end [cite: 6]
end

local function enableGodmode()
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	
	cleanup()
	isGodmode = true
	
	char.Archivable = true
	ghostClone = char:Clone() [cite: 6]
	ghostClone.Name = "GhostDecoy" [cite: 6]
	ghostClone.Parent = workspace [cite: 7]
	char.Archivable = false
	
	for _, v in pairs(ghostClone:GetDescendants()) do
		if v:IsA("BasePart") then
			if v.Name:lower():find("root") or v.Name:lower():find("collision") then
				v.Transparency = 0.5 [cite: 7]
			else
				v.Transparency = 0 [cite: 7]
			end
			v.CanCollide = true [cite: 8]
		elseif v:IsA("Decal") or v:IsA("Texture") then
			v.Transparency = 0 [cite: 8]
		end
	end

	if char:FindFirstChild("Animate") then 
		char.Animate:Clone().Parent = ghostClone [cite: 8]
	end
	
	char.Humanoid.PlatformStand = true [cite: 8]
	camera.CameraSubject = ghostClone.Humanoid [cite: 8]
	
	-- 穿牆 (Noclip)
	noclipConn = RunService.Stepped:Connect(function()
		if char then
			for _, v in pairs(char:GetDescendants()) do
				if v:IsA("BasePart") then v.CanCollide = false end [cite: 9]
			end
		end
	end)

	-- 追蹤與遠程物件優化邏輯
	connection = RunService.Heartbeat:Connect(function()
		if ghostClone and char and char:FindFirstChild("HumanoidRootPart") then [cite: 9]
			local moveDir = char.Humanoid.MoveDirection [cite: 10]
			ghostClone.Humanoid:Move(moveDir, false) [cite: 10]
			ghostClone.Humanoid.Jump = char.Humanoid.Jump [cite: 10]
			
			if moveDir.Magnitude > 0 then
				local targetRot = CFrame.lookAt(ghostClone.HumanoidRootPart.Position, ghostClone.HumanoidRootPart.Position + moveDir) [cite: 10]
				ghostClone.HumanoidRootPart.CFrame = ghostClone.HumanoidRootPart.CFrame:Lerp(targetRot, 0.25) [cite: 11]
			end
			
			if tick() - lastPromptUpdate > 0.5 then [cite: 11]
				for _, p in pairs(workspace:GetDescendants()) do [cite: 11]
					if p:IsA("ProximityPrompt") then
						p.MaxActivationDistance = 25 [cite: 12]
						p.RequiresLineOfSight = false [cite: 12]
					end
				end
				lastPromptUpdate = tick() [cite: 13]
			end
			
			-- 真身隱藏在分身下方 15 格確保無敵
			char.HumanoidRootPart.CFrame = ghostClone.HumanoidRootPart.CFrame * CFrame.new(0, -15, 0) [cite: 13]
			char.HumanoidRootPart.Velocity = Vector3.zero [cite: 13]
		else 
			cleanup() [cite: 13]
		end
	end)
	
	deathConn = char.Humanoid.Died:Connect(cleanup) [cite: 14]
end

