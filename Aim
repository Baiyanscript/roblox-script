--[[
    具備 Rayfield UI 的瞄準輔助（Aim Assist）
    請放置於 LocalScript（例如 StarterPlayerScripts 或工具中）
    需先載入 Rayfield 函式庫
]]

-- 修正：使用有效的新連結
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- 設定參數
local AIM_ASSIST_ENABLED = true      -- 是否啟用
local MAX_DISTANCE = 200             -- 最大追蹤距離（單位：遊戲單位）
local FOV_RADIUS = 150               -- 啟動區域半徑（螢幕像素，準星進入此範圍時吸附）
local STRENGTH = 0.5                 -- 輔助強度 (0 ~ 1)

-- 取得敵方玩家（可依隊伍判斷修改）
local function GetEnemies()
    local enemies = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local team = player.Team
            if team ~= LocalPlayer.Team or team == nil then
                table.insert(enemies, player.Character)
            end
        end
    end
    return enemies
end

-- 找到螢幕 FOV 內最近的敵人
local function GetClosestEnemy()
    local mouse = LocalPlayer:GetMouse()
    local viewportPoint = Vector2.new(mouse.X, mouse.Y)
    local closestEnemy = nil
    local closestDistance = FOV_RADIUS

    for _, enemyChar in ipairs(GetEnemies()) do
        local rootPart = enemyChar:FindFirstChild("HumanoidRootPart") or enemyChar:FindFirstChild("Head")
        if rootPart then
            local screenPos, onScreen = Camera:WorldToScreenPoint(rootPart.Position)
            if onScreen then
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - viewportPoint).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestEnemy = rootPart
                end
            end
        end
    end
    return closestEnemy, closestDistance
end

-- 瞄準輔助核心邏輯（移動滑鼠）
local function ApplyAimAssist()
    if not AIM_ASSIST_ENABLED or STRENGTH <= 0 then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end  -- 僅在右鍵瞄準時生效

    local targetPart = GetClosestEnemy()
    if not targetPart then return end

    local targetPos = targetPart.Position
    local targetScreen = Camera:WorldToScreenPoint(targetPos)
    local mouse = LocalPlayer:GetMouse()
    local currentMousePos = Vector2.new(mouse.X, mouse.Y)
    local delta = (Vector2.new(targetScreen.X, targetScreen.Y) - currentMousePos) * STRENGTH

    -- 移動滑鼠（Delta 執行器專用函式）
    mousemoverel(delta.X, delta.Y)
    -- 其他執行器可改為：mouse_move(delta.X, delta.Y)
end

-- 每幀執行
RunService.RenderStepped:Connect(ApplyAimAssist)

-- ==================== Rayfield UI（台灣繁體中文介面） ====================
local Window = Rayfield:CreateWindow({
    Name = "瞄準輔助",
    LoadingTitle = "正在載入瞄準輔助",
    LoadingSubtitle = "請稍候...",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "AimAssistSettings",
        FileName = "Config"
    }
})

local MainTab = Window:CreateTab("輔助設定")

-- 啟用／關閉開關
MainTab:CreateToggle({
    Name = "啟用瞄準輔助",
    CurrentValue = AIM_ASSIST_ENABLED,
    Flag = "AimAssistEnabled",
    Callback = function(Value)
        AIM_ASSIST_ENABLED = Value
    end
})

-- 強度滑桿（0% ~ 100%）
MainTab:CreateSlider({
    Name = "輔助強度",
    Range = {0, 100},
    Increment = 1,
    Suffix = "%",
    CurrentValue = STRENGTH * 100,
    Flag = "AimStrength",
    Callback = function(Value)
        STRENGTH = Value / 100
    end
})

-- FOV 半徑滑桿
MainTab:CreateSlider({
    Name = "啟動範圍（像素）",
    Range = {50, 300},
    Increment = 5,
    Suffix = "px",
    CurrentValue = FOV_RADIUS,
    Flag = "AimFOV",
    Callback = function(Value)
        FOV_RADIUS = Value
    end
})

-- 最大追蹤距離
MainTab:CreateSlider({
    Name = "最大追蹤距離（遊戲單位）",
    Range = {50, 500},
    Increment = 10,
    Suffix = "u",
    CurrentValue = MAX_DISTANCE,
    Flag = "MaxDistance",
    Callback = function(Value)
        MAX_DISTANCE = Value
    end
})

print("瞄準輔助已載入。可透過 Rayfield UI 調整輔助強度。")
