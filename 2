local function GetScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

-- ==================== ENGINE-LEVEL DRAWING ESP SYSTEM ====================
local function CleanESP(plr)
    if ESP_Registry[plr] then
        pcall(function() ESP_Registry[plr].Box:Remove() end)
        pcall(function() ESP_Registry[plr].Name:Remove() end)
        ESP_Registry[plr] = nil
    end
end

local function ConstructESP(plr)
    if plr == LocalPlayer then return end
    CleanESP(plr) -- Wipe existing allocations to prevent ghost threads

    local Box = Drawing.new("Square")
    Box.Visible = false
    Box.Color = Color3.fromRGB(255, 65, 65)
    Box.Thickness = 1.5
    Box.Filled = false

    local Name = Drawing.new("Text")
    Name.Visible = false
    Name.Color = Color3.fromRGB(255, 255, 255)
    Name.Size = 13
    Name.Center = true
    Name.Outline = true

    ESP_Registry[plr] = { Box = Box, Name = Name }
end

local function HookPlayer(plr)
    if plr == LocalPlayer then return end
    ConstructESP(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.2) -- Safe engine synchronization delay
        ConstructESP(plr)
    end)
end

-- Track Active Session
for _, plr in ipairs(Players:GetPlayers()) do HookPlayer(plr) end
Players.PlayerAdded:Connect(HookPlayer)
Players.PlayerRemoving:Connect(CleanESP)

-- ==================== INSTANT RE-SCAN MECHANISM (ANTI-LEAK) ====================
task.spawn(function()
    while true do
        task.wait(1.0) -- Force audit tracking states across instances
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not ESP_Registry[plr] then
                HookPlayer(plr)
            end
        end
    end
end)

-- ==================== TARGET ACQUISITION (CENTER METRIC) ====================
local function TargetLockSelection()
    local lockedTarget = nil
    local shortestRadius = _G.Config.FOVSize
    local screenCenter = GetScreenCenter()
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then continue end
            
            local character = plr.Character
            if not character then continue end
            local root = character:FindFirstChild("HumanoidRootPart")
            local hum = character:FindFirstChildOfClass("Humanoid")
            if not root or not hum or hum.Health <= 0 then continue end
            
            local screenPosition, visibleOnViewport = Camera:WorldToScreenPoint(root.Position)
            if not visibleOnViewport then continue end
            
            local distanceToCenter = (Vector2.new(screenPosition.X, screenPosition.Y) - screenCenter).Magnitude
            if distanceToCenter < shortestRadius then
                shortestRadius = distanceToCenter
                lockedTarget = plr
            end
        end
    end
    return lockedTarget
end

-- ==================== CORE PIPELINE RENDERING ====================
RunService.RenderStepped:Connect(function()
    -- Sync FOV Profile
    local midPoint = GetScreenCenter()
    CenterFOV.Position = midPoint
    CenterFOV.Radius = _G.Config.FOVSize
    CenterFOV.Visible = _G.Config.FOVCircle

    -- Process Dynamic Screen Scaling ESP
    for plr, render in pairs(ESP_Registry) do
        if not plr or not Players:FindFirstChild(plr.Name) then
            CleanESP(plr)
            continue
        end

        local character = plr.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        
        local validTarget = hrp and (hum == nil or hum.Health > 0)
        local teamAffiliation = (plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team)
        local evaluateVisibility = _G.Config.ESP and validTarget and (not _G.Config.TeamCheck or not teamAffiliation)

        if evaluateVisibility then
            local rootPos, onViewport = Camera:WorldToViewportPoint(hrp.Position)
            
            if onViewport then
                -- Precise 3D Extents Extraction Vector Mechanics
                local highCap = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.4, 0))
                local lowCap = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.0, 0))
                
                local boxHeight = math.abs(lowCap.Y - highCap.Y)
                local boxWidth = boxHeight / 1.65 -- Perfect character framing index
                local teamColor = plr.TeamColor.Color

                -- Update 2D Square Layout properties
                render.Box.Size = Vector2.new(boxWidth, boxHeight)
                render.Box.Position = Vector2.new(rootPos.X - (boxWidth / 2), highCap.Y)
                render.Box.Color = teamColor
                render.Box.Visible = true

                -- Update Text Layout elements
                local realDistance = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
                render.Name.Position = Vector2.new(rootPos.X, highCap.Y - 16)
                render.Name.Color = teamColor
                render.Name.Text = plr.Name .. " [" .. realDistance .. "m]"
                render.Name.Visible = true
            else
                render.Box.Visible = false
                render.Name.Visible = false
            end
        else
            render.Box.Visible = false
            render.Name.Visible = false
        end
    end

    -- Process Clean Vector Camera Tracking Aimbot
    if Holding and _G.Config.Aimbot then
        local targetMatch = TargetLockSelection()
        if targetMatch and targetMatch.Character then
            local executionNode = targetMatch.Character:FindFirstChild(_G.Config.AimPart)
            if executionNode then
                local transformMatrix = CFrame.new(Camera.CFrame.Position, executionNode.Position)
                Camera.CFrame = Camera.CFrame:Lerp(transformMatrix, _G.Config.Sensitivity)
            end
        end
    end
end)

-- ==================== HARDWARE CONTROL ASSIGNMENTS ====================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Holding = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Holding = false end
end)

UserInputService.JumpRequest:Connect(function()
    if _G.Config.InfiniteJump then
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

