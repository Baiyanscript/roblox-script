-- 无限跳跃
local infiniteJumpConn = nil
function ToggleInfiniteJump(state)
    if infiniteJumpConn then infiniteJumpConn:Disconnect() end
    if state then
        infiniteJumpConn = UserInputService.JumpRequest:Connect(function()
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

-- 加速
local function ApplySpeedHack(state)
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if state then
            humanoid.WalkSpeed = _G.Config.WalkSpeed
            -- 监听属性变化以维持速度
            local conn
            conn = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if _G.Config.SpeedHack then
                    humanoid.WalkSpeed = _G.Config.WalkSpeed
                else
                    conn:Disconnect()
                end
            end)
        else
            humanoid.WalkSpeed = 16 -- 默认速度
        end
    end
end

-- 静默自瞄（放大 hitbox）
local silentAimCoroutine = nil
function ToggleSilentAim(state)
    if silentAimCoroutine then
        coroutine.close(silentAimCoroutine)
        silentAimCoroutine = nil
    end
    if state then
        silentAimCoroutine = coroutine.create(function()
            while true do
                task.wait(1)
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local char = plr.Character
                        local parts = {"RightUpperLeg","LeftUpperLeg","Head","HumanoidRootPart"}
                        for _, partName in ipairs(parts) do
                            local part = char:FindFirstChild(partName)
                            if part then
                                part.CanCollide = false
                                part.Transparency = 0.8  -- 避免全透明导致看不见
                                part.Size = Vector3.new(13,13,13)
                            end
                        end
                        -- 兼容 HeadHB（原脚本中的奇怪名称）
                        local headHB = char:FindFirstChild("HeadHB")
                        if headHB then
                            headHB.CanCollide = false
                            headHB.Transparency = 0.8
                            headHB.Size = Vector3.new(13,13,13)
                        end
                    end
                end
            end
        end)
        coroutine.resume(silentAimCoroutine)
    end
end

-- 无限弹药
local ammoLoop = nil
function ToggleInfAmmo(state)
    if ammoLoop then task.cancel(ammoLoop) end
    if state then
        ammoLoop = task.spawn(function()
            while true do
                task.wait()
                local gui = LocalPlayer.PlayerGui
                if gui and gui:FindFirstChild("GUI") then
                    local vars = gui.GUI.Client:FindFirstChild("Variables")
                    if vars then
                        local ammo1 = vars:FindFirstChild("ammocount")
                        local ammo2 = vars:FindFirstChild("ammocount2")
                        if ammo1 then ammo1.Value = 999 end
                        if ammo2 then ammo2.Value = 999 end
                    end
                end
            end
        end)
    end
end

-- 射速修改
local fireRateLoop = nil
function ToggleFireRateMod(state)
    if fireRateLoop then task.cancel(fireRateLoop) end
    if state then
        fireRateLoop = task.spawn(function()
            while true do
                task.wait(5)
                local repStorage = game:GetService("ReplicatedStorage")
                local weapons = repStorage:FindFirstChild("Weapons")
                if weapons then
                    for _, desc in ipairs(weapons:GetDescendants()) do
                        if desc.Name == "Auto" then
                            desc.Value = true
                        elseif desc.Name == "FireRate" then
                            desc.Value = 0.02
                        end
                    end
                end
            end
        end)
    end
end

