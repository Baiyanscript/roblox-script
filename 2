-- 創建單個玩家的繪製物件群
local function createESP(player)
    if player == LocalPlayer then return end

    -- 使用 Roblox Vector2 繪製物件
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 0, 0)
    box.Thickness = 1
    box.Filled = false

    local healthBar = Drawing.new("Line")
    healthBar.Visible = false
    healthBar.Color = Color3.fromRGB(0, 255, 0)
    healthBar.Thickness = 2

    local text = Drawing.new("Text")
    text.Visible = false
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Size = 14
    text.Center = true
    text.Outline = true

    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Color3.fromRGB(255, 255, 0)
    tracer.Thickness = 1

    local function update()
        local connection
        connection = RunService.RenderStepped:Connect(function()
            -- 檢查玩家與角色是否存在
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                local character = player.Character
                local hrp = character.HumanoidRootPart
                local humanoid = character.Humanoid
                
                -- 將 3D 世界座標 轉換為 2D 螢幕座標
                local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen then
                    -- 計算方框大小 (依據距離縮放)
                    local scale = 1 / (hrpPos.Z * math.tan(math.rad(Camera.FieldOfView / 2))) * 1000
                    local boxX = hrpPos.X - (scale / 2)
                    local boxY = hrpPos.Y - (scale / 2)

                    -- 1. 2D 方框 Logic
                    if Settings.BoxESP then
                        box.Size = Vector2.new(scale, scale)
                        box.Position = Vector2.new(boxX, boxY)
                        box.Visible = true
                    else box.Visible = false end

                    -- 2. 血條 Logic
                    if Settings.HealthESP then
                        local healthPercentage = humanoid.Health / humanoid.MaxHealth
                        healthBar.From = Vector2.new(boxX - 5, boxY + scale)
                        healthBar.To = Vector2.new(boxX - 5, boxY + scale - (scale * healthPercentage))
                        healthBar.Color = Color3.fromRGB(255 * (1 - healthPercentage), 255 * healthPercentage, 0)
                        healthBar.Visible = true
                    else healthBar.Visible = false end

                    -- 3. 名字與距離文字 Logic
                    if Settings.NameESP or Settings.DistanceESP then
                        local displayText = ""
                        if Settings.NameESP then displayText = displayText .. player.Name end
                        if Settings.DistanceESP then 
                            local dist = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0)
                            displayText = displayText .. " [" .. tostring(dist) .. "m]"
                        end
                        text.Text = displayText
                        text.Position = Vector2.new(hrpPos.X, boxY - 15)
                        text.Visible = true
                    else text.Visible = false end

                    -- 4. 追蹤射線 Logic (從螢幕底部發射)
                    if Settings.TracerESP then
                        tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        tracer.To = Vector2.new(hrpPos.X, hrpPos.Y)
                        tracer.Visible = true
                    else tracer.Visible = false end
                else
                    -- 出現在螢幕外時隱藏
                    box.Visible = false
                    healthBar.Visible = false
                    text.Visible = false
                    tracer.Visible = false
                end
            else
                -- 玩家死亡或消失時隱藏
                box.Visible = false
                healthBar.Visible = false
                text.Visible = false
                tracer.Visible = false
                if not Players:FindFirstChild(player.Name) then
                    box:Remove()
                    healthBar:Remove()
                    text:Remove()
                    tracer:Remove()
                    connection:Disconnect()
                end
            end
        end)
    end
    coroutine.wrap(update)()
end

-- 追蹤現有與新加入的玩家
for _, player in ipairs(Players:GetPlayers()) do createESP(player) end
Players.PlayerAdded:Connect(createESP)

-- ==========================================
-- 4. 輔助瞄準自瞄核心邏輯 (Aimbot Loop)
-- ==========================================
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            if onScreen then
                -- 計算誰離滑鼠準心最近
                local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local magnitude = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if magnitude < shortestDistance then
                    closestPlayer = player
                    shortestDistance = magnitude
                end
            end
        end
    end
    return closestPlayer
end

-- 自瞄運行迴圈
RunService.RenderStepped:Connect(function()
    if Settings.AimAssist then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            -- 計算平滑插值 (Smoothing / Lerp)
            local targetCFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
            local smoothness = (101 - Settings.AimStrength) / 500 -- 將強度轉換成平滑係數
            
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smoothness)
        end
    end
end)
