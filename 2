    FireRateMod = false,
    RecoilMod = false,
}

local Holding = false
local ESP_Cache = {}

-- ==================== 高稳定性 ESP 核心系统 ====================
-- 清理单个玩家的所有 ESP 绘图
local function CleanPlayerESP(plr)
    if ESP_Cache[plr] then
        pcall(function() ESP_Cache[plr].Box:Remove() end)
        pcall(function() ESP_Cache[plr].Name:Remove() end)
        ESP_Cache[plr] = nil
    end
end

-- 为玩家创建/刷新 ESP 绘图
local function CreateESP(plr)
    if plr == LocalPlayer then return end
    CleanPlayerESP(plr) -- 先彻底清理防止叠加残留

    local Box = Drawing.new("Square")
    Box.Visible = false
    Box.Color = Color3.fromRGB(255, 0, 0)
    Box.Thickness = 1
    Box.Filled = false
    
    local Name = Drawing.new("Text")
    Name.Visible = false
    Name.Text = plr.Name
    Name.Color = Color3.fromRGB(255, 255, 255)
    Name.Size = 13
    Name.Center = true
    Name.Outline = true

    ESP_Cache[plr] = {Box = Box, Name = Name}
end

-- 智能监听：处理玩家中途加入、复活、或者由于延迟导致未加载完的情况
local function MonitorPlayer(plr)
    if plr == LocalPlayer then return end
    CreateESP(plr)
    
    plr.CharacterAdded:Connect(function()
        task.wait(0.3) -- 等待角色物理完全加载
        CreateESP(plr)
    end)
end

-- 初始化当前房间内所有玩家
for _, plr in ipairs(Players:GetPlayers()) do MonitorPlayer(plr) end
Players.PlayerAdded:Connect(MonitorPlayer)
Players.PlayerRemoving:Connect(CleanPlayerESP)

-- ==================== FOV 圆圈 (固定于屏幕中央) ====================
local FovCircle = Drawing.new("Circle")
FovCircle.Visible = _G.Config.FOVCircle
FovCircle.Radius = _G.Config.FOVSize
FovCircle.Color = Color3.fromRGB(255, 255, 255)
FovCircle.Thickness = 1
FovCircle.Filled = false
FovCircle.NumSides = 64

-- 获取屏幕中心点坐标
local function GetScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

-- ==================== 获取 FOV 内最近玩家 ====================
local function GetClosestPlayer()
    local closest = nil
    local minDist = _G.Config.FOVSize
    local centerPos = GetScreenCenter() -- 改为获取屏幕中心，配合Aimbot固定FOV
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then continue end
            
            local char = plr.Character
            if not char then continue end
            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not root or not humanoid or humanoid.Health <= 0 then continue end
            
            local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
            if not onScreen then continue end
            
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
            if dist < minDist then
                minDist = dist
                closest = plr
            end
        end
    end
    return closest
end

-- ==================== 每帧渲染主循环 ====================
RunService.RenderStepped:Connect(function()
    -- 更新 FOV 位置和半径（保持绝对居中）
    local screenCenter = GetScreenCenter()
    FovCircle.Position = screenCenter
    FovCircle.Radius = _G.Config.FOVSize
    FovCircle.Visible = _G.Config.FOVCircle

    -- ESP 渲染控制
    for plr, cache in pairs(ESP_Cache) do
        -- 容错机制：防人跑了或者数据还没删干净崩溃
        if not plr or not Players:FindFirstChild(plr.Name) then 
            CleanPlayerESP(plr)
            continue 
        end

        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if _G.Config.ESP and root and humanoid and humanoid.Health > 0 then
            if _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then
                cache.Box.Visible = false
                cache.Name.Visible = false
                continue
            end
            
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                -- 动态框大小（根据玩家物理距离拉伸缩放）
                local camDist = (Camera.CFrame.Position - root.Position).Magnitude
                local sizeX = math.clamp(2000 / camDist, 10, 140)
                local sizeY = math.clamp(3500 / camDist, 15, 240)
                
                cache.Box.Size = Vector2.new(sizeX, sizeY)
                cache.Box.Position = Vector2.new(pos.X - sizeX / 2, pos.Y - sizeY / 2)
                cache.Box.Visible = true
                
                cache.Name.Position = Vector2.new(pos.X, (pos.Y - sizeY / 2) - 15)
                cache.Name.Visible = true
            else
                cache.Box.Visible = false
                cache.Name.Visible = false
            end
        else
            cache.Box.Visible = false
            cache.Name.Visible = false
        end
    end

    -- 自瞄锁定（右键按住）
    if Holding and _G.Config.Aimbot then
        local target = GetClosestPlayer()
        if target and target.Character then
            local aimPart = target.Character:FindFirstChild(_G.Config.AimPart)
            if aimPart then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, aimPart.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, _G.Config.Sensitivity)
            end
        end
    end
end)

-- 输入接收器（过滤掉打字聊天）
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Holding = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Holding = false end
end)

-- ==================== 强制防护循环（彻底消灭漏人Bug）====================
task.spawn(function()
    while true do
        task.wait(2) -- 每 2 秒主动扫描一次，防止突发漏人
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not ESP_Cache[plr] then
                MonitorPlayer(plr)
            end
        end
    end
end)

-- ==================== 其他高级功能控制循环 ====================
task.spawn(function()
    while true do
        task.wait(1)
        if _G.Config.SilentAim then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
