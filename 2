-- 自动添加 ESP 到新玩家/角色
local function AddESPToPlayer(plr)
    if plr == LocalPlayer then return end
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        if head and not head:FindFirstChild("ESP_Name") then
            local nameClone = espBillboard:Clone()
            nameClone.Parent = head
            nameClone.Name = "ESP_Name"
            nameClone:FindFirstChildOfClass("TextLabel").Text = plr.Name
        end
        if root and not root:FindFirstChild("ESP_Box") then
            local boxClone = boxBillboard:Clone()
            boxClone.Parent = root
            boxClone.Name = "ESP_Box"
        end
    end)
    if plr.Character then
        local char = plr.Character
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        if head and not head:FindFirstChild("ESP_Name") then
            local nameClone = espBillboard:Clone()
            nameClone.Parent = head
            nameClone.Name = "ESP_Name"
            nameClone:FindFirstChildOfClass("TextLabel").Text = plr.Name
        end
        if root and not root:FindFirstChild("ESP_Box") then
            local boxClone = boxBillboard:Clone()
            boxClone.Parent = root
            boxClone.Name = "ESP_Box"
        end
    end
end

for _, plr in ipairs(Players:GetPlayers()) do
