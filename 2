-- 队伍检查与 ESP 可见性更新
local function UpdateESPVisibility()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local nameGui = head and head:FindFirstChild("ESP_Name")
            local boxGui = root and root:FindFirstChild("ESP_Box")
            if nameGui and boxGui then
                local show = _G.Config.ESP
                if show and _G.Config.TeamCheck then
                    if plr.Team == LocalPlayer.Team then
                        show = false
                    end
                end
                if show then
                    nameGui:FindFirstChildOfClass("TextLabel").TextTransparency = 0
                    boxGui.ImageLabel.ImageTransparency = 0.43
                else
                    nameGui:FindFirstChildOfClass("TextLabel").TextTransparency = 1
                    boxGui.ImageLabel.ImageTransparency = 1
                end
            end
        end
    end
end

