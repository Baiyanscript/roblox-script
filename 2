                    if _G.Config.FireRateMod then
                        if desc.Name == "Auto" then desc.Value = true
                        elseif desc.Name == "FireRate" then desc.Value = 0.02 end
                    end
                    if _G.Config.RecoilMod and (desc.Name == "RecoilControl" or desc.Name == "MaxSpread") then
                        desc.Value = 0
                    end
                end
            end
        end
        
        if _G.Config.InfAmmo then
            local gui = LocalPlayer:FindFirstChild("PlayerGui")
            local clientVars = gui and gui:FindFirstChild("GUI") and gui.GUI:FindFirstChild("Client") and gui.GUI.Client:FindFirstChild("Variables")
            if clientVars then
                local a1, a2 = clientVars:FindFirstChild("ammocount"), clientVars:FindFirstChild("ammocount2")
                if a1 then a1.Value = 999 end
                if a2 then a2.Value = 999 end
            end
        end
    end
end)

-- 移动与跳跃机制
local speedConn = nil
local function ApplySpeedHack(state)
    if speedConn then speedConn:Disconnect() end
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if state then
            humanoid.WalkSpeed = _G.Config.WalkSpeed
            speedConn = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if _G.Config.SpeedHack and humanoid and humanoid.Parent then
                    humanoid.WalkSpeed = _G.Config.WalkSpeed
                end
            end)
        else
            humanoid.WalkSpeed = 16
        end
    end
end

UserInputService.JumpRequest:Connect(function()
    if _G.Config.InfiniteJump then
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.6)
    if _G.Config.SpeedHack then ApplySpeedHack(true) end
end)

