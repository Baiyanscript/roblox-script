-- Persistent Hitbox Resizer Thread
task.spawn(function()
    while true do
        task.wait(1)
        if _G.Config.SilentAim then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    if _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then continue end
                    local root = plr.Character:FindFirstChild("HumanoidRootPart")
                    local head = plr.Character:FindFirstChild("Head")
                    if root then root.Size = Vector3.new(_G.Config.HitboxSize, _G.Config.HitboxSize, _G.Config.HitboxSize) root.CanCollide = false end
                    if head then head.Size = Vector3.new(_G.Config.HitboxSize, _G.Config.HitboxSize, _G.Config.HitboxSize) head.CanCollide = false end
                end
            end
        end
    end
end)

-- Engine Gun Config Hooks Thread
task.spawn(function()
    while true do
        task.wait(2)
        local repStorage = game:GetService("ReplicatedStorage")
        local weapons = repStorage:FindFirstChild("Weapons")
        
        if weapons then
            for _, desc in ipairs(weapons:GetDescendants()) do
                if desc:IsA("ValueBase") then
                    if _G.Config.FireRateMod then
                        if desc.Name == "Auto" then desc.Value = true
                        elseif desc.Name == "FireRate" then desc.Value = 0.02 end
                    end
                    if _G.Config.RecoilMod and (desc.Name == "RecoilControl" or desc.Name == "MaxSpread") then
                        desc.Value = 0
                    end
                end
            end
        end
        
        if _G.Config.InfAmmo then
            local gui = LocalPlayer:FindFirstChild("PlayerGui")
            local clientVars = gui and gui:FindFirstChild("GUI") and gui.GUI:FindFirstChild("Client") and gui.GUI.Client:FindFirstChild("Variables")
            if clientVars then
                local a1, a2 = clientVars:FindFirstChild("ammocount"), clientVars:FindFirstChild("ammocount2")
                if a1 then a1.Value = 999 end
                if a2 then a2.Value = 999 end
            end
        end
    end
end)

-- Character Persistence Control
local speedConn = nil
local function ApplySpeedHack(state)
    if speedConn then speedConn:Disconnect() end
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if state then
            humanoid.WalkSpeed = _G.Config.WalkSpeed
            speedConn = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if _G.Config.SpeedHack and humanoid and humanoid.Parent then
                    humanoid.WalkSpeed = _G.Config.WalkSpeed
                end
            end)
        else
            humanoid.WalkSpeed = 16
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.6)
    if _G.Config.SpeedHack then ApplySpeedHack(true) end
end)

