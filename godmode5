-- By LuckyExplore 
local god1On = false
local god2On = false
local deathPos = nil

local player = game.Players.LocalPlayer
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "GodModeGui"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 250, 0, 150) -- 縮小一點 UI 高度，因為少了輸入框
frame.Position = UDim2.new(0, 50, 0, 200)
frame.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
frame.Active = true
frame.Draggable = true

-- God Mode 1 按鈕
local god1Btn = Instance.new("TextButton", frame)
god1Btn.Size = UDim2.new(0, 230, 0, 30)
god1Btn.Position = UDim2.new(0, 10, 0, 10)
god1Btn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
god1Btn.Text = "God Mode: OFF"
god1Btn.TextColor3 = Color3.new(1, 1, 1)
god1Btn.Font = Enum.Font.SourceSansBold
god1Btn.TextSize = 20

god1Btn.MouseButton1Click:Connect(function()
	local char = player.Character or player.CharacterAdded:Wait()
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not god1On then
		humanoid.MaxHealth = math.huge
		humanoid.Health = math.huge
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		humanoid.BreakJointsOnDeath = false
		god1Btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
		god1Btn.Text = "God Mode: ON"
		god1On = true
	else
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
		humanoid.BreakJointsOnDeath = true
		humanoid.MaxHealth = 100
		humanoid.Health = 100
		god1Btn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		god1Btn.Text = "God Mode: OFF"
		god1On = false
	end
end)

-- God Mode V2 按鈕 (直接顯示，不需密碼)
local god2Btn = Instance.new("TextButton", frame)
god2Btn.Size = UDim2.new(0, 230, 0, 30)
god2Btn.Position = UDim2.new(0, 10, 0, 50) -- 調整位置到第二格
god2Btn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
god2Btn.Text = "God Mode V2: OFF"
god2Btn.TextColor3 = Color3.new(1,1,1)
god2Btn.Font = Enum.Font.SourceSansBold
god2Btn.TextSize = 20

god2Btn.MouseButton1Click:Connect(function()
	god2On = not god2On
	if god2On then
		god2Btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
		god2Btn.Text = "God Mode V2: ON"
	else
		god2Btn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		god2Btn.Text = "God Mode V2: OFF"
	end
end)

-- V2 功能邏輯
player.CharacterAdded:Connect(function(char)
	if god2On and deathPos then
		local hrp = char:WaitForChild("HumanoidRootPart")
		hrp.CFrame = deathPos

		local hum = char:WaitForChild("Humanoid")
		hum.MaxHealth = math.huge
		hum.Health = math.huge
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		hum.BreakJointsOnDeath = false

		-- 刪除 revive/lobby
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Model") or v:IsA("Part") then
				local n = string.lower(v.Name)
				if n:find("revive") or n:find("lobby") then
					pcall(function() v:Destroy() end)
				end
			end
		end

		-- 刪除屍體
		for _, v in pairs(workspace:GetChildren()) do
			if v:IsA("Model") and v:FindFirstChild("Humanoid") and v ~= player.Character then
				local h = v:FindFirstChild("Humanoid")
				if h and h.Health <= 0 then
					pcall(function() v:Destroy() end)
				end
			end
		end
	end
end)

-- 監聽玩家死亡以記錄位置
player.Character:WaitForChild("Humanoid").Died:Connect(function()
	if god2On then
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			deathPos = char.HumanoidRootPart.CFrame
		end
		player:LoadCharacter()
	end
end)
