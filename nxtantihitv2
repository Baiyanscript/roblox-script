-- منصة الطيران/الارتفاع (Air Platform Logic)
local isPlatformActive = false
local floorPart = nil
local renderConnection = nil
local currentHeightOffset = 0

-- 讀取輸入框高度數值的函數
local function getHeightStep()
    local num = tonumber(HeightBox.Text)
    return num or 15 -- 如果輸入非數字，預設為 15
end

local function createPlatform()
    if floorPart and floorPart.Parent then
        floorPart:Destroy()
    end
    floorPart = Instance.new("Part")
    floorPart.Name = "FloorPart"
    floorPart.Size = Vector3.new(15, 1, 15)
    floorPart.Anchored = true
    floorPart.CanCollide = true
    floorPart.Transparency = 1
    floorPart.Parent = Workspace
end

local function removePlatform()
    isPlatformActive = false
    currentHeightOffset = 0
    if floorPart then
        floorPart:Destroy()
        floorPart = nil
    end
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
end

local function updatePlatformPosition()
    if not isPlatformActive or not floorPart or not floorPart.Parent then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    floorPart.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.2, hrp.Position.Z)
end

UpBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local step = getHeightStep()

    if not isPlatformActive then
        isPlatformActive = true
        currentHeightOffset = step
        hrp.CFrame = hrp.CFrame + Vector3.new(0, step, 0)
        createPlatform()
        if not renderConnection then
            renderConnection = RunService.RenderStepped:Connect(updatePlatformPosition)
        end
    else
        currentHeightOffset = currentHeightOffset + step
        hrp.CFrame = hrp.CFrame + Vector3.new(0, step, 0)
    end
end)

DownBtn.MouseButton1Click:Connect(function()
    if not isPlatformActive then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local step = getHeightStep()

    if currentHeightOffset <= step then
        removePlatform()
        return
    end

    currentHeightOffset = currentHeightOffset - step
    if hrp then
        hrp.CFrame = hrp.CFrame + Vector3.new(0, -step, 0)
    end

    if currentHeightOffset < step then
        removePlatform()
    end
end)

-- تفعيل/إلغاء ميزة Anti-Hit
local function setAntiHitState(enabled)
    antiHitEnabled = enabled

    if antiHitEnabled then
        ToggleAntiHitBtn.BackgroundColor3 = Color3.fromRGB(35, 160, 35)
        AntiHitText.Text = "ANTI HIT - ON"

        for _, descendant in ipairs(Workspace:GetDescendants()) do
            setupPrompt(descendant)
        end

        if #eventConnections == 0 then
            table.insert(eventConnections, Workspace.DescendantAdded:Connect(function(descendant)
                if antiHitEnabled then setupPrompt(descendant) end
            end))
            
            table.insert(eventConnections, ProximityPromptService.PromptShown:Connect(function(prompt)
                if antiHitEnabled then setupPrompt(prompt) end
            end))
            
            table.insert(eventConnections, ProximityPromptService.PromptTriggered:Connect(function(_, player)
                if antiHitEnabled and player == LocalPlayer then
                    executeAntiHitBypass()
                end
            end))
        end
    else
        ToggleAntiHitBtn.BackgroundColor3 = Color3.fromRGB(160, 35, 35)
        AntiHitText.Text = "ANTI HIT - OFF"

        for _, conn in ipairs(eventConnections) do
            if conn then conn:Disconnect() end
        end
        eventConnections = {}
    end
end

ToggleAntiHitBtn.MouseButton1Click:Connect(function()
    setAntiHitState(not antiHitEnabled)
end)

-- التشغيل المبدئي
setAntiHitState(true)
