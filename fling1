local function toggleObject(object, boolean, color1, color2, text1, text2)
	if boolean then
		object.BackgroundColor3 = color1
		object.Text = text1
	else
		object.BackgroundColor3 = color2
		object.Text = text2
	end
end
local function noClipFunc(character, collide)
  collide = collide or false
	for k, v in pairs(character:GetChildren()) do
		if v:IsA("BasePart") and v.CanCollide then
			v.CanCollide = collide
		end
	end
end
