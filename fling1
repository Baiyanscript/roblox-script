local flingEnabled = false
local flingButton = Instance.new("TextButton", frame)
flingButton.AnchorPoint = Vector2.new(0.5, 0)
flingButton.BackgroundColor3 = Color3.new(1, 0, 0)
flingButton.Size = UDim2.new(0.5, 0, 0.2, 0)
flingButton.Position = UDim2.new(0.5, 0, 0.3, 0)
flingButton.Text = "no fling"
flingButton.TextScaled = true
flingButton.TextColor3 = Color3.new(0, 0, 0)
flingButton.Font = Enum.Font.SourceSans
flingButton.MouseButton1Click:Connect(function()
	flingEnabled = not flingEnabled
	toggleObject(flingButton, flingEnabled, Color3.new(0, 1, 0), Color3.new(1, 0, 0), "FLING!", "no fling")
	
	task.wait(0.1)
	local character = player.Character or workspace[player.Name] or player.CharacterAdded:Wait()
	local hrp = character:FindFirstChild("HumanoidRootPart")
	for k, v in pairs(character:GetChildren()) do
		if v:IsA("BasePart") then
			v.Massless = true
		end
	end
	
	if character and hrp then
		local noClipSignal = nil
		noClipSignal = game["Run Service"].Stepped:Connect(function()
			noClipFunc(character)
		end)
		local youspinmerightroundbabyrightroundlikearecordbabyroundroundroundround = Instance.new("BodyAngularVelocity", hrp)
		youspinmerightroundbabyrightroundlikearecordbabyroundroundroundround.Name = "DestroyerOfWorlds"
		youspinmerightroundbabyrightroundlikearecordbabyroundroundroundround.AngularVelocity = Vector3.new(0, 1E5, 0)
		youspinmerightroundbabyrightroundlikearecordbabyroundroundroundround.MaxTorque = Vector3.new(0, math.huge, 0)
		youspinmerightroundbabyrightroundlikearecordbabyroundroundroundround.P = math.huge
		repeat
			youspinmerightroundbabyrightroundlikearecordbabyroundroundroundround.AngularVelocity = Vector3.new(0, 1E5, 0)
			task.wait(0.3)
			youspinmerightroundbabyrightroundlikearecordbabyroundroundroundround.AngularVelocity = Vector3.new(0, 0, 0)
			task.wait(0.05)
		until not flingEnabled
		noClipFunc(character, true)
		--BEGONE!
		youspinmerightroundbabyrightroundlikearecordbabyroundroundroundround:Destroy()
		noClipSignal:Disconnect()
	end
end)

