local ESPObjects = {}

local function newDrawing(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function createESP(player)
    if player == LocalPlayer or ESPObjects[player] then return end
    ESPObjects[player] = {
        box = {
            top    = newDrawing("Line", {Thickness=1.5, Color=C.Box,    Visible=false, ZIndex=5}),
            bottom = newDrawing("Line", {Thickness=1.5, Color=C.Box,    Visible=false, ZIndex=5}),
            left   = newDrawing("Line", {Thickness=1.5, Color=C.Box,    Visible=false, ZIndex=5}),
            right  = newDrawing("Line", {Thickness=1.5, Color=C.Box,    Visible=false, ZIndex=5}),
        },
        hpBG  = newDrawing("Line", {Thickness=4, Color=Color3.fromRGB(0,0,0),   Visible=false, ZIndex=4}),
        hpFG  = newDrawing("Line", {Thickness=3, Color=Color3.fromRGB(0,255,0), Visible=false, ZIndex=5}),
        name  = newDrawing("Text", {Text=player.Name, Size=13, Center=true, Outline=true, Color=C.Name,     Visible=false, ZIndex=6}),
        dist  = newDrawing("Text", {Text="",          Size=11, Center=true, Outline=true, Color=C.Distance, Visible=false, ZIndex=6}),
        trace = newDrawing("Line", {Thickness=1, Color=C.Tracer, Visible=false, ZIndex=3}),
    }
end

local function removeESP(player)
    local o = ESPObjects[player]
    if not o then return end
    for _, l in pairs(o.box) do l:Remove() end
    o.hpBG:Remove(); o.hpFG:Remove()
    o.name:Remove(); o.dist:Remove(); o.trace:Remove()
    ESPObjects[player] = nil
end

local function hideESP(o)
    for _, l in pairs(o.box) do l.Visible = false end
    o.hpBG.Visible  = false; o.hpFG.Visible  = false
    o.name.Visible  = false; o.dist.Visible  = false
    o.trace.Visible = false
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- ============================================================
-- BOUNDING BOX HELPER
-- ============================================================
local function getBounds(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local h   = hrp.Size.Y * 2.2
    local pos = hrp.CFrame
    local pts = {
        pos * Vector3.new( 1.5,  h/2,  1.5), pos * Vector3.new(-1.5,  h/2,  1.5),
        pos * Vector3.new( 1.5,  h/2, -1.5), pos * Vector3.new(-1.5,  h/2, -1.5),
        pos * Vector3.new( 1.5, -h/2,  1.5), pos * Vector3.new(-1.5, -h/2,  1.5),
        pos * Vector3.new( 1.5, -h/2, -1.5), pos * Vector3.new(-1.5, -h/2, -1.5),
    }
    local minX, minY =  math.huge,  math.huge
    local maxX, maxY = -math.huge, -math.huge
    for _, pt in ipairs(pts) do
        local s, on = Camera:WorldToViewportPoint(pt)
        if not on then return nil end
        if s.X < minX then minX = s.X end
        if s.X > maxX then maxX = s.X end
        if s.Y < minY then minY = s.Y end
        if s.Y > maxY then maxY = s.Y end
    end
    return minX, minY, maxX - minX, maxY - minY
end

local function hpColor(pct)
    pct = math.clamp(pct, 0, 1)
    return Color3.fromRGB(math.floor(255*(1-pct)), math.floor(255*pct), 0)
end

-- ============================================================
-- RENDER LOOP
-- ============================================================
RunService.RenderStepped:Connect(function()
    local vpSize   = Camera.ViewportSize
    local localChr = LocalPlayer.Character
    local localHRP = localChr and localChr:FindFirstChild("HumanoidRootPart")

    for player, o in pairs(ESPObjects) do
        if not Settings.Enabled then hideESP(o) continue end
        if not player or not player.Parent then hideESP(o) continue end
        if Settings.SkipTeammates
            and player.Team
            and player.Team == LocalPlayer.Team then
            hideESP(o) continue
        end

        local chr = player.Character
        local hum = chr and chr:FindFirstChildOfClass("Humanoid")
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        if not chr or not hum or not hrp then hideESP(o) continue end

        local dist = localHRP
            and math.floor((hrp.Position - localHRP.Position).Magnitude)
            or 0
        if Settings.MaxDistance > 0 and dist > Settings.MaxDistance then
            hideESP(o) continue
        end

        local x, y, w, h = getBounds(chr)
        if not x then hideESP(o) continue end

        -- Box
        local sb = Settings.Boxes
        o.box.top.From=Vector2.new(x,y);         o.box.top.To=Vector2.new(x+w,y)
        o.box.bottom.From=Vector2.new(x,y+h);    o.box.bottom.To=Vector2.new(x+w,y+h)
        o.box.left.From=Vector2.new(x,y);         o.box.left.To=Vector2.new(x,y+h)
        o.box.right.From=Vector2.new(x+w,y);      o.box.right.To=Vector2.new(x+w,y+h)
        for _, l in pairs(o.box) do l.Color=C.Box; l.Visible=sb end

        -- Health bar
        local hp  = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local bx  = x - 6
        o.hpBG.From=Vector2.new(bx,y);                     o.hpBG.To=Vector2.new(bx,y+h)
        o.hpFG.From=Vector2.new(bx,y+h-(h*hp));            o.hpFG.To=Vector2.new(bx,y+h)
        o.hpFG.Color = hpColor(hp)
        o.hpBG.Visible=Settings.HealthBars; o.hpFG.Visible=Settings.HealthBars

        -- Name
        o.name.Position=Vector2.new(x+w/2, y-16)
        o.name.Color=C.Name; o.name.Visible=Settings.NameTags

        -- Distance
        o.dist.Text=(dist.." studs")
        o.dist.Position=Vector2.new(x+w/2, y+h+3)
        o.dist.Color=C.Distance; o.dist.Visible=Settings.DistanceLabels

        -- Tracer
        local fs = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
        o.trace.From=Vector2.new(vpSize.X/2, vpSize.Y)
        o.trace.To=Vector2.new(fs.X, fs.Y)
        o.trace.Color=C.Tracer; o.trace.Visible=Settings.Tracers
    end
end)
