local function makeToggle(labelText, settingKey, order)
    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, 0, 0, 38)
    row.BackgroundTransparency = 1
    row.LayoutOrder            = order
    row.Parent                 = Content

    local lbl = Instance.new("TextLabel")
    lbl.Text             = labelText
    lbl.Size             = UDim2.new(1, -52, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3       = C.Text
    lbl.Font             = Enum.Font.Gotham
    lbl.TextSize         = 13
    lbl.TextXAlignment   = Enum.TextXAlignment.Left
    lbl.ZIndex           = 3
    lbl.Parent           = row

    -- Toggle track
    local track = Instance.new("Frame")
    track.Size             = UDim2.new(0, 40, 0, 20)
    track.Position         = UDim2.new(1, -42, 0.5, -10)
    track.BackgroundColor3 = Settings[settingKey] and C.ToggleOn or C.ToggleOff
    track.BorderSizePixel  = 0
    track.ZIndex           = 3
    track.Parent           = row
    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = track

    -- Toggle knob
    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.Position         = Settings[settingKey]
        and UDim2.new(1, -17, 0.5, -7)
        or  UDim2.new(0,   3, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel  = 0
    knob.ZIndex           = 4
    knob.Parent           = track
    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(1, 0)
    kc.Parent = knob

    -- Clickable overlay
    local btn = Instance.new("TextButton")
    btn.Size                   = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text                   = ""
    btn.ZIndex                 = 5
    btn.Parent                 = row

    btn.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        local on = Settings[settingKey]
        TweenService:Create(track, TweenInfo.new(0.15), {
            BackgroundColor3 = on and C.ToggleOn or C.ToggleOff
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = on
                and UDim2.new(1, -17, 0.5, -7)
                or  UDim2.new(0,   3, 0.5, -7)
        }):Play()
    end)
end

local function makeSlider(labelText, settingKey, minVal, maxVal, suffix, order)
    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, 0, 0, 52)
    row.BackgroundTransparency = 1
    row.LayoutOrder            = order
    row.Parent                 = Content

    local lbl = Instance.new("TextLabel")
    lbl.Text             = labelText
    lbl.Size             = UDim2.new(1, 0, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3       = C.Text
    lbl.Font             = Enum.Font.Gotham
    lbl.TextSize         = 13
    lbl.TextXAlignment   = Enum.TextXAlignment.Left
    lbl.ZIndex           = 3
    lbl.Parent           = row

    local valLbl = Instance.new("TextLabel")
    local cur = Settings[settingKey]
    valLbl.Text          = (cur == 0 and suffix == " studs") and "Unlimited" or (cur .. suffix)
    valLbl.Size          = UDim2.new(1, 0, 0, 20)
    valLbl.Position      = UDim2.new(0, 0, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.TextColor3    = C.Accent
    valLbl.Font          = Enum.Font.GothamBold
    valLbl.TextSize      = 11
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.ZIndex        = 3
    valLbl.Parent        = row

    -- Track
    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, 0, 0, 6)
    track.Position         = UDim2.new(0, 0, 0, 30)
    track.BackgroundColor3 = C.Divider
    track.BorderSizePixel  = 0
    track.ZIndex           = 3
    track.Parent           = row
    local trc = Instance.new("UICorner")
    trc.CornerRadius = UDim.new(1, 0)
    trc.Parent = track

    -- Fill
    local fill = Instance.new("Frame")
    local pct0 = (cur - minVal) / (maxVal - minVal)
    fill.Size             = UDim2.new(pct0, 0, 1, 0)
    fill.BackgroundColor3 = C.Accent
    fill.BorderSizePixel  = 0
    fill.ZIndex           = 4
    fill.Parent           = track
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    -- Knob
    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.Position         = UDim2.new(pct0, -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel  = 0
    knob.ZIndex           = 5
    knob.Parent           = track
    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(1, 0)
    kc.Parent = knob

    -- Drag logic
    local dragging = false
    local function updateSlider(inputX)
        local abs = track.AbsolutePosition
        local sz  = track.AbsoluteSize
        local pct = math.clamp((inputX - abs.X) / sz.X, 0, 1)
        local val = math.floor(minVal + pct * (maxVal - minVal))
        Settings[settingKey] = val
        fill.Size     = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -7, 0.5, -7)
        valLbl.Text   = (val == 0 and suffix == " studs") and "Unlimited" or (val .. suffix)
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

