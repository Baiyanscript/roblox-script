Instance.new("UICorner", god2Btn)

--// GodMode V3 Button - 預設直接顯示，位置往上移
local god3Btn = Instance.new("TextButton", frame)
god3Btn.Size = UDim2.new(0, 200, 0, 30)
god3Btn.Position = UDim2.new(0, 15, 0, 120)
god3Btn.Text = "God Mode V3: OFF"
god3Btn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
god3Btn.TextColor3 = Color3.new(1, 1, 1)
god3Btn.Visible = true
Instance.new("UICorner", god3Btn)

--// GodMode V2 邏輯
local god2On = false
local deathPos
god2Btn.MouseButton1Click:Connect(function()
	god2On = not god2On
	if god2On then
		god2Btn.Text = "God Mode V2: ON"
		god2Btn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)

		player.CharacterAdded:Connect(function(char)
			repeat wait() until char:FindFirstChild("HumanoidRootPart")
			if deathPos then
				char.HumanoidRootPart.CFrame = CFrame.new(deathPos)
			end
		end)

		player.Character:WaitForChild("Humanoid").Died:Connect(function()
			deathPos = player.Character.HumanoidRootPart.Position
		end)
	else
		god2Btn.Text = "God Mode V2: OFF"
		god2Btn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
	end
end)

--// GodMode V3 邏輯
local god3On = false
god3Btn.MouseButton1Click:Connect(function()
	god3On = not god3On
	if god3On then
		god3Btn.Text = "God Mode V3: ON"
		god3Btn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)

		local function onCharacterAdded(character)
			local humanoid = character:WaitForChild("Humanoid")
			humanoid.Died:Connect(function()
				deathPos = character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position
				wait(0.05)
				player:LoadCharacter()
			end)
			humanoid.HealthChanged:Connect(function(health)
				if health <= 0 then
					humanoid.Health = humanoid.MaxHealth
				end
			end)
			humanoid.Health = humanoid.MaxHealth
		end

		player.CharacterAdded:Connect(function(char)
			if deathPos then
				repeat wait() until char:FindFirstChild("HumanoidRootPart")
				char.HumanoidRootPart.CFrame = CFrame.new(deathPos)
			end
			onCharacterAdded(char)
		end)

		if player.Character then
			onCharacterAdded(player.Character)
		end
	else
		god3Btn.Text = "God Mode V3: OFF"
		god3Btn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
	end
end)
