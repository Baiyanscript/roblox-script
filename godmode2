-- Open / Close GUI functions
local function openGUI()
    mainFrame.Visible = true
    mainFrame.Position = toggleCircle.Position
    mainFrame.Size = toggleCircle.Size
    local tweenPos = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -160, 0.5, -140)})
    local tweenSize = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 320, 0, 280)})
    tweenPos:Play()
    tweenSize:Play()
end

local function closeGUI()
    local tweenPos = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = toggleCircle.Position})
    local tweenSize = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = toggleCircle.Size})
    tweenPos:Play()
    tweenSize:Play()
    tweenSize.Completed:Wait()
    mainFrame.Visible = false
    confirmFrame.Visible = false
end

