local function ApplyTheme(NewAccent, NewBright)

    Accent = NewAccent
    AccentBright = NewBright

    for _, Object in ipairs(AnimatedStrokes) do
        if Object and Object.Parent then
            Object.Color = Accent
        end
    end

    for _, Object in ipairs(AnimatedLabels) do
        if Object and Object.Parent then
            Object.TextColor3 = AccentBright
