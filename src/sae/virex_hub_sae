    AnimationTime += Delta

    local Pulse =
        (math.sin(AnimationTime * 3) + 1) / 2

    local PulseColor =
        Accent:Lerp(
            AccentBright,
            Pulse * 0.35
        )

    if MainStroke and MainStroke.Parent then

        MainStroke.Color = PulseColor

        MainStroke.Transparency =
            0.18 + Pulse * 0.17
    end

    if SearchStroke and SearchStroke.Parent then

        SearchStroke.Color = PulseColor

        SearchStroke.Transparency =
            0.55 + Pulse * 0.2
    end

    for _, Stroke in ipairs(AnimatedStrokes) do

        if Stroke and Stroke.Parent then
            Stroke.Color = PulseColor
        end
    end

    for _, Button in ipairs(AnimatedButtons) do

        if Button and Button.Parent then

            if Button:GetAttribute("VirexSelected") then

                Button.BackgroundColor3 =
                    Accent:Lerp(
                        AccentBright,
                        Pulse * 0.45
                    )
            end
        end
    end
end)

