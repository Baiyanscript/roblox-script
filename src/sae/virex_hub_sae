local function RunScript(URL, Status)

    Status.Text = "LOADING..."
    Status.TextColor3 = AccentBright

    task.spawn(function()

        local Success, ErrorMessage = pcall(function()

            local Source = game:HttpGet(URL)

            local Function = loadstring(Source)

            if not Function then
                error("Loader compilation failed")
            end

            Function()
        end)

        if Success then

            Status.Text = "ONLINE"
            Status.TextColor3 = Color3.fromRGB(90, 220, 120)

        else

            Status.Text = "ERROR"
            Status.TextColor3 = Color3.fromRGB(255, 80, 80)

            warn("[VIREX]", ErrorMessage)
        end
    end)
end

