        local part = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
        if part then
            local screenPosition, onScreen = Camera:WorldToViewportPoint(part.Position)

            if onScreen then
                local boxSize = Vector2.new(1500 / screenPosition.Z, 1500 / screenPosition.Z)

                if boxType ~= "None" then
                    drawings.box.Size = boxSize
                    drawings.box.Position = Vector2.new(
                        screenPosition.X - boxSize.X / 2,
                        screenPosition.Y - boxSize.Y / 2
