    end
end

local function removeGuards()
    local objects = Workspace:FindFirstChild("__OBJECTS")
    if not objects then
        return
    end

    local areas = objects:FindFirstChild("Areas")
    if not areas then
        return
    end

    local guardAreas = areas:FindFirstChild("GuardAreas")
    if not guardAreas then
        return
    end

    for _, model in pairs(guardAreas:GetChildren()) do
        if model:IsA("Model") then
            local guard = model:FindFirstChild("Guard")
            if guard then
                guard:Destroy()
            end
        end
    end
end

local function bypassAntiCheat()
