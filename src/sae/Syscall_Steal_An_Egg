        removePlayerESP(player)
    end

    for _, drawings in pairs(eggDrawings) do
        if drawings.box then
            drawings.box:Remove()
        end
        if drawings.tracer then
            drawings.tracer:Remove()
        end
        if drawings.dist then
            drawings.dist:Remove()
        end
    end

    table.clear(eggDrawings)
end

