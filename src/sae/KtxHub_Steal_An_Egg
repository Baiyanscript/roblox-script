    progressFill.BackgroundColor3 = Color3.fromRGB(220, 45, 65)
    progressFill.BorderSizePixel = 0
    progressFill.ZIndex = 14
    Instance.new("UICorner", progressFill).CornerRadius = UDim.new(1, 0)
    local fillGrad = Instance.new("UIGradient", progressFill)
    fillGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(160, 25, 45)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 90, 110)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 40, 60)),
    })

    -- Hidden radius label (for settings updates)
    progressRadLbl = Instance.new("TextLabel", mainFrame)
    progressRadLbl.Size = UDim2.new(0, 0, 0, 0)
    progressRadLbl.BackgroundTransparency = 1
