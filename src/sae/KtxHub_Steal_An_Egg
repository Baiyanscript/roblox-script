    RagdollStealEnabled = false,
    MedusaStealEnabled = false,
}

local function loadSettings()
    local data = nil
    if readfile and isfile and isfile("ScarletSettings.json") then
        local content = readfile("ScarletSettings.json")
        if content and content ~= "" then
            data = HS:JSONDecode(content)
        end
    elseif _G.ScarletSettings then
        data = _G.ScarletSettings
    end

    if data then
        Settings.Radius = data.radius or 61
        Settings.Mode = data.mode or 75
        Settings.IsLocked = data.isLocked ~= false
        Settings.Position = data.position
        Settings.AutoStealEnabled = data.autoStealEnabled or false
        Settings.RagdollStealEnabled = data.ragdollStealEnabled or false
        Settings.MedusaStealEnabled = data.medusaStealEnabled or false
    else
        Settings.Radius = 61
        Settings.Mode = 75
        Settings.IsLocked = true
        Settings.Position = nil
        Settings.AutoStealEnabled = false
        Settings.RagdollStealEnabled = false
        Settings.MedusaStealEnabled = false
    end
end

local function saveSettings()
    local pos = mainFrame and mainFrame.Position or nil
    local data = {
        radius = Settings.Radius,
        mode = Settings.Mode,
        isLocked = Settings.IsLocked,
        position = pos and {
            X = pos.X.Scale,
            XOffset = pos.X.Offset,
            Y = pos.Y.Scale,
            YOffset = pos.Y.Offset
        } or nil,
        autoStealEnabled = Settings.AutoStealEnabled,
        ragdollStealEnabled = Settings.RagdollStealEnabled,
        medusaStealEnabled = Settings.MedusaStealEnabled,
    }
    local json = HS:JSONEncode(data)
    if writefile then
        writefile("ScarletSettings.json", json)
    else
        _G.ScarletSettings = data
    end
end

loadSettings()
Steal.StealRadius = Settings.Radius
Steal.AutoStealEnabled = Settings.AutoStealEnabled

local function getStopTimeFromMode()
    local mode = Settings.Mode or 0
    if mode == 0 then return nil end
    return (mode / 100) * Steal.StealDuration
end

local function isMyPlotByName(plotName)
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return false end
    local plot = plots:FindFirstChild(plotName)
    if not plot then return false end
    local sign = plot:FindFirstChild("PlotSign")
    if sign then
        local yb = sign:FindFirstChild("YourBase")
        if yb and yb:IsA("BillboardGui") then
            return yb.Enabled == true
        end
    end
    return false
end

local function findNearestPrompt()
    local char = LP.Character
    if not char then return nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil, nil end

    local nearestPrompt, nearestDist, nearestName = nil, math.huge, nil

    for _, plot in ipairs(plots:GetChildren()) do
        if isMyPlotByName(plot.Name) then continue end
        local pods = plot:FindFirstChild("AnimalPodiums")
        if not pods then continue end
        for _, pod in ipairs(pods:GetChildren()) do
            pcall(function()
                local base = pod:FindFirstChild("Base")
                local spawn = base and base:FindFirstChild("Spawn")
                if spawn then
                    local dist = (spawn.Position - root.Position).Magnitude
                    if dist < nearestDist and dist <= Steal.StealRadius then
                        local att = spawn:FindFirstChild("PromptAttachment")
                        if att then
                            for _, child in ipairs(att:GetChildren()) do
                                if child:IsA("ProximityPrompt") and child.ActionText and child.ActionText:find("Steal") then
                                    nearestPrompt = child
                                    nearestDist = dist
                                    nearestName = pod.Name
                                    break
                                end
                            end
                        end
                    end
                end
            end)
        end
    end

    return nearestPrompt, nearestName
end

local function updateInterruptFlags()
    
    if not Settings.RagdollStealEnabled then
        isRagdolled = false
    else
        local char = LP.Character
        if char then
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                local state = humanoid:GetState()
                isRagdolled = (state == Enum.HumanoidStateType.Physics)
            else
                isRagdolled = false
            end
        else
            isRagdolled = false
        end
    end

    
    if not Settings.MedusaStealEnabled then
        isMedusa = false
    else
        local char = LP.Character
        if char then
            local medusaVal = char:FindFirstChild("Medusa")
            if medusaVal and medusaVal:IsA("BoolValue") then
                isMedusa = medusaVal.Value
            else
                isMedusa = false
            end
        else
            isMedusa = false
        end
    end
end

local function shouldInterrupt()
    return (Settings.RagdollStealEnabled and isRagdolled) or
           (Settings.MedusaStealEnabled and isMedusa) or
           not Steal.AutoStealEnabled
end

local function startStatusUpdater()
    if Conns.statusUpdater then return end
    Conns.statusUpdater = RunService.Heartbeat:Connect(updateInterruptFlags)
end

startStatusUpdater()

local function executeSteal(prompt, podName)
    if isStealing then return end
    if shouldInterrupt() then return end

    if not Steal.Data[prompt] then
        Steal.Data[prompt] = { hold = {}, trigger = {}, ready = true }
        pcall(function()
            if getconnections then
                for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
                    if c.Function then table.insert(Steal.Data[prompt].hold, c.Function) end
                end
                for _, c in ipairs(getconnections(prompt.Triggered)) do
                    if c.Function then table.insert(Steal.Data[prompt].trigger, c.Function) end
                end
            end
        end)
    end

    local data = Steal.Data[prompt]
    if not data.ready then return end
    data.ready = false
    isStealing = true

    resetBar()

    task.spawn(function()
        for _, f in ipairs(data.hold) do task.spawn(f) end

        local duration = Steal.StealDuration
        local promptFired = false
        local stopTime = getStopTimeFromMode()

        if stopTime and stopTime > 0 then
            
            local startTime = tick()
            local stopProgress = stopTime / duration

            
            while isStealing and Steal.AutoStealEnabled do
                if shouldInterrupt() then
                    
                    resetBar()
                    data.ready = true
                    isStealing = false
                    return
                end
                local elapsed = tick() - startTime
                local progress = math.min(elapsed / duration, stopProgress)
                setBar(progress)
                if elapsed >= stopTime then break end
                if not prompt.Parent or not prompt.Parent.Parent then break end
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - prompt.Parent.Parent.Position).Magnitude > Steal.StealRadius then break end
                task.wait()
            end

            if not isStealing or not Steal.AutoStealEnabled or shouldInterrupt() then
                resetBar()
                data.ready = true
                isStealing = false
                return
            end

            setBar(stopProgress)

            
            local phase2Start = tick()
            local timeout = 2.99
            local enteredRadius = false
            while isStealing and Steal.AutoStealEnabled do
                if shouldInterrupt() then
                    resetBar()
                    data.ready = true
                    isStealing = false
                    return
                end
                if tick() - phase2Start >= timeout then break end
                if not prompt.Parent or not prompt.Parent.Parent then break end
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (hrp.Position - prompt.Parent.Parent.Position).Magnitude
                    if dist <= autoGrabSetDelayRadius then
                        enteredRadius = true
                        break
                    elseif dist > Steal.StealRadius then
                        break
                    end
                end
                task.wait()
            end

            if not enteredRadius or not isStealing or not Steal.AutoStealEnabled or shouldInterrupt() or not prompt.Parent then
                resetBar()
                data.ready = true
                isStealing = false
                task.wait()
                local newPrompt, newName = findNearestPrompt()
                if newPrompt then executeSteal(newPrompt, newName) end
                return
            end

            
            local fillStart = tick()
            local fillDuration = duration - stopTime
            while isStealing and Steal.AutoStealEnabled do
                if shouldInterrupt() then
                    resetBar()
                    data.ready = true
                    isStealing = false
                    return
                end
                local fp = (tick() - fillStart) / fillDuration
                local progress = math.min(stopProgress + fp * (1 - stopProgress), 1)
                setBar(progress)
                if progress >= 1 then break end
                if not prompt.Parent or not prompt.Parent.Parent then break end
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - prompt.Parent.Parent.Position).Magnitude > Steal.StealRadius then break end
                task.wait()
            end

            if isStealing and Steal.AutoStealEnabled and not shouldInterrupt() and not promptFired then
                promptFired = true
                pcall(function()
                    for _, f in ipairs(data.trigger) do task.spawn(f) end
                    local remote = ReplicatedStorage:FindFirstChild("StealAnimal")
                    if remote and podName then remote:FireServer(podName) end
                    if prompt then prompt:Fire() end
                end)
            end
        else
            
            local startTime = tick()
            while isStealing and Steal.AutoStealEnabled do
                if shouldInterrupt() then
                    resetBar()
                    data.ready = true
                    isStealing = false
                    return
                end
                local elapsed = tick() - startTime
                local progress = math.min(elapsed / duration, 1)
                setBar(progress)
                if progress >= 1 and not promptFired then
                    promptFired = true
                    pcall(function()
                        for _, f in ipairs(data.trigger) do task.spawn(f) end
                        local remote = ReplicatedStorage:FindFirstChild("StealAnimal")
                        if remote and podName then remote:FireServer(podName) end
                        if prompt then prompt:Fire() end
                    end)
                    break
                end
                if not prompt.Parent or not prompt.Parent.Parent then break end
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - prompt.Parent.Parent.Position).Magnitude > Steal.StealRadius then break end
                task.wait()
            end
        end

        resetBar()
        data.ready = true
        isStealing = false
    end)
end

local function startAutoSteal()
    if Conns.autoSteal then return end
    Conns.autoSteal = RunService.Heartbeat:Connect(function()
        if not Steal.AutoStealEnabled or isStealing or shouldInterrupt() then return end
        local p, n = findNearestPrompt()
        if p then executeSteal(p, n) end
    end)
end

local function stopAutoSteal()
    if Conns.autoSteal then
        Conns.autoSteal:Disconnect()
        Conns.autoSteal = nil
    end
    isStealing = false
    resetBar()
end

local function createGUI()
    local CoreGui = game:GetService("CoreGui")
    local oldGui = CoreGui:FindFirstChild("KTXVsAutoSteal") or CoreGui:FindFirstChild("ScarletAutoSteal")
    if oldGui then oldGui:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "KTXVsAutoSteal"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999
    gui.IgnoreGuiInset = true
    if not pcall(function() gui.Parent = CoreGui end) then
        gui.Parent = LP:WaitForChild("PlayerGui")
    end

    -- Square-ish bar (not capsule), a bit wider
    local baseWidth = 330
    local baseHeight = 48

    mainFrame = Instance.new("Frame", gui)
    mainFrame.Size = UDim2.new(0, baseWidth, 0, baseHeight)
    if Settings.Position then
        mainFrame.Position = UDim2.new(Settings.Position.X, Settings.Position.XOffset, Settings.Position.Y, Settings.Position.YOffset)
    else
        mainFrame.Position = UDim2.new(0.5, -(baseWidth/2), 1, -baseHeight - 28)
    end
    mainFrame.BackgroundColor3 = Color3.fromRGB(12, 6, 8)
    mainFrame.BackgroundTransparency = 0.08
    mainFrame.BorderSizePixel = 0
    mainFrame.ZIndex = 10
    mainFrame.Active = true
    mainFrame.ClipsDescendants = false
    Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 8)

    local dragging, dragStart, startPos = false, nil, nil
    mainFrame.InputBegan:Connect(function(input)
        if Settings.IsLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging or Settings.IsLocked or not dragStart then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local border = Instance.new("UIStroke", mainFrame)
    border.Color = Color3.fromRGB(220, 45, 65)
    border.Thickness = 1.5
    border.Transparency = 0.25

    mainFrame:GetPropertyChangedSignal("Position"):Connect(function()
        Settings.Position = {
            X = mainFrame.Position.X.Scale,
            XOffset = mainFrame.Position.X.Offset,
            Y = mainFrame.Position.Y.Scale,
            YOffset = mainFrame.Position.Y.Offset
        }
        saveSettings()
    end)

    -- Floating dots (like reference)
    local dotsFolder = Instance.new("Frame", mainFrame)
    dotsFolder.Size = UDim2.new(1, 0, 1, 0)
    dotsFolder.BackgroundTransparency = 1
    dotsFolder.ZIndex = 11
    dotsFolder.ClipsDescendants = true
    for i = 1, 18 do
        local d = Instance.new("Frame", dotsFolder)
        local sz = math.random(2, 4)
        d.Size = UDim2.new(0, sz, 0, sz)
        d.Position = UDim2.new(math.random() * 0.9 + 0.05, 0, math.random() * 0.7 + 0.1, 0)
        d.BackgroundColor3 = Color3.fromRGB(220, 45, 65)
        d.BackgroundTransparency = 0.35 + math.random() * 0.45
        d.BorderSizePixel = 0
        d.ZIndex = 11
        Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)
        task.spawn(function()
            local baseY = d.Position.Y.Scale
            local baseX = d.Position.X.Scale
            local speed = 0.15 + math.random() * 0.25
            while d and d.Parent do
                local t = tick() * speed
                d.Position = UDim2.new(
                    baseX + math.sin(t + i) * 0.02,
                    0,
                    baseY + math.cos(t * 0.8 + i) * 0.04,
                    0
                )
                d.BackgroundTransparency = 0.35 + (math.sin(t + i) * 0.25 + 0.25)
                task.wait(0.05)
            end
        end)
    end

    -- 0% (left)
    progressPct = Instance.new("TextLabel", mainFrame)
    progressPct.Size = UDim2.new(0, 54, 0, 22)
    progressPct.Position = UDim2.new(0, 18, 0, 6)
    progressPct.BackgroundTransparency = 1
    progressPct.Text = "0%"
    progressPct.TextColor3 = Color3.fromRGB(255, 255, 255)
    progressPct.Font = Enum.Font.GothamBlack
    progressPct.TextSize = 16
    progressPct.TextXAlignment = Enum.TextXAlignment.Left
    progressPct.ZIndex = 14

    -- FPS + PING (right)
    local statsLbl = Instance.new("TextLabel", mainFrame)
    statsLbl.Name = "StatsLabel"
    statsLbl.Size = UDim2.new(0, 170, 0, 18)
    statsLbl.Position = UDim2.new(1, -180, 0, 8)
    statsLbl.BackgroundTransparency = 1
    statsLbl.Text = "FPS --  PING --ms"
    statsLbl.TextColor3 = Color3.fromRGB(220, 190, 200)
    statsLbl.Font = Enum.Font.GothamBold
    statsLbl.TextSize = 12
    statsLbl.TextXAlignment = Enum.TextXAlignment.Right
    statsLbl.ZIndex = 14

    task.spawn(function()
        local frames, last = 0, tick()
        local conn = RunService.RenderStepped:Connect(function()
            frames = frames + 1
        end)
        while mainFrame and mainFrame.Parent do
            task.wait(0.5)
            local now = tick()
            local elapsed = now - last
            local fps = (elapsed > 0) and math.floor(frames / elapsed + 0.5) or 0
            frames = 0
            last = now
            local ping = 0
            pcall(function()
                local item = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]
                if item then ping = math.floor(item:GetValue() or 0) end
            end)
            if statsLbl and statsLbl.Parent then
                statsLbl.Text = string.format("FPS %d  PING %dms", fps, ping)
            end
        end
        if conn then conn:Disconnect() end
    end)

    -- Thin progress track (bottom)
    local barBg = Instance.new("Frame", mainFrame)
    barBg.Size = UDim2.new(1, -32, 0, 6)
    barBg.Position = UDim2.new(0, 16, 1, -14)
