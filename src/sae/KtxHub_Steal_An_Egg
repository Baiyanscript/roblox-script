    local ADAPT_PREDICT = 0.14
    local ADAPT_LOOK_PRED = 0.3
    local ADAPT_LERP = 0.8
    local ADAPT_CLOSE = 8
    local ADAPT_SWING_DELAY = 0.15

    local hum0 = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum0 then
        hum0.AutoRotate = false
    end

    aimbotV2Conn = RunService.RenderStepped:Connect(function()
        if not batV2State.autoBatToggled then return end
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local bat = char:FindFirstChildOfClass("Tool") or findBat()
        if bat and bat.Parent ~= char then
            pcall(function() hum:EquipTool(bat) end)
        end

        local target = getClosestTargetV2()
        if not target then return end
        pcall(function()
            if type(watchDuelTarget) == "function" then watchDuelTarget(target) end
        end)

        hum.AutoRotate = false

        local myPos = root.Position
        local tPos = target.Position
        local tVel = target.AssemblyLinearVelocity or Vector3.zero
        if type(_getV) == "function" then
            local ok, v = pcall(_getV, target)
            if ok and typeof(v) == "Vector3" then tVel = v end
        end

        -- Adapt prediction
        local toTarget = tPos + tVel * ADAPT_PREDICT + target.CFrame.LookVector * ADAPT_LOOK_PRED - myPos
        local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
        local unit = flat.Magnitude > 0 and flat.Unit or Vector3.zero

        local aimSpd = math.clamp(ADAPT_AIM_SPD, 1, 200)
        local yVel = (tPos.Y + 3.7 - myPos.Y) * 19.5 + tVel.Y * 0.8
        if hum.FloorMaterial ~= Enum.Material.Air then
            yVel = math.max(yVel, 13)
        end
        yVel = math.clamp(yVel, -70, 110)

        local desired = Vector3.new(unit.X * aimSpd, yVel, unit.Z * aimSpd)
        root.AssemblyLinearVelocity = root.AssemblyLinearVelocity:Lerp(desired, ADAPT_LERP)

        local lookAt = tPos + tVel * math.clamp(tVel.Magnitude / 140, 0.05, 0.2)
        if (lookAt - myPos).Magnitude > 0.4 then
            local goalCF = CFrame.lookAt(myPos, lookAt)
            local rx, ry, rz = (root.CFrame:Inverse() * goalCF):ToEulerAnglesXYZ()
            root.AssemblyAngularVelocity = root.CFrame:VectorToWorldSpace(
                Vector3.new(
                    math.clamp(rx, -1.6, 1.6) * 42,
                    math.clamp(ry, -1.6, 2.5) * 42,
                    math.clamp(rz, -1.6, 2.5) * 42
                )
            )
        end

        local dist = (root.Position - target.Position).Magnitude
        if dist <= ADAPT_CLOSE and bat and bat.Parent == char and not batV2State.hittingCooldown then
            batV2State.hittingCooldown = true
            if ktxDuelWinState then ktxDuelWinState.lastAttackAt = tick() end
            pcall(function() bat:Activate() end)
            local ev = bat:FindFirstChildWhichIsA("RemoteEvent")
            if ev then pcall(function() ev:FireServer() end) end
            task.delay(ADAPT_SWING_DELAY, function()
                if batV2State then batV2State.hittingCooldown = false end
            end)
        end
    end)

    if autoBatSetVisual then autoBatSetVisual(true) end
    if mobBtnRefs and mobBtnRefs.autoBat then mobBtnRefs.autoBat(true) end
    if mobBtnRefs and mobBtnRefs.batV2 then mobBtnRefs.batV2(true) end
end


