local Conns = { autoSteal = nil, statusUpdater = nil }

local progressFill = nil
local progressPct = nil
local progressRadLbl = nil
local mainFrame = nil

local function setBar(progress)
    progress = math.clamp(tonumber(progress) or 0, 0, 1)
    if progressFill and progressFill.Parent then
        progressFill.Size = UDim2.new(progress, 0, 1, 0)
    end
    if progressPct and progressPct.Parent then
        progressPct.Text = tostring(math.floor(progress * 100 + 0.5)) .. "%"
    end
end
local function resetBar()
    setBar(0)
end

