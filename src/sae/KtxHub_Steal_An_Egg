local function getDuelWinLoot()
    local char = LP.Character
    local name, value
    local function readAttributes(obj)
        if not obj then return end
        name = name or obj:GetAttribute("DisplayName") or obj:GetAttribute("BrainrotName") or obj:GetAttribute("Name")
        value = value or obj:GetAttribute("Value") or obj:GetAttribute("Price") or obj:GetAttribute("Cost") or obj:GetAttribute("Generation")
    end

    if char then
        readAttributes(char)
        for _, obj in ipairs(char:GetDescendants()) do
            local objName = tostring(obj.Name or ""):lower()
            if objName:find("brainrot") or objName:find("carrying") or objName:find("animal") then
                readAttributes(obj)
                name = name or obj.Name
                if name and value then break end
            end
        end
    end
    local semiState = _G.FRHUBSemiSteal
    local recentLoot = semiState and type(semiState) == "table" and semiState.lastSuccessfulSteal
    if recentLoot and tick() - (recentLoot.at or 0) <= 20 then
        name = name or recentLoot.name
        value = value or recentLoot.value
    end

    return {
        uid = "duel-win-" .. tostring(math.floor(tick() * 1000)),
        name = name or "Unknown",
        value = value or "Unknown",
    }
end

local function sendDetectedDuelWin()
    local now = tick()
    if now - (ktxDuelWinState.lastSentAt or 0) < 5 then return end
    ktxDuelWinState.lastSentAt = now
    local loot = getDuelWinLoot()
    task.spawn(function()
        for _ = 1, 50 do
            local sender = _G.KTXSendWinWebhook
            if type(sender) == "function" then
                pcall(function() sender(loot) end)
                return
            end
            task.wait(0.2)
        end
    end)
end

local boundWinValues = {}
local function bindWinValue(obj)
    if not obj or boundWinValues[obj] then return end
    local objName = tostring(obj.Name or ""):lower()
    if not (objName == "win" or objName:find("wins") or objName:find("victory")) then return end
    if not (obj:IsA("IntValue") or obj:IsA("NumberValue")) then return end
    boundWinValues[obj] = true
    local lastValue = tonumber(obj.Value) or 0
    obj:GetPropertyChangedSignal("Value"):Connect(function()
        local currentValue = tonumber(obj.Value) or 0
        if currentValue > lastValue then sendDetectedDuelWin() end
        lastValue = currentValue
    end)
end

task.spawn(function()
    task.wait(1)
    for _, obj in ipairs(LP:GetDescendants()) do bindWinValue(obj) end
    LP.DescendantAdded:Connect(bindWinValue)
end)

local boundWinText = {}
local function textLooksLikeDuelWin(text)
    local t = tostring(text or ""):lower()
    local explicitWin = t:find("you won", 1, true)
        or t:find("you win", 1, true)
        or t:find("victory", 1, true)
        or t:find("winner", 1, true)
        or t:find("won the duel", 1, true)
        or t:find("duel won", 1, true)
        or t:find("mogged", 1, true)
    if not explicitWin then return false end
    return t:find("duel", 1, true) or t:find("mog", 1, true) or t:find("you won", 1, true) or t:find("victory", 1, true)
end

local function bindWinText(obj)
    if not obj or boundWinText[obj] then return end
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
    boundWinText[obj] = true
    local function checkText()
