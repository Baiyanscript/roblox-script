local antiDropActive = false
local mt_anti = getrawmetatable(game)
local oldIdx_anti, oldNewIdx_anti
local spoofedVelocity = Vector3.zero

local function startAntiDrop()
    if antiDropActive then return end
    if not mt_anti then return end
    if not (getrawmetatable and setreadonly and newcclosure) then return end
    oldIdx_anti = mt_anti.__index
    oldNewIdx_anti = mt_anti.__newindex
    setreadonly(mt_anti, false)
    -- Strong anti-drop: always report zero velocity to the game (from No drop logic)
    mt_anti.__index = newcclosure(function(self, key)
        if not checkcaller() and (key == "AssemblyLinearVelocity" or key == "Velocity") and
           typeof(self) == "Instance" and self:IsA("BasePart") and self.Name == "HumanoidRootPart" and
           LP.Character and self:IsDescendantOf(LP.Character) then
            return Vector3.zero
        end
        return oldIdx_anti(self, key)
    end)
    mt_anti.__newindex = newcclosure(function(self, key, value)
        if not checkcaller() and (key == "AssemblyLinearVelocity" or key == "Velocity") and
           typeof(self) == "Instance" and self:IsA("BasePart") and self.Name == "HumanoidRootPart" and
           LP.Character and self:IsDescendantOf(LP.Character) then
            -- swallow write - prevent game from resetting our LinearVelocity movement
            return
        end
        return oldNewIdx_anti(self, key, value)
    end)
    setreadonly(mt_anti, true)
    antiDropActive = true
    spoofedVelocity = Vector3.zero
end

local function stopAntiDrop()
    if not antiDropActive then return end
    if mt_anti and oldIdx_anti then
        setreadonly(mt_anti, false)
        mt_anti.__index = oldIdx_anti
        mt_anti.__newindex = oldNewIdx_anti
        setreadonly(mt_anti, true)
        oldIdx_anti = nil
        oldNewIdx_anti = nil
    end
    antiDropActive = false
end
