-- Bloody Red theme: push UI colors toward deep blood red tones.
local function applyKTXRedTheme(root)
    if not root then return end
    local function recolor(c)
        local r = math.floor(c.R * 255 + 0.5)
        local g = math.floor(c.G * 255 + 0.5)
        local b = math.floor(c.B * 255 + 0.5)
        local avg = (r + g + b) / 3
        if avg < 30 then
            return Color3.fromRGB(math.min(20, r+5), 0, 0)
        elseif avg > 200 then
            return Color3.fromRGB(220, 20, 30)
        else
            local nr = math.min(255, math.floor(r * 0.9 + 80))
            local ng = math.min(60, math.floor(g * 0.25))
            local nb = math.min(60, math.floor(b * 0.25))
            return Color3.fromRGB(nr, ng, nb)
        end
    end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("UIGradient") then
            local points = {}
            for _, point in ipairs(obj.Color.Keypoints) do
                points[#points + 1] = ColorSequenceKeypoint.new(point.Time, recolor(point.Value))
            end
            obj.Color = ColorSequence.new(points)
        elseif obj:IsA("UIStroke") then
            obj.Color = recolor(obj.Color)
        elseif obj:IsA("GuiObject") then
            obj.BackgroundColor3 = recolor(obj.BackgroundColor3)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                obj.TextColor3 = recolor(obj.TextColor3)
            end
        end
    end
end

