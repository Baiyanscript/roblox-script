-- Instant Grab Logic Functions
local function applyPromptGrab(prompt)
    if prompt:IsA("ProximityPrompt") then
        if InstantGrabEnabled then
            if originalDurations[prompt] == nil then
                originalDurations[prompt] = prompt.HoldDuration
            end
            prompt.HoldDuration = 0.01
        elseif originalDurations[prompt] ~= nil then
            prompt.HoldDuration = originalDurations[prompt]
            originalDurations[prompt] = nil
        end
    end
end

-- Hook existing and future Proximity Prompts
ProximityPromptService.PromptShown:Connect(function(prompt)
    if InstantGrabEnabled then
        applyPromptGrab(prompt)
    end
end)

workspace.DescendantAdded:Connect(function(descendant)
    if InstantGrabEnabled and descendant:IsA("ProximityPrompt") then
        applyPromptGrab(descendant)
    end
end)

instantGrabBtn.MouseButton1Click:Connect(function()
    InstantGrabEnabled = not InstantGrabEnabled
    if InstantGrabEnabled then
        instantGrabBtn.Text = "Instant Grab: ON"
        instantGrabBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
        for _, prompt in ipairs(workspace:GetDescendants()) do
