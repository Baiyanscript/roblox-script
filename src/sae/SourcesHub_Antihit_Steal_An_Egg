-- Continuous Move Loop to bypass 8-second MoveTo timeout
stealBtn.MouseButton1Click:Connect(function()
    if IsStealing then
        IsStealing = false
        stealBtn.Text = "Steal"
        stealBtn.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
        return
    end

    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp or humanoid.Health <= 0 then return end

    IsStealing = true
    stealBtn.Text = "Running..."
    stealBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)

    task.spawn(function()
        while IsStealing do
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if not char or not hum or not root or hum.Health <= 0 then
                break
            end

            -- Flat distance check to stop when arrived
            local currentPos = Vector3.new(root.Position.X, 0, root.Position.Z)
            local targetPos = Vector3.new(StealTargetPos.X, 0, StealTargetPos.Z)
            
            if (currentPos - targetPos).Magnitude <= 3.5 then
                break
            end

            -- Continually command MoveTo to prevent auto-stopping
            hum:MoveTo(StealTargetPos)
            task.wait(0.2)
        end

        IsStealing = false
        stealBtn.Text = "Steal"
        stealBtn.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
    end)
end)

-- Anti-Ragdoll Logic
local function applyHumanoidStateLock(hum)
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, not AntiRagdollEnabled)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not AntiRagdollEnabled)
    end)
end

local function startAntiRagdoll()
    if antiRagdollConn then return end
    antiRagdollConn = RunService.Heartbeat:Connect(function()
        if not AntiRagdollEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                local currentState = hum:GetState()
                if currentState == Enum.HumanoidStateType.Physics
                or currentState == Enum.HumanoidStateType.Ragdoll
                or currentState == Enum.HumanoidStateType.FallingDown then
                    
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.AssemblyLinearVelocity = Vector3.zero
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                    
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
        end
    end)
end

antiRagdollBtn.MouseButton1Click:Connect(function()
    AntiRagdollEnabled = not AntiRagdollEnabled
    
