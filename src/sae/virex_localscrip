	end
	for _, refresh in pairs(Tabs) do refresh(not instant) end
	for n, pg in pairs(Pages) do pg.Visible = (n == name) end
	local pg = Pages[name]
	pg.Position = UDim2.new()
	if not instant then
		pg.Position = UDim2.fromOffset(18, 0)
		tween(pg, { Position = UDim2.new() }, 0.35)
