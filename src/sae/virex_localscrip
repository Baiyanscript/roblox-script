-- Botón con callback preparado:  btn:SetCallback(fn)
local function createButton(parent, def)
	local btn = { Toggle = def.Toggle ~= false, Callback = def.Callback, State = false, Hover = false }
	local frame = make("TextButton", {
		Name = def.Name or "Button",
		Size = UDim2.fromOffset(def.Width or 162, def.Height or 58),
		Text = "", AutoButtonColor = false, ClipsDescendants = true,
		BackgroundColor3 = getColor("Button"),
		LayoutOrder = def.Order or 0,
	}, parent)
	corner(frame, 12)
	local st = stroke(frame, 1.5, nil, 0.8)
	make("UIGradient", { Color = ColorSequence.new(WHITE, Color3.fromRGB(170, 170, 170)), Rotation = 90 }, frame)

	local nameL = label(frame, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -54, 0, 24), Text = def.Name or "", TextXAlignment = Enum.TextXAlignment.Left }, "Text", true)
	sizeCap(nameL, 16)
	local statusL = label(frame, { Position = UDim2.fromOffset(14, 34), Size = UDim2.new(1, -54, 0, 14), TextXAlignment = Enum.TextXAlignment.Left }, nil, false)
	sizeCap(statusL, 11)

	local halo = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -24, 0.5, 0), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1 }, frame)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, halo)
	local led = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -24, 0.5, 0), Size = UDim2.fromOffset(10, 10) }, frame)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, led)

	local function render(animated)
		local col = getColor("Button")
		if btn.State then col = col:Lerp(getColor("Accent"), 0.32) end
		if btn.Hover then col = col:Lerp(WHITE, 0.07) end
		set(frame, { BackgroundColor3 = col }, animated, 0.18)
		set(st, { Color = getColor("Accent"), Transparency = btn.State and 0.1 or (btn.Hover and 0.45 or 0.8) }, animated, 0.18)
		set(led, { BackgroundColor3 = btn.State and getColor("Highlight") or getColor("Sub") }, animated, 0.18)
		set(halo, { BackgroundColor3 = getColor("Glow"), BackgroundTransparency = btn.State and 0.6 or 1 }, animated, 0.18)
		set(statusL, { TextColor3 = btn.State and getColor("Accent") or getColor("Sub") }, animated, 0.18)
		statusL.Text = btn.Toggle and (btn.State and "ACTIVO" or "INACTIVO") or "LISTO"
	end
	onTheme(render)
	addFeedback(frame, function(h)
		btn.Hover = h
		render(true)
	end)

	local function fire()
		if btn.Callback then
			local ok, err = pcall(btn.Callback, btn.State)
			if not ok then warn("[VIREX] Error en '" .. tostring(def.Name) .. "': " .. tostring(err)) end
		end
	end

	frame.Activated:Connect(function(input)
		ripple(frame, input)
		if btn.Toggle then
			btn.State = not btn.State
			render(true)
		else
			tween(st, { Transparency = 0.05 }, 0.08)
			task.delay(0.15, function() render(true) end)
		end
		fire()
	end)

	btn.Instance = frame
	function btn:SetCallback(fn) self.Callback = fn end
	function btn:SetName(text) nameL.Text = text end

-- Slider genérico (dedo + mouse). No mueve la ventana ni el scroll mientras se arrastra.
local function createSlider(parent, opts)
	local min, max = opts.Min, opts.Max
	local alpha = 0
	local holder = make("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Active = true, LayoutOrder = opts.Order or 0 }, parent)
	local reserve = opts.Format and 60 or 0
	local track = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0), Size = UDim2.new(1, -28 - reserve, 0, 10), BackgroundColor3 = WHITE }, holder)
	corner(track, 5)
	local fill, grad
	if opts.Gradient then
		grad = make("UIGradient", { Color = opts.Gradient }, track)
	else
		bind(track, "BackgroundColor3", "Bg")
		fill = make("Frame", { Size = UDim2.fromScale(0, 1) }, track)
		corner(fill, 5)
		bind(fill, "BackgroundColor3", "Accent")
	end
	local knob = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = WHITE, ZIndex = 3 }, track)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, knob)
	local ks = stroke(knob, 3, "Accent", 0)
	local knobScale = make("UIScale", { Scale = 1 }, knob)
	local valueL
	if opts.Format then
		valueL = label(holder, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(56, 20), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right }, "Sub", true)
	end

	local slider = { Gradient = grad }
	local function render(a)
		alpha = a
		knob.Position = UDim2.fromScale(a, 0.5)
		if fill then fill.Size = UDim2.fromScale(a, 1) end
		if valueL then valueL.Text = opts.Format(min + a * (max - min)) end
	end
	function slider.Set(v) render(math.clamp((v - min) / (max - min), 0, 1)) end
	function slider.Get() return min + alpha * (max - min) end
	slider.Set(opts.Value or min)

	local function fromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		render(a)
		if opts.OnChanged then opts.OnChanged(min + a * (max - min)) end
	end

	holder.InputBegan:Connect(function(input)
		if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
		local scroller = holder:FindFirstAncestorOfClass("ScrollingFrame")
		if scroller then scroller.ScrollingEnabled = false end
		tween(knobScale, { Scale = 1.2 }, 0.12, EASE.Back)
		tween(ks, { Thickness = 5 }, 0.12)
		fromX(input.Position.X)
		local moveConn, endConn
		moveConn = UserInputService.InputChanged:Connect(function(i)
			if i == input or (t == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement) then
				fromX(i.Position.X)
			end
		end)
		endConn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				moveConn:Disconnect()
				endConn:Disconnect()
				if scroller then scroller.ScrollingEnabled = true end
				tween(knobScale, { Scale = 1 }, 0.2)
				tween(ks, { Thickness = 3 }, 0.2)
			end
		end)
	end)
	return slider
end

-- Chip seleccionable (temas, fuentes, destino de color)
local function createChip(parent, text, isSelected, onClick, opts, group)
	opts = opts or {}
	local chip = make("TextButton", { Text = "", AutoButtonColor = false, LayoutOrder = opts.Order or 0 }, parent)
	corner(chip, 10)
	local st = stroke(chip, 1.5, nil, 0.8)
	local hasDot = opts.DotColor ~= nil
	local dot
	if hasDot then
		dot = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(12, 12) }, chip)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, dot)
	end
	local l = label(chip, {
		Position = UDim2.fromOffset(hasDot and 28 or 6, 0),
		Size = UDim2.new(1, hasDot and -34 or -12, 1, 0),
		Text = text,
		TextXAlignment = hasDot and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
	}, "Text", true)
	sizeCap(l, 14)
	if opts.Font then
		FontLabels[l] = nil -- este chip muestra siempre su propia fuente
		l.Font = opts.Font
	end
	local function render(animated)
		local sel = isSelected()
		local base = getColor("Button")
		set(chip, { BackgroundColor3 = sel and base:Lerp(getColor("Accent"), 0.3) or base }, animated, 0.2)
		set(st, { Color = getColor("Accent"), Transparency = sel and 0.1 or 0.8 }, animated, 0.2)
		if dot then set(dot, { BackgroundColor3 = opts.DotColor() }, animated, 0.2) end
	end
	onTheme(render)
	if group then table.insert(group, render) end
	addFeedback(chip)
		onClick()
		if group then
			for _, r in ipairs(group) do r(true) end
		end
	end)
	return chip
end

