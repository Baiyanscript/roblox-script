	local holder = make("Frame", { Name = "Intro", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(440, 240), BackgroundTransparency = 1 }, gui)
	local sc = make("UIScale", { Scale = s * 0.82 }, holder)

	local halo2 = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 44, 1, 44), BackgroundColor3 = col("Glow"), BackgroundTransparency = 1 }, holder)
	corner(halo2, 40)
	local halo1 = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 18, 1, 18), BackgroundColor3 = col("Glow"), BackgroundTransparency = 1 }, holder)
	corner(halo1, 30)

	local card = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = col("Bg"), GroupTransparency = 1 }, holder)
	corner(card, 24)
	local border = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, holder)
	corner(border, 24)
	local bst = make("UIStroke", { Thickness = 2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, border)
	spinGradient(bst, false)

	local ambient = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, card)
	startParticles(ambient, 14, function() return alive end, "Glow")

	-- esquinas futuristas
	local brackets = {}
	for _, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
		local ax, ay = c[1], c[2]
		local ox = ax == 0 and 14 or -14
		local oy = ay == 0 and 14 or -14
		for _, dim in ipairs({ { 26, 2 }, { 2, 26 } }) do
			table.insert(brackets, make("Frame", {
				Position = UDim2.new(ax, ox, ay, oy),
				Size = UDim2.fromOffset(dim[1], dim[2]),
				BackgroundColor3 = col("Accent"),
				BackgroundTransparency = 1,
			}, card))
		end
	end

	local logo, logoScale
	if hasLogo then
		logo = make("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 60), Size = UDim2.fromOffset(76, 76), BackgroundTransparency = 1, Image = SETTINGS.LogoId, ImageTransparency = 1, ScaleType = Enum.ScaleType.Fit }, card)
		make("UIAspectRatioConstraint", { AspectRatio = 1 }, logo)
		corner(logo, 16)
		logoScale = make("UIScale", { Scale = 0.5 }, logo)
	end

	local textY = hasLogo and 132 or 92
	local title = label(card, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, textY), Size = UDim2.new(1, 0, 0, 60), Text = SETTINGS.Title, TextSize = 54, TextTransparency = 1 }, nil, true)
	local titleScale = make("UIScale", { Scale = 0.75 }, title)
	shineGradient(title, "Accent", false)

	local subY = textY + 40
	local sub = label(card, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, subY), Size = UDim2.fromOffset(170, 16), Text = "PREMIUM INTERFACE", TextSize = 12, TextTransparency = 1 }, nil, false)
	sub.TextColor3 = col("Sub")
	local lineL = make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0.5, -92, 0, subY), Size = UDim2.fromOffset(0, 2), BackgroundColor3 = col("Accent") }, card)
	make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) }) }, lineL)
	local lineR = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 92, 0, subY), Size = UDim2.fromOffset(0, 2), BackgroundColor3 = col("Accent") }, card)
	make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }) }, lineR)

	local track = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 212), Size = UDim2.fromOffset(200, 4), BackgroundColor3 = col("Button") }, card)
	corner(track, 2)
	local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE }, track)
	corner(fill, 2)
	make("UIGradient", { Color = ColorSequence.new(col("Accent"), col("Glow")) }, fill)

	-- Línea de tiempo
	tween(card, { GroupTransparency = 0 }, 0.5)
	tween(sc, { Scale = s }, 0.75, EASE.Back)
	tween(bst, { Transparency = 0 }, 0.6)
	tween(halo1, { BackgroundTransparency = 0.9 }, 0.8)
	tween(halo2, { BackgroundTransparency = 0.95 }, 1)
	task.delay(1, function()
			TweenService:Create(halo1, TweenInfo.new(0.9, EASE.Sine, DIR.InOut, -1, true), { BackgroundTransparency = 0.8 }):Play()
		end
	end)
	task.wait(0.35)
	if logo then
		tween(logo, { ImageTransparency = 0 }, 0.5)



