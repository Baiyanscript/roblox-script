--==================================================
-- RUN SCRIPT
--==================================================

local function RunScript(Data)

    if not Data or not Data.URL then
        return
    end

    StatusLabel.Text = "LOADING..."

    task.spawn(function()

        local Success, ErrorMessage =
            pcall(function()

                if Data.PreLoad then
                    Data.PreLoad()
                end

                local Source =
                    game:HttpGet(
                        Data.URL
                    )

                local Function =
                    loadstring(Source)

                if not Function then
                    error(
                        "loadstring failed"
                    )
                end

                Function()

            end)

        if Success then

            StatusLabel.Text =
                "LOADED"

        else

            StatusLabel.Text =
                "ERROR"

            warn(
                "[ZERO HUB] "
                .. tostring(ErrorMessage)
            )

        end

    end)

end

