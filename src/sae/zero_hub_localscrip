local function CreateScriptPage(Page)

    ClearContent()

    local Data =
        ScriptData[Page]

    if not Data then
        return
    end

    local function SectionTitle(Text)

        local Label =
            Instance.new("TextLabel")

        Label.Size =
            UDim2.new(
                1,
                -4,
                0,
                23
            )

        Label.BackgroundTransparency = 1

        Label.Text = Text

        Label.TextColor3 =
            AccentBright

        Label.Font =
            Enum.Font.GothamBold

        Label.TextSize = 8

        Label.TextXAlignment =
            Enum.TextXAlignment.Left

        Label.ZIndex = 23
        Label.Parent = Content

    end

    SectionTitle("NO KEY")

    for _, Script in ipairs(
        Data["NO KEY"] or {}
    ) do

        CreateCard(
            Script,
            "NO KEY"
        )

    end

    if #(Data["KEY"] or {}) > 0 then

        SectionTitle("KEY")

        for _, Script in ipairs(
            Data["KEY"]
        ) do

            CreateCard(
                Script,
                "KEY"
            )

        end

    end

end

