-- PAGE SWITCH
--==================================================

local function SetPage(Page)

    CurrentPage = Page

    for _, Button in ipairs(
        NavButtons
    ) do

        if Button.Text == Page then

            Button.BackgroundColor3 =
                Accent

            Button.TextColor3 =
                Color3.new(
                    1,
                    1,
                    1
                )

        else

            Button.BackgroundColor3 =
                Color3.fromRGB(
                    8,
                    15,
                    32
                )

            Button.TextColor3 =
                Color3.fromRGB(
                    160,
                    180,
                    220
                )

        end

    end

    if Page == "MAIN" then

        CreateMain()

    else

        CreateScriptPage(Page)

    end

    SearchBox.Text = ""
    StatusLabel.Text = "READY"

end

