local fn12

fn12 = function(arg)
	local n = tonumber(arg) or 0
	local str = n < 0 and "-" or ""
	local n2 = math.abs(n)

	for _, v in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1000000, "M" }, { 1000, "k" } }) do
		if n2 >= v[1] then
			local str2 = string.format("%.1f", n2 / v[1])

			if str2:sub(-2) == ".0" then
				str2 = str2:sub(1, -3)
			end

			return str .. str2 .. v[2]
		end
	end

	return str .. tostring(math.floor(n2))
end

