local function saveOriginalOutfit(char)
    if not char then return end
    local shirt = char:FindFirstChildWhichIsA("Shirt")
    local pants = char:FindFirstChildWhichIsA("Pants")
    originalOutfit.shirt = shirt and shirt.ShirtTemplate or nil
    originalOutfit.pants = pants and pants.PantsTemplate or nil
end

local function restoreOriginalOutfit(char)
    if not char then return end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") then obj:Destroy() end
    end
    if originalOutfit.shirt then
        local newShirt = Instance.new("Shirt")
        newShirt.ShirtTemplate = originalOutfit.shirt
        newShirt.Parent = char
    end
    if originalOutfit.pants then
        local newPants = Instance.new("Pants")
        newPants.PantsTemplate = originalOutfit.pants
        newPants.Parent = char
    end
    originalOutfit.shirt = nil
    originalOutfit.pants = nil
end

local function saveOriginalAccessories(char)
    originalAccessories = {}
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Hat") then
            local ok, clone = pcall(function() return child:Clone() end)
            if ok and clone then table.insert(originalAccessories, clone) end
        end
    end
end

local function restoreOriginalAccessories(char)
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Hat") or child.Name == "AuFfitAccessory"
            or child.Name:find("Korblox_") or child.Name:find("Headless_") then
            child:Destroy()
        end
    end
    for _, clone in ipairs(originalAccessories) do
        if clone and clone.Parent == nil then
            pcall(function() clone:Clone().Parent = char end)
        end
    end
    originalAccessories = {}
end

local function clearAllOutfit(char)
    if not char then return end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") then obj:Destroy() end
    end
end

local function clearAllAccessories(char)
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Hat") or child.Name == "AuFfitAccessory"
            or child.Name:find("Korblox_") or child.Name:find("Headless_") then
            child:Destroy()
        end
