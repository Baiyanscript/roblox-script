local isOpen = true
local animating = false
local panelOpenPos = Panel.Position
local panelClosedPos = UDim2.new(0, -270, panelOpenPos.Y.Scale, panelOpenPos.Y.Offset)

local function setOpen(state)
    if animating or isOpen == state then return end
    isOpen = state
    animating = true

    if state then
        Panel.Visible = true
        Panel.Position = panelClosedPos
        toggleBtn.Text = "×"
        TweenService:Create(Panel, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = panelOpenPos
        }):Play()
        task.delay(0.3, function() animating = false end)
    else
        toggleBtn.Text = "SAE"
        local tw = TweenService:Create(Panel, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = panelClosedPos
        })
        tw:Play()
        task.delay(0.25, function()
            if not isOpen then Panel.Visible = false end
            animating = false
        end)
    end
end

-- Important: close button ONLY closes; SAE button ONLY opens.
closeBtn.MouseButton1Click:Connect(function()
    if isOpen then setOpen(false) end
end)

toggleBtn.MouseButton1Click:Connect(function()
    if not isOpen then setOpen(true) end
end)

-- Hover feedback
