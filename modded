local function CreateScriptButton(i, entry)
    local row = math.floor((i - 1) / 2)  -- 0..4
    local col = (i - 1) % 2              -- 0 or 1

    local btn = Instance.new("TextButton")
    btn.Name = "Script" .. i
    btn.Size = UDim2.new(0, 120, 0, 32)
    btn.Position = UDim2.new(0, col == 0 and 4 or 128, 0, row * 38 + 4)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    btn.BorderColor3 = Red
    btn.BorderSizePixel = 1
    btn.Text = entry.name
    btn.TextColor3 = White
    btn.TextSize = 12
    btn.Font = Enum.Font.Gotham
    btn.Parent = ScriptsFrame

    btn.MouseButton1Click:Connect(function()
        local code = entry.code
        if not code or code == "" or code:find("%-%- paste your script here") then
            btn.Text = "No script"
            task.wait(1)
            btn.Text = entry.name
            return
        end

        local ok = pcall(function()
            loadstring(code)()
        end)

        btn.Text = ok and "Loaded ✓" or "Failed ✗"
        task.wait(1)
        btn.Text = entry.name
    end)
end

for i, entry in ipairs(ScriptList) do
    CreateScriptButton(i, entry)
end

