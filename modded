-- ============================================================
-- Drag system — clamped so it can NEVER go off-screen,
-- and it ignores clicks on the close button.
-- ============================================================
local function MakeDraggable(dragBar, target, ignoreTarget)
    local dragging = false
    local dragInput
    local dragStart
    local startPos

    local function IsOverGui(mousePos, gui)
        local ab = gui.AbsolutePosition
        local as = gui.AbsoluteSize
        return mousePos.X >= ab.X and mousePos.X <= ab.X + as.X
           and mousePos.Y >= ab.Y and mousePos.Y <= ab.Y + as.Y
    end

    local function Update(input)
        local delta = input.Position - dragStart
        local viewport = workspace.CurrentCamera.ViewportSize

        -- compute the new position mathematically, then clamp it
        local x = startPos.X.Scale * viewport.X + startPos.X.Offset + delta.X
        local y = startPos.Y.Scale * viewport.Y + startPos.Y.Offset + delta.Y
        x = math.clamp(x, 0, math.max(0, viewport.X - target.Size.X.Offset))
        y = math.clamp(y, 0, math.max(0, viewport.Y - target.Size.Y.Offset))

        target.Position = UDim2.fromOffset(x, y)
    end

    dragBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            -- don't start dragging when the press is on the close button
            if ignoreTarget and IsOverGui(UserInputService:GetMouseLocation(), ignoreTarget) then
                return
            end

            dragging = true
            dragStart = input.Position
            startPos = target.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.Ended then
                    dragging = false
                    dragInput = nil
                end
            end)
        end
    end)

    dragBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            Update(input)
        end
    end)
end

MakeDraggable(TitleBar, Main, CloseBtn)   -- drag by title bar; X button is safe
MakeDraggable(OpenBtn, OpenBtn)           -- open button also draggable
