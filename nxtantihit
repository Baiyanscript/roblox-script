-- Desync / Anti-Hit Bypass Logic
local function executeAntiHitBypass()
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    if not Humanoid or not HumanoidRootPart then return end

    local originalHRPPos = HumanoidRootPart.CFrame
    local originalCamCFrame = CurrentCamera.CFrame
    local originalCamType = CurrentCamera.CameraType

    -- Create local visual dummy clone
    local isArchivable = Character.Archivable
    Character.Archivable = true
    local clone = Character:Clone()
    Character.Archivable = isArchivable

    if clone then
        for _, descendant in ipairs(clone:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
            elseif descendant:IsA("LocalScript") or descendant:IsA("Script") then
                descendant:Destroy()
            end
        end
        clone.Parent = Workspace
    end

    CurrentCamera.CameraType = Enum.CameraType.Scriptable
    CurrentCamera.CFrame = originalCamCFrame
    Humanoid.BreakJointsOnDeath = false

    -- Hide visual parts temporarily
    local savedStates = {}
    for _, descendant in ipairs(Character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            savedStates[descendant] = { LTM = descendant.LocalTransparencyModifier }
            descendant.LocalTransparencyModifier = 1
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
            savedStates[descendant] = { T = descendant.Transparency }
            descendant.Transparency = 1
        elseif descendant:IsA("Trail") or descendant:IsA("ParticleEmitter") or descendant:IsA("Beam") 
            or descendant:IsA("Highlight") or descendant:IsA("Light") 
            or descendant:IsA("BillboardGui") or descendant:IsA("SurfaceGui") then
            savedStates[descendant] = { E = descendant.Enabled }
            descendant.Enabled = false
        elseif descendant:IsA("Motor6D") then
            descendant.Enabled = true
        end
    end

    -- Fast-teleport through bypass coordinates
    for _, cf in ipairs(teleportLocations) do
        Humanoid.PlatformStand = true
        Humanoid.Health = 100
        HumanoidRootPart.CFrame = cf
        CurrentCamera.CFrame = originalCamCFrame
        task.wait(0.02)
    end

    for _ = 1, 15 do
        Humanoid.Health = 100
        Humanoid.PlatformStand = true
        HumanoidRootPart.CFrame = teleportLocations[#teleportLocations]
        CurrentCamera.CFrame = originalCamCFrame
        task.wait(0.01)
    end

    -- Restore original position and visuals
    HumanoidRootPart.CFrame = originalHRPPos
    Humanoid.PlatformStand = false

    for item, state in pairs(savedStates) do
        if item and item.Parent then
            if state.LTM then item.LocalTransparencyModifier = state.LTM end
            if state.T then item.Transparency = state.T end
            if state.E ~= nil then item.Enabled = state.E end
        end
    end

    if clone then clone:Destroy() end
    CurrentCamera.CameraType = originalCamType
end

-- Connection Garbage Collection
local function cleanupConnections()
    for prompt, conns in pairs(activeConnections) do
        if not prompt or not prompt.Parent then
            if conns then
                for _, conn in ipairs(conns) do
                    if conn then conn:Disconnect() end
                end
            end
            activeConnections[prompt] = nil
        end
    end
end

task.spawn(function()
    while task.wait(30) do
        cleanupConnections()
    end
end)

-- Instant Hold Setup for Proximity Prompts
local function setupPrompt(prompt)
    if not prompt or typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") then
        return
    end

    prompt.HoldDuration = 0

    if not activeConnections[prompt] then
        local holdConn = prompt:GetPropertyChangedSignal("HoldDuration"):Connect(function()
            if antiHitEnabled and prompt and prompt.Parent and prompt.HoldDuration > 0 then
                prompt.HoldDuration = 0
            end
        end)
        
        local destroyConn = prompt.Destroying:Connect(function()
            if activeConnections[prompt] then
                for _, conn in ipairs(activeConnections[prompt]) do
                    if conn then conn:Disconnect() end
                end
                activeConnections[prompt] = nil
            end
        end)

        activeConnections[prompt] = { holdConn, destroyConn }
    end
end

-- Clipboard Copy Function
local function copyToClipboard(text, parentFrame)
    pcall(function()
        if setclipboard then setclipboard(text)
        elseif toclipboard then toclipboard(text) end
    end)

    if parentFrame then
        local TextBox = Instance.new("TextBox")
        TextBox.Size = UDim2.new(1, 0, 0, 20)
        TextBox.Position = UDim2.new(0, 0, 1, 5)
        TextBox.Text = text
        TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
        TextBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        TextBox.BorderSizePixel = 0
        TextBox.ClearTextOnFocus = false
        TextBox.ZIndex = 10
        TextBox.Parent = parentFrame
        TextBox:CaptureFocus()
        TextBox:SelectionStart(1)
        TextBox:CursorPosition(#text + 1)

        task.delay(5, function()
            if TextBox and TextBox.Parent then
                TextBox:Destroy()
            end
        end)
    end
end

