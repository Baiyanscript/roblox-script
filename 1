function yeet(targetPlayer)
    local character = localPlayer.Character
    local targetCharacter = targetPlayer.Character
    if not character or not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then return end
    getgenv().OldPos = character.HumanoidRootPart.CFrame
    local Thrust = Instance.new('BodyThrust', character.HumanoidRootPart)
    Thrust.Force = Vector3.new(9999, 9999, 9999)
    local previousDestroyHeight = workspace.FallenPartsDestroyHeight
    workspace.FallenPartsDestroyHeight = 0/0
    local startTime = tick()
    repeat
        RunService.Heartbeat:Wait()
        if targetCharacter:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.CFrame = targetCharacter.HumanoidRootPart.CFrame
        end
    until not flingActive or tick() > startTime + 1.5
    Thrust:Destroy() character.HumanoidRootPart.CFrame = getgenv().OldPos
    workspace.FallenPartsDestroyHeight = previousDestroyHeight
end

function getPlayers(input)
    local out = {} input = string.lower(input or "")
    if input == "all" then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= localPlayer then table.insert(out, p) end end
    elseif input == "nonfriends" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                local s, f = pcall(function() return p:IsFriendsWith(localPlayer.UserId) end)
                if not (s and f) then table.insert(out, p) end
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and (string.find(string.lower(p.Name), input) or string.find(string.lower(p.DisplayName or ""), input)) then
                table.insert(out, p)
            end
        end
    end
    return out
end

function flingPlayers()
    while flingActive do
        local targets = getPlayers(currentInput)
        if #targets == 0 then statusLabel.Text = "Status: No players found!" flingActive = false break end
        for _, p in ipairs(targets) do
            if not flingActive then break end
            if p.Character and p.Character.Parent then
                statusLabel.Text = "Status: Flinging " .. p.Name
                if flingMode == 1 then SkidFling(p, 1.5) elseif flingMode == 2 then shhhlol(p) elseif flingMode == 3 then yeet(p) end
            end
        end
        task.wait()
    end
    toggleBtnMain.Text = "Fling Players: OFF"
    toggleBtnMain.BackgroundColor3 = Themes[CurrentTheme].Button
end

