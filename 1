-- ==================== 高穩定動態比例 ESP 核心系統 ====================
local function CleanPlayerESP(plr)
    if ESP_Cache[plr] then
        pcall(function() ESP_Cache[plr].Box:Destroy() end)
        pcall(function() ESP_Cache[plr].NameLbl:Destroy() end)
        ESP_Cache[plr] = nil
    end
end

local function CreateESP(plr)
    if plr == LocalPlayer then return end
    CleanPlayerESP(plr) -- 徹底清理防止重疊殘留

    -- 參考 FE V11 的完美框框架構
    local box = Instance.new("Frame", CoreGui)
    box.BackgroundTransparency = 1
    box.Visible = false
    
    local stroke = Instance.new("UIStroke", box)
    stroke.Thickness = 1.5
    
    -- 參考 FE V11 的文字架構
    local nameLbl = Instance.new("TextLabel", CoreGui)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 13
    nameLbl.TextStrokeTransparency = 0 
    nameLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLbl.Visible = false

    ESP_Cache[plr] = { Box = box, Stroke = stroke, NameLbl = nameLbl }
end

local function MonitorPlayer(plr)
    if plr == LocalPlayer then return end
    CreateESP(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.3) -- 等待物理完全載入
        CreateESP(plr)
    end)
end

-- 初始化現有玩家
for _, plr in ipairs(Players:GetPlayers()) do MonitorPlayer(plr) end
Players.PlayerAdded:Connect(MonitorPlayer)
Players.PlayerRemoving:Connect(CleanPlayerESP)

-- ==================== FOV 圆圈 (完全固定於屏幕正中央) ====================
local FovCircle = Drawing.new("Circle")
FovCircle.Visible = _G.Config.FOVCircle
FovCircle.Radius = _G.Config.FOVSize
FovCircle.Color = Color3.fromRGB(255, 255, 255)
FovCircle.Thickness = 1
FovCircle.Filled = false
FovCircle.NumSides = 64

local function GetScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

-- ==================== 获取 FOV 内最近玩家 ====================
local function GetClosestPlayer()
    local closest = nil
    local minDist = _G.Config.FOVSize
    local centerPos = GetScreenCenter()
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then continue end
            
            local char = plr.Character
            if not char then continue end
            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not root or not humanoid or humanoid.Health <= 0 then continue end
            
            local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
            if not onScreen then continue end
            
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
            if dist < minDist then
                minDist = dist
                closest = plr
            end
        end
    end
    return closest
end

-- ==================== 每帧渲染主循环 (融合動態演算法) ====================
RunService.RenderStepped:Connect(function()
    -- 更新 FOV 圈：保持絕對居中，半徑完全交由 UI 滑塊控制
    local screenCenter = GetScreenCenter()
    FovCircle.Position = screenCenter
    FovCircle.Radius = _G.Config.FOVSize
    FovCircle.Visible = _G.Config.FOVCircle

    -- 融合 FE V11 渲染邏輯
    for plr, data do
        if not plr or not Players:FindFirstChild(plr.Name) then
            CleanPlayerESP(plr)
            continue
        end

        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        local isAlive = hrp and (hum == nil or hum.Health > 0)
        local isTeammate = (plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team)
        local shouldShow = _G.Config.ESP and isAlive and (not _G.Config.TeamCheck or not isTeammate)

        if shouldShow then
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                -- 核心精準縮放：計算 3D 空間中的頭頂與腳底，完美轉換為 2D 尺寸
                local topPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.3, 0))
                local bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.1, 0))
                
                local height = math.abs(bottomPos.Y - topPos.Y)
                local width = height / 1.7 -- 完全包裹角色的 Hitbox 黃金比例
                local color = plr.TeamColor.Color

                -- 框框渲染
                data.Box.Visible = true
                data.Box.Size = UDim2.new(0, width, 0, height)
                data.Box.Position = UDim2.new(0, pos.X - (width / 2), 0, topPos.Y)
                data.Stroke.Color = color

                -- 名字與距離渲染 (直接整合，省去不必要的運算)
                local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
                data.NameLbl.Visible = true
                data.NameLbl.Position = UDim2.new(0, pos.X, 0, topPos.Y - 15)
                data.NameLbl.TextColor3 = color
                data.NameLbl.Text = plr.Name .. " [" .. dist .. "s]"
            else
                data.Box.Visible = false
                data.NameLbl.Visible = false
            end
        else
            data.Box.Visible = false
            data.NameLbl.Visible = false
        end
    end

    -- 自瞄鎖定邏輯
    if Holding and _G.Config.Aimbot then
        local target = GetClosestPlayer()
        if target and target.Character then
            local aimPart = target.Character:FindFirstChild(_G.Config.AimPart)
            if aimPart then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, aimPart.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, _G.Config.Sensitivity)
            end
        end
    end
end)

-- ==================== 安全輸入監聽 ====================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Holding = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Holding = false end
end)

