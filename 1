local function cleanPart(part, char)

    if not AntiSlap then return end

    if part:IsA("BodyVelocity") or part:IsA("BodyGyro") or part:IsA("BodyAngularVelocity") then

        part:Destroy()

    elseif part:IsA("BasePart") and not part:FindFirstChild("__FlingProtected") then

        local marker = Instance.new("BoolValue")

        marker.Name = "__FlingProtected"

        marker.Parent = part

        part.ChildAdded:Connect(function(child)

            cleanPart(child, char)

        end)

    end

    if char and char:FindFirstChild("Humanoid") then

        char.Humanoid.Sit = false

        char.Humanoid.PlatformStand = false

    end

end

local function monitorChar(char)

    for _, obj in pairs(char:GetDescendants()) do

        cleanPart(obj, char)

    end

    char.ChildAdded:Connect(function(obj)

        cleanPart(obj, char)

    end)

end

antiBtn.MouseButton1Click:Connect(function()

    AntiSlap = not AntiSlap

    antiBtn.Text = AntiSlap and "Anti-Fling/Slap: ON" or "Anti-Fling/Slap: OFF"

    if LocalPlayer.Character then monitorChar(LocalPlayer.Character) end

end)

LocalPlayer.CharacterAdded:Connect(monitorChar)

local function getGlove()

    for _, p in pairs(Players:GetPlayers()) do

        for _, t in pairs(p.Character and p.Character:GetChildren() or {}) do

            if t:IsA("Tool") and t:FindFirstChild("Event") and t:FindFirstChild("Power") then

                return t, t.Event

            end

        end

        for _, t in pairs(p:FindFirstChild("Backpack") and p.Backpack:GetChildren() or {}) do

            if t:IsA("Tool") and t:FindFirstChild("Event") and t:FindFirstChild("Power") then

                return t, t.Event

            end

        end

    end

    return nil, nil

end

