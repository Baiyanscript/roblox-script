local R15_BONES = {
	{"Head","UpperTorso"},
	{"UpperTorso","LowerTorso"},
	{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
	{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
	{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
	{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}

local R6_BONES = {
	{"Head","Torso"},
	{"Torso","Left Arm"},
	{"Torso","Right Arm"},
	{"Torso","Left Leg"},
	{"Torso","Right Leg"},
}

local function getRig(char)
	if char:FindFirstChild("UpperTorso") then return "R15"
	elseif char:FindFirstChild("Torso") then return "R6"
	end
	return nil
end

local function getBonesForRig(char)
	local rig = getRig(char)
	if rig == "R15" then return R15_BONES
	elseif rig == "R6" then return R6_BONES
	end
	return {}
end

local function getHeadAndFeet(char)
	local head = char:FindFirstChild("Head")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not head or not root then return nil, nil end
	local headTop = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
	local feetPos
	local rig = getRig(char)
	if rig == "R15" then
		local lf = char:FindFirstChild("LeftFoot")
		local rf = char:FindFirstChild("RightFoot")
		if lf and rf then
			feetPos = Vector3.new(root.Position.X, math.min(lf.Position.Y, rf.Position.Y) - lf.Size.Y / 2, root.Position.Z)
		else
			feetPos = root.Position - Vector3.new(0, 3, 0)
		end
	else
		local ll = char:FindFirstChild("Left Leg")
		local rl = char:FindFirstChild("Right Leg")
		if ll and rl then
			feetPos = Vector3.new(root.Position.X, math.min(ll.Position.Y, rl.Position.Y) - ll.Size.Y / 2, root.Position.Z)
		else
			feetPos = root.Position - Vector3.new(0, 3, 0)
		end
	end
	return headTop, feetPos
end

local function worldToScreen(pos)
	local sp, on = Camera:WorldToViewportPoint(pos)
	return Vector2.new(sp.X, sp.Y), on
end

local function getPartFromName(char, partName)
	if partName == "Random" then
		local rig = getRig(char)
		local parts = rig == "R15" and {"Head","UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"} or {"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg"}
		return char:FindFirstChild(parts[math.random(1, #parts)])
	elseif partName == "Closet" then
		return char:FindFirstChild("Head") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
	end
	return char:FindFirstChild(partName)
end

local function isKeybindActive(kb, mode, toggleState)
	if mode == "Always" then return true end
	if mode == "Toggle" then return toggleState end
	if mode == "Hold" then
		if typeof(kb) == "EnumItem" and kb.EnumType == Enum.KeyCode then
			return UserInputService:IsKeyDown(kb)
		elseif typeof(kb) == "EnumItem" and kb.EnumType == Enum.UserInputType then
			return UserInputService:IsMouseButtonPressed(kb)
		end
	end
	return false
end

local function getClosestPlayer()
	local closest, closestDist = nil, math.huge
	local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and root then
				local sp, on = Camera:WorldToViewportPoint(root.Position)
				if on then
					local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if dist < Settings.Yx.FOV and dist < closestDist then
						closestDist = dist
						closest = plr
					end
				end
			end
		end
	end
	return closest
end

local espObjects = {}

local function clearESP(plr)
	if espObjects[plr] then
		for k, obj in pairs(espObjects[plr]) do
			if k == "skeleton" then
				for _, bone in pairs(obj) do
					pcall(function() bone.line:Remove() end)
				end
			else
				pcall(function() obj:Remove() end)
			end
		end
		espObjects[plr] = nil
	end
end

local function updateESP(plr)
	if not Settings.ps.Enabled then clearESP(plr) return end
	local char = plr.Character
	if not char then clearESP(plr) return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end
	if not espObjects[plr] then espObjects[plr] = {} end
	local objs = espObjects[plr]
	local headTop, feetPos = getHeadAndFeet(char)
	if not headTop or not feetPos then return end
	local headScreen, headOn = worldToScreen(headTop)
	local feetScreen = worldToScreen(feetPos)
	local rootScreen, rootOn = worldToScreen(root.Position)

	if not rootOn then
		for k, obj in pairs(objs) do
			if k == "skeleton" then
				for _, bone in pairs(obj) do pcall(function() bone.line.Visible = false end) end
			else
				pcall(function() if obj.Visible ~= nil then obj.Visible = false end end)
			end
		end
		return
	end

	local height = math.max(1, math.abs(headScreen.Y - feetScreen.Y))
	local width = height * 0.45
	local camDist = (root.Position - Camera.CFrame.Position).Magnitude

	if Settings.ps.Boxes then
		if not objs.box then
			objs.box = Drawing.new("Square")
			objs.box.Color = Color3.fromRGB(255, 50, 50)
			objs.box.Thickness = 1.5
			objs.box.Filled = false
		end
		objs.box.Size = Vector2.new(width, height)
		objs.box.Position = Vector2.new(rootScreen.X - width / 2, headScreen.Y)
		objs.box.Visible = true
	elseif objs.box then objs.box.Visible = false end

	if Settings.ps.Names then
		if not objs.name then
			objs.name = Drawing.new("Text")
			objs.name.Color = Color3.fromRGB(255, 255, 255)
			objs.name.Size = 14
			objs.name.Center = true
			objs.name.Outline = true
			objs.name.Font = Drawing.Fonts.UI
		end
		objs.name.Text = plr.DisplayName
		objs.name.Position = Vector2.new(rootScreen.X, headScreen.Y - 18)
		objs.name.Visible = true
	elseif objs.name then objs.name.Visible = false end

	if Settings.ps.Distance then
		if not objs.dist then
			objs.dist = Drawing.new("Text")
			objs.dist.Color = Color3.fromRGB(180, 180, 180)
			objs.dist.Size = 12
			objs.dist.Center = true
			objs.dist.Outline = true
			objs.dist.Font = Drawing.Fonts.UI
		end
		objs.dist.Text = math.floor(camDist) .. "m"
		objs.dist.Position = Vector2.new(rootScreen.X, feetScreen.Y + 4)
		objs.dist.Visible = true
	elseif objs.dist then objs.dist.Visible = false end

	if Settings.ps.HealthBar then
		if not objs.hpbg then
			objs.hpbg = Drawing.new("Square")
			objs.hpbg.Filled = true
			objs.hpbg.Color = Color3.fromRGB(0, 0, 0)
			objs.hpbg.Transparency = 0.5
		end
		if not objs.hp then
			objs.hp = Drawing.new("Square")
			objs.hp.Filled = true
		end
		local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
		local barX = rootScreen.X - width / 2 - 6
		objs.hpbg.Size = Vector2.new(4, height)
		objs.hpbg.Position = Vector2.new(barX, headScreen.Y)
		objs.hpbg.Visible = true
		objs.hp.Size = Vector2.new(4, height * hpPercent)
		objs.hp.Position = Vector2.new(barX, headScreen.Y + height * (1 - hpPercent))
		objs.hp.Color = Color3.fromRGB(255 * (1 - hpPercent), 255 * hpPercent, 0)
		objs.hp.Visible = true
	elseif objs.hpbg then
		objs.hpbg.Visible = false
		if objs.hp then objs.hp.Visible = false end
	end

	if Settings.ps.Tracers then
		if not objs.tracer then
			objs.tracer = Drawing.new("Line")
			objs.tracer.Color = Color3.fromRGB(255, 50, 50)
			objs.tracer.Thickness = 1
		end
		objs.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
		objs.tracer.To = Vector2.new(rootScreen.X, rootScreen.Y)
		objs.tracer.Visible = true
	elseif objs.tracer then objs.tracer.Visible = false end

	if Settings.ps.Skeleton then
		local bones = getBonesForRig(char)
		if not objs.skeleton then objs.skeleton = {} end
		for i, bone in ipairs(bones) do
			if not objs.skeleton[i] then
				local line = Drawing.new("Line")
				line.Color = Color3.fromRGB(255, 255, 0)
				line.Thickness = 1
				objs.skeleton[i] = {line = line, from = bone[1], to = bone[2]}
			end
			local fromPart = char:FindFirstChild(bone[1])
			local toPart = char:FindFirstChild(bone[2])
			if fromPart and toPart then
				local fromScreen, fromOn = worldToScreen(fromPart.Position)
				local toScreen, toOn = worldToScreen(toPart.Position)
				if fromOn and toOn then
					objs.skeleton[i].line.From = fromScreen
					objs.skeleton[i].line.To = toScreen
					objs.skeleton[i].line.Visible = true
				else
					objs.skeleton[i].line.Visible = false
				end
			end
		end
	elseif objs.skeleton then
		for _, bone in pairs(objs.skeleton) do
			pcall(function() bone.line:Remove() end)
		end
		objs.skeleton = nil
	end
end

local YxActive = false
local btActive = false

RunService.RenderStepped:Connect(function()
	if Settings.Yx.Enabled and isKeybindActive(Settings.Yx.Keybind, Settings.Yx.KeybindMode, YxActive) then
		local plr = getClosestPlayer()
		if plr and plr.Character then
			local part = getPartFromName(plr.Character, Settings.Yx.Part)
			if part then
				local t = 1 / (math.max(0.01, Settings.Yx.Smoothing) * 10 + 1)
				local camCF = Camera.CFrame
				local dir = (part.Position - camCF.Position).Unit
				Camera.CFrame = camCF:Lerp(CFrame.lookAt(camCF.Position, camCF.Position + dir), t)
			end
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			pcall(updateESP, plr)
		end
	end
end)

local triggerbotHolding = false
RunService.Heartbeat:Connect(function()
	if not Settings.bt.Enabled then
		if triggerbotHolding then mouse1release() triggerbotHolding = false end
		return
	end
	if not isKeybindActive(Settings.bt.Keybind, Settings.bt.KeybindMode, btActive) then
		if triggerbotHolding then mouse1release() triggerbotHolding = false end
		return
	end
	local plr = getClosestPlayer()
	if not plr or not plr.Character then
		if triggerbotHolding then mouse1release() triggerbotHolding = false end
		return
	end
	local part = getPartFromName(plr.Character, Settings.bt.Part)
	if not part then return end
	local partScreen, onScreen = worldToScreen(part.Position)
	if not onScreen then
		if triggerbotHolding then mouse1release() triggerbotHolding = false end
		return
	end
	local mousePos = UserInputService:GetMouseLocation()
	local dist2d = (mousePos - partScreen).Magnitude
	if dist2d < 20 then
		if not triggerbotHolding then
			task.wait(Settings.bt.ReactTime)
			mouse1press()
			triggerbotHolding = true
		end
	else
		if triggerbotHolding then
			task.wait(Settings.bt.ReleaseTime)
			mouse1release()
			triggerbotHolding = false
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if Settings.Yx.KeybindMode == "Toggle" then
		if typeof(Settings.Yx.Keybind) == "EnumItem" and Settings.Yx.Keybind.EnumType == Enum.KeyCode then
			if input.KeyCode == Settings.Yx.Keybind then YxActive = not YxActive end
		end
	end
	if Settings.bt.KeybindMode == "Toggle" then
		if typeof(Settings.bt.Keybind) == "EnumItem" and Settings.bt.Keybind.EnumType == Enum.KeyCode then
			if input.KeyCode == Settings.bt.Keybind then btActive = not btActive end
		end
	end
	if input.KeyCode == Enum.KeyCode.RightControl then
		local sg = CoreGui:FindFirstChild("YxHub")
		if sg then sg.Enabled = not sg.Enabled end
	end
end)

