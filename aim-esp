local function playMusic()
	pcall(function()
		if musicSound then musicSound:Stop() musicSound:Destroy() musicSound = nil end
		local path = CONFIG_FOLDER .. "/music.mp3"
		local asset = getcustomasset(path)
		musicSound = Instance.new("Sound")
		musicSound.SoundId = asset
		musicSound.Volume = Settings.music.Volume
		musicSound.Looped = true
		musicSound.Parent = workspace
		musicSound:Play()
		Settings.music.Playing = true
	end)
end

