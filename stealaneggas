        MainFrame.Visible = false
        MiniBtn.Visible = true
    end)

    MiniBtn.MouseButton1Click:Connect(function()
        -- 重新點擊「AS」時強制重置視窗為正中間
        MainFrame.Position = UDim2.new(0.5, -150, 0.5, -75)
        MiniBtn.Visible = false
        MainFrame.Visible = true
    end)

    --------------------------------------------------
    -- 套用門檻
    --------------------------------------------------

    local SellUnder = ParseNumber(getgenv().SellConfig.SellUnder)

    Apply.MouseButton1Click:Connect(function()
        local text = Input.Text
        local value = ParseNumber(text)

        if value <= 0 then
            Input.Text = ""
            Input.PlaceholderText = "請輸入有效數值，例如 400M"
            return
        end

        getgenv().SellConfig.SellUnder = text
        SellUnder = value
        Apply.Text = "已套用"

        task.delay(1, function()
            if Apply then
                Apply.Text = "套用"
            end
        end)

        print("[AutoSell] Sell under:", SellUnder)
    end)

    --------------------------------------------------
    -- 自動出售循環
    --------------------------------------------------

    task.spawn(function()
        while true do
            task.wait(1)
            pcall(function()
                self.data = self.Save.Get()
                if not self.data then return end

                self.inv = self.data.EggInventory
                if not self.inv then return end

                for Uid, eggdata in next, self.inv do
                    if type(eggdata) ~= "table" then continue end
                    if eggdata.Placement then continue end

                    local category = eggdata.AssetCategory or eggdata.Category
                    local cfg = category and self.Assets.Directory[category] or nil

                    local earn = self:GetKiraEarn(eggdata, cfg)

                    if earn < SellUnder then
                        self["RF/EggWorld/AskWearTool"]:InvokeServer(Uid)
                        self["RE/PetSatchel/SellPet"]:FireServer({ Uid })
                        task.wait(0.1)
                    end
                end
            end)
        end
    end)

    warn("Auto Sell GUI Loaded | Current threshold:", SellUnder)
end

utility:init()
