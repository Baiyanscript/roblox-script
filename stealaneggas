    --------------------------------------------------
    -- 拖曳與介面邏輯
    --------------------------------------------------
    local function MakeDraggable(frame)
        local dragging, dragInput, dragStart, startPos
        frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        frame.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    MakeDraggable(MainFrame)
    MakeDraggable(MiniBtn)

    MinimizeBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
        MiniBtn.Visible = true
    end)

    MiniBtn.MouseButton1Click:Connect(function()
        MainFrame.Position = UDim2.new(0.5, -160, 0.5, -80)
        MiniBtn.Visible = false
        MainFrame.Visible = true
    end)

    --------------------------------------------------
    -- 設定套用
    --------------------------------------------------
    local SellUnderParsed = ParseNumber(getgenv().SellConfig.SellUnder)

    Apply.MouseButton1Click:Connect(function()
        local text = Input.Text
        local value = ParseNumber(text)

        if value <= 0 then
            Input.Text = ""
            Input.PlaceholderText = "請輸入有效數字 (例如: 200M)"
            return
        end

        getgenv().SellConfig.SellUnder = text
        SellUnderParsed = value
        Apply.Text = "已套用！"

        task.delay(1, function()
            if Apply then Apply.Text = "套用設定" end
        end)
    end)

    ToggleBtn.MouseButton1Click:Connect(function()
        getgenv().SellConfig.Enabled = not getgenv().SellConfig.Enabled
        ToggleBtn.Text = getgenv().SellConfig.Enabled and "狀態: 開" or "狀態: 關"
        ToggleBtn.BackgroundColor3 = getgenv().SellConfig.Enabled and Color3.fromRGB(40, 120, 200) or Color3.fromRGB(120, 40, 40)
    end)

    --------------------------------------------------
    -- 自動出售主循環 (包含小數點與容錯計算)
    --------------------------------------------------
    task.spawn(function()
        while true do
            task.wait(1)
            if getgenv().SellConfig.Enabled then
                pcall(function()
                    local data = self.Save.Get()
                    if not (data and data.EggInventory) then return end

                    for Uid, eggdata in pairs(data.EggInventory) do
                        if type(eggdata) == "table" and not eggdata.Placement then
                            local category = eggdata.AssetCategory or eggdata.Category
                            local cfg = category and self.Assets.Directory and self.Assets.Directory[category] or nil

                            local earn = self:CalculateEarn(eggdata, cfg)

                            -- 使用微小緩衝 (Buffer +1) 解決小數點四捨五入誤差
                            if (earn + 1) <= SellUnderParsed then
                                self.AskWearTool:InvokeServer(Uid)
                                self.SellPet:FireServer({ Uid })
                                task.wait(0.15)
                            end
                        end
                    end
                end)
            end
        end
    end)

    warn("[AutoSell PRO] Initialized. Target Threshold:", SellUnderParsed)
end

AutoSellPro:Init()
