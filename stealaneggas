local utility = {
    ReplicatedStorage = game:GetService("ReplicatedStorage")
}

getgenv().SellConfig = getgenv().SellConfig or {
    SellUnder = "400M"
}

function utility:init()

    self.Shared = self.ReplicatedStorage:FindFirstChild("Shared")
    if not self.Shared then
        return warn("failed to get Shared")
    end

    self.Data = self.ReplicatedStorage:FindFirstChild("Data")
    if not self.Data then
        return warn("failed to get Data")
    end

    self.Save = require(self.Shared:FindFirstChild("Save"))
    self.Assets = require(self.Data:FindFirstChild("Assets"))

    self.Packages = self.ReplicatedStorage:FindFirstChild("Packages")
    if not self.Packages then
        return warn("failed to get Packages")
    end

    self.Networking = self.Packages:FindFirstChild("Networking")
    if not self.Networking then
        return warn("failed to get Networking")
    end

    self["RF/EggWorld/AskWearTool"] =
        self.Networking:FindFirstChild("RF/EggWorld/AskWearTool")

    self["RE/PetSatchel/SellPet"] =
        self.Networking:FindFirstChild("RE/PetSatchel/SellPet")

    if not self["RF/EggWorld/AskWearTool"] then
        return warn("failed to get AskWearTool")
    end

    if not self["RE/PetSatchel/SellPet"] then
        return warn("failed to get SellPet")
    end

    -- KiraHub 使用的 Earnings 模組
    self.AssetEarnings = require(
        self.Shared:FindFirstChild("Util")
            :FindFirstChild("AssetEarnings")
    )

    self.Mutations = require(
        self.Shared:FindFirstChild("Modules")
            :FindFirstChild("Mutations")
    )

    --------------------------------------------------
    -- 數字解析
    --------------------------------------------------

    local function ParseNumber(value)
        value = tostring(value or "")
            :gsub(",", "")
            :gsub("%s+", "")
            :lower()

        local number = tonumber(
            value:match("^[%+%-]?[%d%.]+")
        )

        if not number then
            return 0
        end

        if value:find("b") then
            number = number * 1e9
        elseif value:find("m") then
            number = number * 1e6
        elseif value:find("k") then
            number = number * 1e3
        end

        return number
    end

    --------------------------------------------------
    -- KiraHub Earnings 計算
    --------------------------------------------------

    function self:GetKiraEarn(egg, cfg)
        if type(egg) ~= "table" then
            return 0
        end

        local mps = tonumber(egg.MoneyPerSecond)
        if mps and mps > 0 then
            return mps
        end

        local itemData = egg.ItemData
        if type(itemData) == "table" then
            local mps2 = tonumber(itemData.MoneyPerSecond)
            if mps2 and mps2 > 0 then
                return mps2
            end

            if type(itemData.Category) == "string"
                and tonumber(itemData.Scale) then

                local ok, result = pcall(function()
                    return self.AssetEarnings:
                        MutationOnlyRatePerSecond(itemData)
                end)

                if ok and tonumber(result) then
                    return tonumber(result)
                end
            end
        end

        local baseEarn = 0
        if type(cfg) == "table" then
            baseEarn = tonumber(cfg.EarningRate) or 0
        end

        local category = egg.AssetCategory or egg.Category
        local mutations = {}

        if type(egg.Mutations) == "table" then
            mutations = egg.Mutations
        elseif type(itemData) == "table"
            and type(itemData.Mutations) == "table" then
            mutations = itemData.Mutations
        end

        local scale = tonumber(egg.Scale)
        if (not scale or scale <= 0) and type(itemData) == "table" then
            scale = tonumber(itemData.Scale)
        end

        if not scale or scale <= 0 then
            local weight = tonumber(egg.Weight)
                or tonumber(egg.Kg)
                or tonumber(egg.ModelWeight)

            local modelWeight = type(cfg) == "table"
                and tonumber(cfg.ModelWeight)
                or nil

            if weight and weight > 0
                and modelWeight
                and modelWeight > 0 then
                scale = (weight / modelWeight) ^ (1 / 3)
            else
                scale = 1
            end
        end

        if type(category) == "string" then
            local ok, result = pcall(function()
                return self.AssetEarnings:
                    MutationOnlyRatePerSecond({
                        Category = category,
                        Mutations = mutations,
                        Scale = scale
                    })
            end)

            if ok and tonumber(result) then
                return tonumber(result)
            end
        end

        local scaleMultiplier
        if scale <= 5 then
            scaleMultiplier = scale ^ 1.85
        else
            scaleMultiplier = (scale / 5) ^ 1.2 * 19.637875755794
        end

        local mutationMultiplier = 1
        pcall(function()
            mutationMultiplier = self.Mutations:EarningsFor(mutations)
        end)

        mutationMultiplier = tonumber(mutationMultiplier) or 1
        local earn = baseEarn * scaleMultiplier * mutationMultiplier

        if earn < 1 and baseEarn > 0 then
            earn = 1
        end

        return math.floor(earn + 0.5)
    end

