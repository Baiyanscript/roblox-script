-- Auto Sell Egg PRO Edition (Precision Fix - Default 200M)
-- Enhanced UI, draggable frame, floating-point error buffers, and sell safety fixes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

getgenv().SellConfig = getgenv().SellConfig or {
    SellUnder = "200M",
    Enabled = true
}

local AutoSellPro = {}

function AutoSellPro:Init()
    -- 1. 獲取遊戲服務與網絡事件
    self.Shared = ReplicatedStorage:FindFirstChild("Shared")
    self.Data = ReplicatedStorage:FindFirstChild("Data")
    self.Packages = ReplicatedStorage:FindFirstChild("Packages")

    if not (self.Shared and self.Data and self.Packages) then
        return warn("[AutoSell PRO] Failed to load core game folders.")
    end

    self.Save = require(self.Shared:FindFirstChild("Save"))
    self.Assets = require(self.Data:FindFirstChild("Assets"))
    
    self.Networking = self.Packages:FindFirstChild("Networking")
    if not self.Networking then
        return warn("[AutoSell PRO] Failed to find Networking.")
    end

    self.AskWearTool = self.Networking:FindFirstChild("RF/EggWorld/AskWearTool")
    self.SellPet = self.Networking:FindFirstChild("RE/PetSatchel/SellPet")

    if not (self.AskWearTool and self.SellPet) then
        return warn("[AutoSell PRO] Failed to load RemoteEvents / RemoteFunctions.")
    end

    -- KiraHub 模組加載
    pcall(function()
        self.AssetEarnings = require(self.Shared:FindFirstChild("Util"):FindFirstChild("AssetEarnings"))
    end)
    pcall(function()
        self.Mutations = require(self.Shared:FindFirstChild("Modules"):FindFirstChild("Mutations"))
    end)

    --------------------------------------------------
    -- 單位解析工具（支援精確小數點）
    --------------------------------------------------
    local function ParseNumber(value)
        value = tostring(value or ""):gsub(",", ""):gsub("%s+", ""):lower()
        -- 提取包含小數點的完整數字
        local number = tonumber(value:match("^[%+%-]?[%d%.]+"))

        if not number then return 0 end

        if value:find("t") then
            number = number * 1e12
        elseif value:find("b") then
            number = number * 1e9
        elseif value:find("m") then
            number = number * 1e6
        elseif value:find("k") then
            number = number * 1e3
        end

        return number
    end

    --------------------------------------------------
    -- Earnings 計算 (安全防護)
    --------------------------------------------------
    function self:CalculateEarn(egg, cfg)
        if type(egg) ~= "table" then
            return math.huge -- 防護：無法獲取資料時傳回無限大，避免誤賣
        end

        -- 1. 直接讀取 MoneyPerSecond
        local mps = tonumber(egg.MoneyPerSecond)
        if mps and mps > 0 then return mps end

        local itemData = egg.ItemData
        if type(itemData) == "table" then
            local mps2 = tonumber(itemData.MoneyPerSecond)
            if mps2 and mps2 > 0 then return mps2 end

            if type(itemData.Category) == "string" and tonumber(itemData.Scale) and self.AssetEarnings then
                local ok, result = pcall(function()
                    return self.AssetEarnings:MutationOnlyRatePerSecond(itemData)
                end)
                if ok and tonumber(result) and tonumber(result) > 0 then
                    return tonumber(result)
                end
            end
        end

        -- 2. 透過 KiraHub 邏輯計算資產
        local baseEarn = 0
        if type(cfg) == "table" then
            baseEarn = tonumber(cfg.EarningRate) or 0
        end

        local category = egg.AssetCategory or egg.Category
        local mutations = {}

        if type(egg.Mutations) == "table" then
            mutations = egg.Mutations
        elseif type(itemData) == "table" and type(itemData.Mutations) == "table" then
            mutations = itemData.Mutations
        end

        local scale = tonumber(egg.Scale)
        if (not scale or scale <= 0) and type(itemData) == "table" then
            scale = tonumber(itemData.Scale)
        end

        if not scale or scale <= 0 then
            local weight = tonumber(egg.Weight) or tonumber(egg.Kg) or tonumber(egg.ModelWeight)
            local modelWeight = type(cfg) == "table" and tonumber(cfg.ModelWeight) or nil

            if weight and weight > 0 and modelWeight and modelWeight > 0 then
                scale = (weight / modelWeight) ^ (1 / 3)
            else
                scale = 1
            end
        end

        if type(category) == "string" and self.AssetEarnings then
            local ok, result = pcall(function()
                return self.AssetEarnings:MutationOnlyRatePerSecond({
                    Category = category,
                    Mutations = mutations,
                    Scale = scale
                })
            end)
            if ok and tonumber(result) and tonumber(result) > 0 then
                return tonumber(result)
            end
        end

        if baseEarn <= 0 then
            return math.huge
        end

        local scaleMultiplier
        if scale <= 5 then
            scaleMultiplier = scale ^ 1.85
        else
            scaleMultiplier = (scale / 5) ^ 1.2 * 19.637875755794
        end

        local mutationMultiplier = 1
        if self.Mutations then
            pcall(function()
                mutationMultiplier = self.Mutations:EarningsFor(mutations)
            end)
        end

        mutationMultiplier = tonumber(mutationMultiplier) or 1
        local earn = baseEarn * scaleMultiplier * mutationMultiplier

        return earn
    end

    --------------------------------------------------
