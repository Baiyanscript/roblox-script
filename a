-- ==================== MOBILE PURE ARCHITECTURE ====================
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- Master Config Dictionary
_G.Config = {
    BoxESP = false,
    NameESP = false,
    TeamCheck = true,
    
    Aimbot = false,
    FOVCircle = true,
    FOVSize = 130,      -- Mobile optimized base radius
    Sensitivity = 1,    -- Default to pure hard lock
    AimPart = "Head",
    SilentAim = false,
    HitboxSize = 12,
    
    InfiniteJump = false,
    SpeedHack = false,
    WalkSpeed = 100,
    InfAmmo = false,
    FireRateMod = false,
    RecoilMod = false
}

local TouchActive = false
local VisualCache = {}

-- ==================== CENTRALIZED DRAWING RETICLE ====================
local MobileCenterCircle = Drawing.new("Circle")
MobileCenterCircle.Visible = _G.Config.FOVCircle
MobileCenterCircle.Radius = _G.Config.FOVSize
MobileCenterCircle.Color = Color3.fromRGB(0, 255, 150)
MobileCenterCircle.Thickness = 1.5
MobileCenterCircle.NumSides = 64

-- Forces math to run on screen resolution mid-point
local function CalculateScreenCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

-- ==================== EVENT-ONLY VISUAL LIFECYCLE ====================
local function PurgeVisuals(plr)
    if VisualCache[plr] then
        pcall(function() VisualCache[plr].Box:Remove() end)
        pcall(function() VisualCache[plr].Label:Remove() end)
        VisualCache[plr] = nil
    end
end

local function InitialiseVisuals(plr)
    if plr == LocalPlayer then return end
    PurgeVisuals(plr)

    local Square = Drawing.new("Square")
    Square.Visible = false
    Square.Thickness = 1.5
    Square.Filled = false

    local Text = Drawing.new("Text")
    Text.Visible = false
    Text.Size = 13
    Text.Center = true
    Text.Outline = true

    VisualCache[plr] = { Box = Square, Label = Text }
end

local function RigPlayer(plr)
    if plr == LocalPlayer then return end
    InitialiseVisuals(plr)
    
    plr.CharacterAdded:Connect(function()
        task.wait(0.2)
        InitialiseVisuals(plr)
    end)
    
    plr.CharacterRemoving:Connect(function()
        PurgeVisuals(plr)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do RigPlayer(p) end
Players.PlayerAdded:Connect(RigPlayer)
Players.PlayerRemoving:Connect(PurgeVisuals)

-- ==================== MATHEMATICAL POLAR TARGET SELECTION ====================
local function AcquireScreenCenterTarget()
    local focalPoint = CalculateScreenCenter()
    local idealTarget = nil
    local minimumDelta = _G.Config.FOVSize

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            local char = v.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hitPart = char:FindFirstChild(_G.Config.AimPart)
            
            if root and hum and hum.Health > 0 and hitPart then
                -- Structured conditional team check
                if not _G.Config.TeamCheck or (v.Team ~= LocalPlayer.Team) then
                    local screenPos, onViewport = Camera:WorldToViewportPoint(hitPart.Position)
                    
                    if onViewport then
                        -- Metric distance logic relative to static screen center
                        local deltaDistance = (focalPoint - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                        
                        if deltaDistance < minimumDelta then
                            minimumDelta = deltaDistance
                            idealTarget = char
                        end
                    end
                end
            end
        end
    end
    return idealTarget
end

-- ==================== COMPOSITED RENDERING PIPELINE ====================
RunService.RenderStepped:Connect(function()
    -- Lock visual ring element perfectly to device display matrix
    local deviceCenter = CalculateScreenCenter()
    MobileCenterCircle.Position = deviceCenter
    MobileCenterCircle.Radius = _G.Config.FOVSize
    MobileCenterCircle.Visible = _G.Config.FOVCircle

    -- Process Graphics Array Transformation Maps
    for plr, entity in pairs(VisualCache) do
        if not plr or not Players:FindFirstChild(plr.Name) then
            PurgeVisuals(plr)
            continue
        end

        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        local renderingEnabled = hrp and (hum == nil or hum.Health > 0)
        local alliedState = (plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team)
        local passValidation = renderingEnabled and (not _G.Config.TeamCheck or not alliedState)

        if passValidation then
            local projectedPoint, validFrame = Camera:WorldToViewportPoint(hrp.Position)

            if validFrame then
                local topBound = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.35, 0))
                local lowBound = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.05, 0))
                
                local calcHeight = math.abs(lowBound.Y - topBound.Y)
                local calcWidth = calcHeight / 1.65
                local explicitColor = plr.TeamColor.Color

                if _G.Config.BoxESP then
                    entity.Box.Size = Vector2.new(calcWidth, calcHeight)
                    entity.Box.Position = Vector2.new(projectedPoint.X - (calcWidth / 2), topBound.Y)
                    entity.Box.Color = explicitColor
                    entity.Box.Visible = true
                else
                    entity.Box.Visible = false
                end

                if _G.Config.NameESP then
                    local straightRange = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
                    entity.Label.Position = Vector2.new(projectedPoint.X, topBound.Y - 16)
                    entity.Label.Color = explicitColor
                    entity.Label.Text = plr.Name .. " [" .. straightRange .. "m]"
                    entity.Label.Visible = true
                else
                    entity.Label.Visible = false
                end
            else
                entity.Box.Visible = false
                entity.Label.Visible = false
            end
        else
            entity.Box.Visible = false
            entity.Label.Visible = false
        end
    end

    -- Process Vector Locked Camera Interpolation
    if TouchActive and _G.Config.Aimbot then
        local liveTarget = AcquireScreenCenterTarget()
        if liveTarget then
            local targetedMesh = liveTarget:FindFirstChild(_G.Config.AimPart)
            if targetedMesh then
                if _G.Config.Sensitivity >= 1 then
                    -- Absolute 1-step alignment snap
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetedMesh.Position)
                else
                    -- Fractional frame-step interpolation
                    local targetedCFrame = CFrame.new(Camera.CFrame.Position, targetedMesh.Position)
                    Camera.CFrame = Camera.CFrame:Lerp(targetedCFrame, _G.Config.Sensitivity)
                end
            end
        end
    end
end)

-- ==================== CAPTURE PORTS (TOUCH INTERFACE INTEGRATION) ====================
UserInputService.InputBegan:Connect(function(input, interacting)
    if interacting then return end
    -- Listens for standard right-clicks as well as direct multi-touch inputs
    if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then 
        TouchActive = true 
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then 
        TouchActive = false 
    end
end)

UserInputService.JumpRequest:Connect(function()
    if _G.Config.InfiniteJump then
        local humanNode = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanNode then humanNode:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- ==================== MUTATOR THREAD ALLOCATIONS ====================
task.spawn(function()
    while true do
        task.wait(1)
        if _G.Config.SilentAim then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    if _G.Config.TeamCheck and plr.Team == LocalPlayer.Team then continue end
                    local r = plr.Character:FindFirstChild("HumanoidRootPart")
                    local h = plr.Character:FindFirstChild("Head")
                    if r then r.Size = Vector3.new(_G.Config.HitboxSize, _G.Config.HitboxSize, _G.Config.HitboxSize) r.CanCollide = false end
                    if h then h.Size = Vector3.new(_G.Config.HitboxSize, _G.Config.HitboxSize, _G.Config.HitboxSize) h.CanCollide = false end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        local replicatedStorage = game:GetService("ReplicatedStorage")
        local weaponData = replicatedStorage:FindFirstChild("Weapons")
        
        if weaponData then
            for _, valueNode in ipairs(weaponData:GetDescendants()) do
                if valueNode:IsA("ValueBase") then
                    if _G.Config.FireRateMod then
                        if valueNode.Name == "Auto" then valueNode.Value = true
                        elseif valueNode.Name == "FireRate" then valueNode.Value = 0.02 end
                    end
                    if _G.Config.RecoilMod and (valueNode.Name == "RecoilControl" or valueNode.Name == "MaxSpread") then
                        valueNode.Value = 0
                    end
                end
            end
        end
        
        if _G.Config.InfAmmo then
            local ui = LocalPlayer:FindFirstChild("PlayerGui")
            local stateValues = ui and ui:FindFirstChild("GUI") and ui.GUI:FindFirstChild("Client") and ui.GUI.Client:FindFirstChild("Variables")
            if stateValues then
                local a1, a2 = stateValues:FindFirstChild("ammocount"), stateValues:FindFirstChild("ammocount2")
                if a1 then a1.Value = 999 end
                if a2 then a2.Value = 999 end
            end
        end
    end
end)

local velocityLink = nil
local function SyncDeviceVelocity(active)
    if velocityLink then velocityLink:Disconnect() end
    local currentHumanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if currentHumanoid then
        if active then
            currentHumanoid.WalkSpeed = _G.Config.WalkSpeed
            velocityLink = currentHumanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if _G.Config.SpeedHack and currentHumanoid and currentHumanoid.Parent then
                    currentHumanoid.WalkSpeed = _G.Config.WalkSpeed
                end
            end)
        else
            currentHumanoid.WalkSpeed = 16
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.6)
    if _G.Config.SpeedHack then SyncDeviceVelocity(true) end
end)

