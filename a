MovementTab:CreateToggle({ Name = "De-activate Gravitational Bounds", CurrentValue = _G.Config.InfiniteJump, Callback = function(s) _G.Config.InfiniteJump = s end })
MovementTab:CreateToggle({ Name = "Enable Target Velocity", CurrentValue = _G.Config.SpeedHack, Callback = function(s) _G.Config.SpeedHack = s SyncDeviceVelocity(s) end })
