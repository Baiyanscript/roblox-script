local flingEnabled = false
local flingConnection
local selectedSlapType = "GoldSlap"
local availableSlaps = {"GoldSlap", "Slap", "GroupSlap"}

MainTab:CreateDropdown("Pilih Slap Type", availableSlaps, 1, function(value)
    selectedSlapType = value
    print("Slap yang dipilih: "..value)
end)

MainTab:CreateButton("Toggle Auto Fling", function()
    flingEnabled = not flingEnabled

    if flingEnabled and not flingConnection then
        print("Auto fling aktif dengan: "..selectedSlapType)
        flingConnection = coroutine.create(function()
            while flingEnabled do
                task.wait(0.1)
                local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                for _, player in pairs(game.Players:GetPlayers()) do
                    if player ~= Player and workspace:FindFirstChild(player.Name) and Root then
                        local target = workspace:FindFirstChild(player.Name)
                        local flingDirection = Root.CFrame.LookVector * 100
                        local args = {
                            [1] = "slash",
                            [2] = target,
                            [3] = flingDirection
                        }

                        pcall(function()
                            if Player.Character and Player.Character:FindFirstChild(selectedSlapType) then
                                Player.Character[selectedSlapType].Event:FireServer(unpack(args))
                            end
                        end)
                    end
                end
            end
            flingConnection = nil
        end)
        coroutine.resume(flingConnection)
    elseif not flingEnabled then
        print("Auto fling dimatikan.")
        flingConnection = nil
    end
end)


