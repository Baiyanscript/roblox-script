local IsInvisible = false
local InvisiblePlatform = nil

local HiddenPosition = Vector3.new(0, -500, 0)

local function LoadIdleAnimation(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://616006778"
        local track = humanoid:LoadAnimation(anim)
        track.Looped = true
        track:Play()
    end
end

local function HideBodyParts(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.LocalTransparencyModifier = 1
        end
    end
end

local function ShowBodyParts(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.LocalTransparencyModifier = 0
        end
    end
end

local function CreateInvisiblePlatform()
    if InvisiblePlatform and InvisiblePlatform.Parent then return end
    InvisiblePlatform = Instance.new("Part")
    InvisiblePlatform.Name = "SafeInvisiblePart"
    InvisiblePlatform.Size = Vector3.new(20, 2, 20)
    InvisiblePlatform.Position = HiddenPosition
    InvisiblePlatform.Anchored = true
    InvisiblePlatform.Transparency = 1
    InvisiblePlatform.CanCollide = true
    InvisiblePlatform.Parent = workspace
end

local function ToggleInvisibility()
    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end

    if IsInvisible then
        if FakeCharacter and FakeCharacter:FindFirstChild("HumanoidRootPart") then
            RealCharacter.HumanoidRootPart.CFrame = FakeCharacter.HumanoidRootPart.CFrame
        end
        Player.Character = RealCharacter
        workspace.CurrentCamera.CameraSubject = RealCharacter:FindFirstChild("Humanoid")
        if FakeCharacter then FakeCharacter:Destroy() end
        ShowBodyParts(RealCharacter)
        IsInvisible = false
    else
        RealCharacter = Player.Character
        local root = RealCharacter:FindFirstChild("HumanoidRootPart")
        if not root then return end

        RealCharacter.Archivable = true
        FakeCharacter = RealCharacter:Clone()
        FakeCharacter.Parent = workspace
        FakeCharacter:MoveTo(RealCharacter.HumanoidRootPart.Position)

        for _, part in ipairs(FakeCharacter:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0.3
            end
        end

        LoadIdleAnimation(FakeCharacter)
        HideBodyParts(RealCharacter)
        CreateInvisiblePlatform()
        RealCharacter.HumanoidRootPart.CFrame = CFrame.new(HiddenPosition + Vector3.new(0, 5, 0))

        Player.Character = FakeCharacter
        workspace.CurrentCamera.CameraSubject = FakeCharacter:FindFirstChildOfClass("Humanoid")

        IsInvisible = true
    end
end

MainTab:CreateButton("Invisible Mode", function()
