local function GetPlayerByPartial(name)
	if not name or name == "" then return nil end
	name = tostring(name):lower()
	if name == "all" or name == "others" then
		return "All"
	elseif name == "random" then
		local pls = PlayersService:GetPlayers()
		if #pls <= 1 then return nil end
		local pool = {}
		for _,p in ipairs(pls) do if p ~= LocalPlayer then table.insert(pool, p) end end
		return pool[math.random(#pool)]
	end

	for _,p in ipairs(PlayersService:GetPlayers()) do
		if p ~= LocalPlayer then
			local n = (p.Name or ""):lower()
			local d = (p.DisplayName or ""):lower()
			if n:sub(1, #name) == name or d:sub(1, #name) == name then
				return p
			end
		end
	end
	return nil
end

