local function trim(s) return (s:gsub("^%s*(.-)%s*$", "%1")) end
local function splitByComma(s)
	local t = {}
	for part in s:gmatch("([^,]+)") do table.insert(t, trim(part)) end
	return t
end

local function getMatchesForToken(token)
	local matches = {}
	if not token or token == "" then return matches end
	local t = tostring(token):lower()
	for _,p in ipairs(PlayersService:GetPlayers()) do
		if p ~= LocalPlayer then
			local n = (p.Name or ""):lower()
			local d = (p.DisplayName or ""):lower()
			if n:sub(1, #t) == t or d:sub(1, #t) == t then
				table.insert(matches, p)
			end
		end
	end
	return matches
end

local function UpdateSuggestionsLabelForLastToken()
	local text = tostring(Input.Text or "")
	local tokens = splitByComma(text)
	local last = trim(tokens[#tokens] or "")
	if last == "" then
		SuggestionsLabel.Text = ""
		SuggestionsLabel.Visible = false
		return
	end
	local matches = getMatchesForToken(last)
	if #matches == 0 then
		SuggestionsLabel.Text = "No matches"
		SuggestionsLabel.Visible = true
		return
	end
	local names = {}
	for _,v in ipairs(matches) do table.insert(names, v.Name) end
	SuggestionsLabel.Text = table.concat(names, ", ")
	SuggestionsLabel.Visible = true
end

local isAutoApplying = false
local function AutoSelectForLastToken()
	if isAutoApplying then return end

	local text = tostring(Input.Text or "")
	local tokens = splitByComma(text)
	if #tokens == 0 then return end
	local last = trim(tokens[#tokens] or "")
	if last == "" then return end

	local lower = last:lower()
	if lower == "all" or lower == "others" then return end

	if lower == "random" then
		local pls = PlayersService:GetPlayers()
		local pool = {}
		for _,p in ipairs(pls) do if p ~= LocalPlayer then table.insert(pool, p) end end
		if #pool > 0 then
			local r = pool[math.random(#pool)]
			isAutoApplying = true
			tokens[#tokens] = r.Name
			Input.Text = table.concat(tokens, ", ")
			isAutoApplying = false
		end
		return
	end

	local matches = getMatchesForToken(last)
	if #matches == 0 then return end

	local chosen
	if #matches == 1 then chosen = matches[1] else chosen = matches[math.random(#matches)] end

	isAutoApplying = true
	tokens[#tokens] = chosen.Name
	Input.Text = table.concat(tokens, ", ")
	isAutoApplying = false
end

local function ResolvePlayersFromText(text)
	local tokens = splitByComma(text or "")
	local resolved = {}
	local seen = {}
	for _,tk in ipairs(tokens) do
		local t = trim(tk)
		if t ~= "" then
			local lower = t:lower()
			if lower == "all" or lower == "others" then
				if not seen["All"] then table.insert(resolved, "All"); seen["All"] = true end
			elseif lower == "random" then
				local pls = PlayersService:GetPlayers()
				local pool = {}
				for _,p in ipairs(pls) do if p ~= LocalPlayer then table.insert(pool, p) end end
				if #pool > 0 then local r = pool[math.random(#pool)]; if not seen[r] then table.insert(resolved, r); seen[r] = true end end
			else
				local exact = nil
				for _,p in ipairs(PlayersService:GetPlayers()) do
					if p ~= LocalPlayer and (p.Name == t or tostring(p.DisplayName) == t) then exact = p; break end
				end
				if exact then
					if not seen[exact] then table.insert(resolved, exact); seen[exact] = true end
				else
					local matches = getMatchesForToken(t)
					if #matches > 0 and not seen[matches[1]] then table.insert(resolved, matches[1]); seen[matches[1]] = true end
				end
			end
		end
	end
	return resolved
end

local function SkidFling(TargetPlayer)
	if not TargetPlayer or not TargetPlayer.Parent or TargetPlayer == LocalPlayer then return end
	local Character = LocalPlayer.Character
	if not Character then return end
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart
	if not Humanoid or not RootPart then return end

	local TCharacter = TargetPlayer.Character
	if not TCharacter then return end

	local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
	local TRootPart = THumanoid and THumanoid.RootPart
	local THead = TCharacter:FindFirstChild("Head")
	local AccessoryHandle
	for _,obj in ipairs(TCharacter:GetChildren()) do
		if obj:IsA("Accessory") and obj:FindFirstChild("Handle") then
			AccessoryHandle = obj.Handle
			break
		end
	end

	local oldFPDH = workspace.FallenPartsDestroyHeight
	pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)

	local function FPos(BasePart, PosCFrameOffset, Ang)
		if not RootPart or not BasePart then return end
		RootPart.CFrame = CFrame.new(BasePart.Position) * (PosCFrameOffset or CFrame.new()) * (Ang or CFrame.new())
		Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * (PosCFrameOffset or CFrame.new()) * (Ang or CFrame.new()))
		RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
		RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
	end

	local function SFBasePart(BasePart)
		if not BasePart then return end
		local TimeToWait = 2
		local Time = tick()
		local Angle = 0

		repeat
			if not RootPart or not THumanoid then break end
			if BasePart.Parent ~= TargetPlayer.Character then break end
			if BasePart.Velocity.Magnitude < 50 then
				Angle = Angle + 100
				FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle),0 ,0))
				task.wait()
				FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(2.25, 1.5, -2.25) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(-2.25, -1.5, 2.25) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
				task.wait()
			else
				FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, 1.5, TRootPart and TRootPart.Velocity.Magnitude/1.25 or 0), CFrame.Angles(math.rad(90), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, -1.5, -(TRootPart and TRootPart.Velocity.Magnitude/1.25 or 0)), CFrame.Angles(0, 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, 1.5, TRootPart and TRootPart.Velocity.Magnitude/1.25 or 0), CFrame.Angles(math.rad(90), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, -1.5 ,0), CFrame.Angles(math.rad(-90), 0, 0))
				task.wait()
				FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
				task.wait()
			end
		until (BasePart.Velocity.Magnitude > 500)
			or BasePart.Parent ~= TargetPlayer.Character
			or TargetPlayer.Parent ~= PlayersService
			or not (TargetPlayer.Character == TCharacter)
			or (Humanoid and Humanoid.Health <= 0)
			or tick() > Time + TimeToWait
	end

	if RootPart.Velocity.Magnitude < 50 then
		pcall(function() getgenv().OldPos = RootPart.CFrame end)
	end

	if THead then
		workspace.CurrentCamera.CameraSubject = THead
	elseif AccessoryHandle then
		workspace.CurrentCamera.CameraSubject = AccessoryHandle
	elseif THumanoid and TRootPart then
		workspace.CurrentCamera.CameraSubject = THumanoid
	end

	if not TCharacter:FindFirstChildWhichIsA("BasePart") then
		workspace.FallenPartsDestroyHeight = oldFPDH
		return
	end

	local BV = Instance.new("BodyVelocity")
	BV.Name = "EpixVel"
	BV.Parent = RootPart
	BV.Velocity = Vector3.new(9e8,9e8,9e8)
	BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	if TRootPart and THead then
		if (TRootPart.Position - THead.Position).Magnitude > 5 then
			SFBasePart(THead)
		else
			SFBasePart(TRootPart)
		end
	elseif TRootPart then
		SFBasePart(TRootPart)
	elseif THead then
		SFBasePart(THead)
	elseif AccessoryHandle then
		SFBasePart(AccessoryHandle)
	end

	if BV and BV.Parent then pcall(function() BV:Destroy() end) end
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	workspace.CurrentCamera.CameraSubject = Humanoid

	if getgenv().OldPos then
		repeat
			if RootPart and getgenv().OldPos then
				RootPart.CFrame = getgenv().OldPos * CFrame.new(0, .5, 0)
				Character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, .5, 0))
				if Humanoid then Humanoid:ChangeState("GettingUp") end
				for _,x in ipairs(Character:GetChildren()) do
					if x:IsA("BasePart") then
						x.Velocity = Vector3.new()
						x.RotVelocity = Vector3.new()
					end
				end
			end
			task.wait()
		until not (RootPart and getgenv().OldPos) or ((RootPart.Position - getgenv().OldPos.p).Magnitude < 25)
	end

	workspace.FallenPartsDestroyHeight = oldFPDH
end

