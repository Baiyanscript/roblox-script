BtnFlingPlayer.MouseButton1Click:Connect(function()
	local text = Input.Text
	if not text or text == "" then return end
	local targets = ResolvePlayersFromText(text)
	if #targets == 0 then
		Notify("Не найдено", "Игроки не найдены по введённому тексту", 3)
		return
	end
	for _,v in ipairs(targets) do
		if tostring(v) == "All" then
			Notify("All", "Используй кнопку 'Fling All' для флинга всех.", 3)
			return
		end
	end
	for _,p in ipairs(targets) do
		if typeof(p) == "Instance" and p:IsA("Player") and p ~= LocalPlayer then
			task.spawn(function() SkidFling(p) end)
			task.wait(0.2)
		end
	end
end)

